{%- comment -%}
  snippets/ct-bundle-builder.liquid - shopper-driven "build your bundle".
  The shopper picks a variant and Adds it; lines can be incremented, decremented
  and removed; a live total updates; "Add bundle to cart" posts all lines as a
  multi-line cart/add.js items[] payload through Dawn's cart (G-07).

  Variant price/title/image data is embedded as JSON (server-rendered, money via
  cents) so the live total never synthesizes a price. Renders nothing without a
  product. Host section must load assets/product-form.js / Dawn cart.

  Accepts: product (host), section_id, block
{%- endcomment -%}
{%- if product != blank -%}
  {%- liquid
    assign s = block.settings
    assign bb_btn = s.button_label | default: 'Add bundle to cart'
  -%}
  {{ 'component-ct-bundle-builder.css' | asset_url | stylesheet_tag }}
  <ct-bundle-builder
    class="ct-bb"
    data-section-id="{{ section_id }}"
    data-money-format="{{ shop.money_format | escape }}"
    data-product-title="{{ product.title | escape }}"
    {% if block != blank %}{{ block.shopify_attributes }}{% endif %}
  >
    {%- if s.heading != blank -%}
      <div class="ct-bb__heading">{{ s.heading | escape }}</div>
    {%- endif -%}

    <script type="application/json" data-ct-bb-variants>
      [
      {%- for v in product.variants -%}
        {%- assign vimg = v.image | default: product.featured_image -%}
        {"id":{{ v.id }},"title":{{ v.title | json }},"price":{{ v.price }},"compare":{{ v.compare_at_price | default: 0 }},"available":{{ v.available }},"image":{{ vimg | image_url: width: 120 | json }}}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
      ]
    </script>

    <div class="ct-bb__picker">
      <select class="ct-bb__select" data-ct-bb-select aria-label="{{ product.title | escape }}">
        {%- for v in product.variants -%}
          <option value="{{ v.id }}"{% unless v.available %} disabled{% endunless %}>
            {{ v.title }}{% unless v.available %} - {{ 'products.product.sold_out' | t }}{% endunless %}
          </option>
        {%- endfor -%}
      </select>
      <button type="button" class="ct-bb__add-line button button--secondary" data-ct-bb-add-line>
        {{ s.add_label | default: 'Add' | escape }}
      </button>
    </div>

    <ul class="ct-bb__lines" data-ct-bb-lines role="list"></ul>
    <p class="ct-bb__empty" data-ct-bb-empty>{{ s.empty_label | default: 'Add an item above to start your bundle.' | escape }}</p>

    <div class="ct-bb__summary">
      <div class="ct-bb__total-row">
        <span class="ct-bb__total-label">{{ s.total_label | default: 'Bundle total' | escape }}</span>
        <span class="ct-bb__total">
          <s class="ct-bb__total-was" data-ct-bb-compare hidden></s>
          <span class="ct-bb__total-now" data-ct-bb-total>{{ 0 | money }}</span>
        </span>
      </div>
      <button
        type="button"
        class="ct-bb__add button button--primary"
        data-ct-bb-checkout
        disabled
        aria-disabled="true"
      >
        <span data-ct-bb-checkout-text>{{ bb_btn | escape }}</span>
        {% render 'loading-spinner' %}
      </button>
      <p class="ct-bb__error" data-ct-bb-error role="alert" aria-live="assertive" hidden></p>
      {%- if s.discount_note != blank -%}
        <p class="ct-bb__note">{{ s.discount_note | escape }}</p>
      {%- endif -%}
    </div>
  </ct-bundle-builder>
  <script src="{{ 'ct-bundle-builder.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
