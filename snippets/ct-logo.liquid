{%- liquid
  assign logo_width = width | default: settings.logo_width | default: 180
  assign logo_class = class | default: 'ct-logo'
  assign logo_loading = loading | default: 'lazy'
  assign logo_sizes = sizes | default: logo_width | append: 'px'
  assign logo_fallback = fallback | default: 'cozyclaw-logo.svg'
  assign logo_image = image | default: settings.logo
  assign logo_alt = alt | default: logo_image.alt | default: shop.name | escape
  assign fallback_height = logo_width | times: 130 | divided_by: 380 | round
  assign logo_src_width = logo_width | times: 2
-%}

{%- if logo_image != blank -%}
  {%- assign logo_height = logo_width | divided_by: logo_image.aspect_ratio | round -%}
  {% capture logo_widths %}{{ logo_width }}, {{ logo_width | times: 1.5 | round }}, {{ logo_width | times: 2 }}{% endcapture %}
  {{
    logo_image
    | image_url: width: logo_src_width
    | image_tag:
      class: logo_class,
      widths: logo_widths,
      width: logo_width,
      height: logo_height,
      alt: logo_alt,
      sizes: logo_sizes,
      loading: logo_loading,
      preload: preload
  }}
{%- else -%}
  <img
    src="{{ logo_fallback | asset_url }}"
    alt="{{ logo_alt }}"
    class="{{ logo_class }}"
    width="{{ logo_width }}"
    height="{{ fallback_height }}"
    loading="{{ logo_loading }}"
  >
{%- endif -%}
