{%- comment -%}
  Renders the centered section head (kicker + title + optional body).
  Accepts: kicker (string), heading (string), body (string, optional).
{%- endcomment -%}
{%- if heading != blank or kicker != blank -%}
  <div class="ct-section-head" data-reveal>
    {%- if kicker != blank -%}<div class="ct-kicker">{{ kicker }}</div>{%- endif -%}
    {%- if heading != blank -%}<h2 class="ct-section-head__title">{{ heading }}</h2>{%- endif -%}
    {%- if body != blank -%}<p class="ct-section-head__sub">{{ body }}</p>{%- endif -%}
  </div>
{%- endif -%}
