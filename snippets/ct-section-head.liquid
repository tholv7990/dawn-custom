{%- comment -%}
  Renders the centered section head (kicker + title + optional body).
  Uses the .ct-sec-head ct-sec-head--center convention so kicker/heading/body
  styling stays consistent with sections that compose this markup inline
  (ct-features-grid, ct-lifestyle, ct-problem-solution, ct-size-color-guide).
  Accepts: kicker (string), heading (string), body (string, optional).
{%- endcomment -%}
{%- if heading != blank or kicker != blank -%}
  <div class="ct-sec-head ct-sec-head--center" data-reveal>
    {%- if kicker != blank -%}<span class="ct-eyebrow">{{ kicker }}</span>{%- endif -%}
    {%- if heading != blank -%}<h2>{{ heading }}</h2>{%- endif -%}
    {%- if body != blank -%}<p class="ct-lead">{{ body }}</p>{%- endif -%}
  </div>
{%- endif -%}
