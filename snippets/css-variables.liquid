{% comment %}
  snippets/css-variables.liquid - the ONLY file that changes per brand.
  Emits custom --ct-* tokens.
  Poppins + Inter load from Google Fonts in layout/theme.liquid.
  Rendered inside theme.liquid's reset style block, so it outputs raw CSS only
  (no style wrapper). Plain-text comments only - never Liquid tags inside CSS comments.
{% endcomment %}
{%- if settings.ct_force_light_mode -%}
:root,
html {
  color-scheme: only light;
}
html {
  forced-color-adjust: none;
}
body {
  background-color: var(--ct-bg);
  background-image: linear-gradient(var(--ct-bg), var(--ct-bg));
  color: var(--ct-text);
  letter-spacing: normal;
}
input,
button,
select,
textarea,
details,
summary {
  color-scheme: only light;
}
.gs-scope,
.gs-card,
.gs-panel,
.gs-buy-card,
.gs-product-card,
.product__info-container,
.card,
.cart-drawer,
.drawer {
  background-image: linear-gradient(var(--ct-bg-raised), var(--ct-bg-raised));
}
@media (prefers-color-scheme: dark) {
  html,
  body {
    background-color: var(--ct-bg);
    background-image: linear-gradient(var(--ct-bg), var(--ct-bg));
    color: var(--ct-text);
  }
}
{%- endif -%}
body {
  overflow-x: hidden;
}

:root {
  /* CT L1 foundation scales */
  --ct-space-0:0;
  --ct-space-1:4px;
  --ct-space-2:8px;
  --ct-space-3:12px;
  --ct-space-4:20px;
  --ct-space-5:32px;
  --ct-space-6:48px;
  --ct-space-7:80px;
  --ct-space-8:128px; /* viewport-scale insets only (e.g. modal max-height). Do NOT use as a grid gap or card padding -- use --ct-space-5/6. */
  --ct-space-9:40px;
  --ct-space-10:48px;
  --ct-space-11:64px;
  --ct-space-12:80px;
  --ct-pad-tight:clamp(40px, 5vw, 48px);
  --ct-pad-loud:clamp(61px, 7vw, 88px);
  --ct-display-1:clamp(2.4rem, 7vw, 4.2rem);
  --ct-display-2:clamp(1.9rem, 4.6vw, 3rem);
  --ct-shadow-lift:7px 7px 0 var(--ct-text);
  --ct-ring:var(--ct-focus);

  /* CT L2 semantic roles */
  --ct-bg:#ffffff; --ct-bg-surface:#fffaf0; --ct-bg-raised:#ffffff;
  --ct-bg-control:rgba(224,169,46,.12); --ct-bg-control-h:rgba(63,87,67,.16);
  --ct-bg-overlay:rgba(18,24,28,.80);

  --ct-text:#16181d; --ct-text-2:#6b7280; --ct-text-3:#8b929a; --ct-text-off:#c2c8cd;
  --ct-espresso:#16181d; --ct-footer-bg:#fff8e8;
  /* Footer dark skin (section-ct-footer.css): dark surface + white-on-dark scale.
     -dark-rgb/-on-rgb are raw triples for Dawn's rgb(var(--color-*)) plumbing. */
  --ct-footer-dark-rgb:33,43,54; --ct-footer-on-rgb:255,255,255;
  --ct-footer-on:#ffffff;
  --ct-footer-on-66:rgba(255,255,255,.66); --ct-footer-on-70:rgba(255,255,255,.70);
  --ct-footer-on-55:rgba(255,255,255,.55); --ct-footer-on-50:rgba(255,255,255,.50);
  --ct-footer-on-40:rgba(255,255,255,.40); --ct-footer-on-18:rgba(255,255,255,.18);
  --ct-footer-on-10:rgba(255,255,255,.10); --ct-footer-on-04:rgba(255,255,255,.04);

  --ct-border:#e7e9ec; --ct-border-strong:rgba(22,24,29,.20);
  --ct-border-subtle:rgba(22,24,29,.12); --ct-border-faint:rgba(22,24,29,.07);

  --ct-shadow-xs:0 1px 2px rgba(20,30,24,.08);
  --ct-shadow-sm:0 3px 12px rgba(20,30,24,.06);
  --ct-shadow-md:0 8px 20px rgba(20,30,24,.08);
  --ct-shadow-lg:0 16px 36px rgba(20,30,24,.10);
  --ct-shadow-2xl:0 26px 56px rgba(20,30,24,.12);

  --ct-accent: {{ settings.color_accent | default: '#111827' }};
  --ct-accent-strong: {{ settings.color_accent_hover | default: '#374151' }};
  --ct-action:var(--ct-accent);
  --ct-action-hover:var(--ct-accent-strong);
  {%- comment -%} RGB triples for Dawn's --color-* vars, which use rgb()/rgba() (hex would break them) {%- endcomment -%}
  --ct-accent-rgb: {{ settings.color_accent.red }},{{ settings.color_accent.green }},{{ settings.color_accent.blue }};
  --ct-accent-strong-rgb: {{ settings.color_accent_hover.red }},{{ settings.color_accent_hover.green }},{{ settings.color_accent_hover.blue }};
  --ct-accent-text:var(--ct-accent-strong); --ct-accent-subtle:#f3f4f6; --ct-accent-border:#d1d5db;
  --ct-accent-glow:rgba(17,24,39,.14);
  --ct-action-tint:var(--ct-accent-subtle);
  --ct-action-border:var(--ct-accent-border);

  /* Custom design surfaces */
  --ct-announcement-bg:#f1f3f4; --ct-announcement-text:#525a61;
  --ct-media-slot-bg:#f3f5f4; --ct-media-slot-icon:#9bb1a4; --ct-media-slot-stroke:#b3c4ba;
  --ct-media-slot-gradient:linear-gradient(135deg, #eef2f1, #e2eae5);
  --ct-value-bg:#fbfdfb; --ct-value-ink:#17203b; --ct-value-border:#ffe0b8;
  --ct-info-blue:#1da1f2; --ct-interactive-border:#c4ccd2; --ct-interactive-border-hover:#bcd6c4;
  --ct-protection-accent:#149a98; --ct-protection-bg:#e7f6f5;
  --ct-table-alt-bg:#fafbfc; --ct-video-bg:#0d0f12; --ct-muted-chip:#4b5563;

  /* Status commerce signals - deliberately separate from brand */
  --ct-urgency:#e23a2a;
  --ct-urgency-tint:var(--ct-error-light);
  --ct-success:#1e7d34; --ct-success-dark:#176a2b; --ct-success-light:#eef7f0;
  --ct-warning:#f4b400; --ct-warning-dark:#9a6b00; --ct-warning-light:#fbefce;
  --ct-error:#e23a2a; --ct-error-dark:#b12b20; --ct-error-light:#fde4e1;
  --ct-trust:var(--ct-success);
  --ct-trust-tint:var(--ct-success-light);

  /* Commerce */
  --ct-price:#111827; --ct-price-was:#6b7280; --ct-price-save:#e23a2a;
  --ct-price-compare:var(--ct-price-was);
  --ct-savings:var(--ct-price-save);
  --ct-badge-sale:#e23a2a; --ct-badge-new:var(--ct-warning); --ct-badge-best:var(--ct-warning);
  --ct-stock-in:#1e7d34; --ct-stock-low:#f4b400; --ct-stock-out:#9ca3af;
  --ct-rating:#f4b400; --ct-rating-empty:#e7e9ec; --ct-touch:48px;
  --ct-swatch-coffee:#7B5A3E; --ct-swatch-oatmeal:#E4D8C4; --ct-swatch-black:#25211D; --ct-swatch-grey:#B8B3AA;

  /* Radius - soft and cozy */
  --ct-r-sm:6px;
  --ct-r-md: {{ settings.border_radius | default: 12 }}px;
  --ct-r-lg:18px; --ct-r-xl:24px; --ct-r-pill:9999px;

  /* Heading is picker-driven (W1.T05): follows Dawn's --font-heading-family
     from the type_header_font picker, defaulting to Poppins. Body stays a
     brand-locked Inter (Inter is not in Shopify's font library). */
  --ct-font-display: var(--font-heading-family, 'Poppins', system-ui, sans-serif);
  --ct-font-heading: var(--font-heading-family, 'Poppins', system-ui, sans-serif);
  --ct-font-body: 'Inter', system-ui, sans-serif;
  --ct-font-mono: 'Inter', ui-monospace, monospace;
  --font-body-family: 'Inter', system-ui, sans-serif;

  --ct-text-xs:12px; --ct-text-sm:13px; --ct-text-base:15px; --ct-text-md:16px;
  --ct-text-lg:20px; --ct-text-xl:26px; --ct-text-2xl:32px; --ct-text-3xl:40px; --ct-text-4xl:48px;
  --ct-fw-normal:400; --ct-fw-medium:500; --ct-fw-semi:600; --ct-fw-bold:700;
  --ct-leading-tight:1.15; --ct-leading-base:1.6; --ct-leading-loose:1.78;

  --ct-mw: {{ settings.page_width | default: 1120 }}px; --ct-gutter:24px; --ct-gutter-m:16px;
  --ct-on-accent:#fff;
  --ct-product-layout-width:var(--ct-mw);
  --ct-product-layout-gap:var(--ct-space-6);
  --ct-product-layout-media:minmax(0, 1.05fr);
  --ct-product-layout-buy:minmax(0, 0.95fr);
  --ct-product-grid-gap:42px;
  --ct-product-sticky-top:90px;
  --ct-product-button-height:54px;
  --ct-product-pill-button-height:56px;
  --ct-product-button-radius:13px;
  --ct-product-form-gap:11px;
  --ct-product-details-offset:56px;
  --ct-form-field-height:56px;
  --ct-form-field-pad-x:18px;
  --ct-scarcity-border:#ffe2a8;
  --ct-scarcity-track:#fce3ae;
  --ct-gallery-arrow-size:44px;
  --ct-gallery-icon-size:20px;
  --ct-gallery-dot-size:8px;
  --ct-gallery-dot-active-width:24px;
  --ct-gallery-dot-gap:var(--ct-space-2);
  --ct-gallery-heart-size:42px;
  --ct-gallery-control-inset:14px;
  --ct-gallery-badge-inset:16px;
  --ct-gallery-dots-offset:16px;
  --ct-gallery-badge-font:11px;
  --ct-gallery-badge-pad-y:7px;
  --ct-gallery-badge-pad-x:13px;
  --ct-focus:0 0 0 2px var(--ct-bg), 0 0 0 4px var(--ct-accent-text);
  --ct-glass-bg:rgba(255,255,255,.94);
  --ct-glass-strong:rgba(255,255,255,.97);
  --ct-glass-soft:rgba(255,255,255,.90);
  --ct-glass-border:rgba(255,255,255,.28);
  --ct-overlay-bg:rgba(18,24,28,.58);
  --ct-overlay-strong:rgba(18,24,28,.72);
  --ct-shadow-float:0 24px 80px rgba(0,0,0,.32);
  --ct-shadow-bottom:0 -8px 26px rgba(20,30,24,.10);
  --ct-shadow-drawer:18px 0 60px rgba(0,0,0,.22);
  --ct-shadow-pop:0 2px 12px rgba(0,0,0,.22);
  --ct-shadow-badge:0 2px 7px rgba(0,0,0,.16);
  --ct-inset-flag:inset 0 0 0 1px rgba(17,24,39,.14);
  --ct-on-accent-muted:rgba(255,255,255,.68);
  --ct-section-pad-sm:44px;
  --ct-section-pad-lg:68px;
  --ct-section-sub-gap:30px;
  --ct-section-stack-gap:32px;
  --ct-grid-gap:18px;
  --ct-grid-gap-lg:28px;
  --ct-card-pad:14px;
  --ct-card-pad-lg:24px;
  --ct-mobile-section-pad-y:44px;
  --ct-mobile-stack-gap:18px;
  --ct-brand-strip-image-height:30px;
  --ct-brand-strip-gap:46px;
  --ct-gap-sm:8px;
  --ct-gap-md:11px;

  --ct-dur-fast:120ms; --ct-dur-base:240ms; --ct-dur-slow:480ms;
  --ct-ease-out:cubic-bezier(.22,1,.36,1);
  --ct-ease-spring:cubic-bezier(.34,1.56,.64,1);
  --ct-ease-in-out:cubic-bezier(.65,0,.35,1);

  --ct-glass: {{ settings.glass_opacity | default: 0.9 }};
  --ct-glass-surface:rgba(255,255,255,var(--ct-glass));

  /* CT L3 component contracts - geometry aliases Dawn-native panel vars; color/shadow from CT L1/L2.
     Additive: nothing consumes these yet, so emission is a visual no-op until a component opts in. */

  /* Buttons (W1.T06) */
  --ct-btn-radius:var(--buttons-radius, var(--ct-product-button-radius));
  --ct-btn-border-width:var(--buttons-border-width, 1px);
  --ct-btn-border-opacity:var(--buttons-border-opacity, 1);
  --ct-btn-shadow-h:var(--buttons-shadow-horizontal-offset, 0);
  --ct-btn-shadow-v:var(--buttons-shadow-vertical-offset, 0);
  --ct-btn-shadow-blur:var(--buttons-shadow-blur-radius, 0);
  --ct-btn-shadow-opacity:var(--buttons-shadow-opacity, 0);
  --ct-btn-bg:var(--ct-action);
  --ct-btn-bg-hover:var(--ct-action-hover);
  --ct-btn-text:var(--ct-on-accent);
  --ct-btn-min-height:max(44px, var(--ct-product-button-height));

  /* Inputs (W1.T07b) */
  --ct-input-radius:var(--inputs-radius, var(--ct-r-sm));
  --ct-input-border-width:var(--inputs-border-width, 1px);
  --ct-input-border-opacity:var(--inputs-border-opacity, 1);
  --ct-input-border:var(--ct-border);
  --ct-input-bg:var(--ct-bg-raised);
  --ct-input-text:var(--ct-text);
  --ct-input-height:var(--ct-form-field-height);
  --ct-input-pad-x:var(--ct-form-field-pad-x);

  /* Variant pills (W1.T07a) */
  --ct-pill-radius:var(--variant-pills-radius, var(--ct-r-pill));
  --ct-pill-border-width:var(--variant-pills-border-width, 1px);
  --ct-pill-border-opacity:var(--variant-pills-border-opacity, 1);
  --ct-pill-border:var(--ct-border);
  --ct-pill-bg:var(--ct-bg-raised);
  --ct-pill-text:var(--ct-text);
  --ct-pill-selected-bg:var(--ct-action);
  --ct-pill-selected-text:var(--ct-on-accent);
  --ct-pill-min-height:44px;

  /* Dropdowns (W1.T07b) - share input geometry */
  --ct-dropdown-radius:var(--ct-input-radius);
  --ct-dropdown-border:var(--ct-input-border);
  --ct-dropdown-bg:var(--ct-input-bg);
  --ct-dropdown-text:var(--ct-input-text);

  /* Quantity picker (W1.T07c) */
  --ct-qty-radius:var(--ct-input-radius);
  --ct-qty-border:var(--ct-border);
  --ct-qty-bg:var(--ct-bg-raised);
  --ct-qty-text:var(--ct-text);
  --ct-qty-height:var(--ct-input-height);
  --ct-qty-btn-size:44px;

  /* Color swatches (W1.T07d) */
  --ct-swatch-size:34px;
  --ct-swatch-radius:var(--ct-r-pill);
  --ct-swatch-border:var(--ct-border-strong);
  --ct-swatch-ring:var(--ct-action);
  --ct-swatch-gap:var(--ct-space-3);

  /* Slider chrome (W1.T07e) */
  --ct-arrow-size:var(--ct-gallery-arrow-size);
  --ct-arrow-radius:var(--ct-r-pill);
  --ct-arrow-bg:var(--ct-glass-bg);
  --ct-arrow-icon:var(--ct-gallery-icon-size);
  --ct-arrow-color:var(--ct-text);
  --ct-dot-size:var(--ct-gallery-dot-size);
  --ct-dot-active-width:var(--ct-gallery-dot-active-width);
  --ct-dot-gap:var(--ct-gallery-dot-gap);
  --ct-dot-color:var(--ct-border-strong);
  --ct-dot-active-color:var(--ct-action);

  /* Cards (W1.T07) */
  --ct-card-radius:var(--card-corner-radius, var(--ct-r-md));
  --ct-card-border-width:var(--card-border-width, 1px);
  --ct-card-border:var(--ct-border);
  --ct-card-bg:var(--ct-bg-raised);
  --ct-card-pad-token:var(--ct-card-pad-lg);
  --ct-card-shadow:var(--ct-shadow-md);

  /* Drawers (W1.T07) */
  --ct-drawer-bg:var(--ct-bg-raised);
  --ct-drawer-border:var(--ct-border);
  --ct-drawer-shadow:var(--ct-shadow-drawer);
  --ct-drawer-width:420px;

  /* Popups (W1.T07) */
  --ct-popup-radius:var(--popup-corner-radius, var(--ct-r-lg));
  --ct-popup-bg:var(--ct-bg-raised);
  --ct-popup-border:var(--ct-border);
  --ct-popup-shadow:var(--ct-shadow-pop);
  --ct-popup-overlay:var(--ct-overlay-bg);

  /* Badges (W1.T07 / FR-GS-06) */
  --ct-badge-radius:var(--badge-corner-radius, var(--ct-r-sm));
  --ct-badge-pad-x:var(--ct-space-3);
  --ct-badge-pad-y:var(--ct-space-1);
  --ct-badge-shadow:var(--ct-shadow-badge);

  /* Typography scale (W1.T05) - settings-driven multipliers */
  --ct-heading-scale: {{ settings.heading_scale | default: 100 | times: 0.01 }};
  --ct-body-scale: {{ settings.body_scale | default: 100 | times: 0.01 }};
  --ct-h1:calc(var(--ct-text-4xl) * var(--ct-heading-scale));
  --ct-h2:calc(var(--ct-text-3xl) * var(--ct-heading-scale));
  --ct-h3:calc(var(--ct-text-2xl) * var(--ct-heading-scale));
  --ct-h4:calc(var(--ct-text-xl) * var(--ct-heading-scale));
  --ct-h5:calc(var(--ct-text-lg) * var(--ct-heading-scale));
  --ct-h6:calc(var(--ct-text-md) * var(--ct-heading-scale));
  --ct-body-size:calc(var(--ct-text-base) * var(--ct-body-scale));

  /* Reveal / motion (W1.T08) - inputs for the W2.T06 reveal engine */
  --ct-reveal-duration:var(--ct-dur-slow);
  --ct-reveal-delay:0ms;
  --ct-reveal-stagger:80ms;
  --ct-reveal-opacity:0;
  --ct-reveal-x:0;
  --ct-reveal-y:16px;
  --ct-reveal-zoom:1;
  --ct-reveal-ease:var(--ct-ease-out);
}

[class*="color-scheme-"],
[class^="color-"],
[class*=" color-"] {
  --ct-bg: rgb(var(--color-background));
  --ct-bg-surface: rgb(var(--color-background));
  --ct-bg-raised: rgb(var(--color-background));
  --ct-text: rgb(var(--color-foreground));
  --ct-text-2: rgba(var(--color-foreground), 0.75);
  --ct-text-3: rgba(var(--color-foreground), 0.58);
  --ct-text-off: rgba(var(--color-foreground), 0.38);
  --ct-border: rgba(var(--color-foreground), 0.18);
  --ct-border-strong: rgba(var(--color-foreground), 0.28);
  --ct-border-subtle: rgba(var(--color-foreground), 0.12);
  --ct-border-faint: rgba(var(--color-foreground), 0.07);
}

@media (prefers-reduced-motion: reduce) {
  :root { --ct-dur-fast:0ms; --ct-dur-base:0ms; --ct-dur-slow:0ms; }
}
