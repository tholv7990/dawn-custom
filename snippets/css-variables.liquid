{% comment %}
  snippets/css-variables.liquid - the ONLY file that changes per brand.
  Emits GardenStudio --ct-* tokens.
  Poppins + Inter load from Google Fonts in layout/theme.liquid.
  Rendered inside theme.liquid's reset style block, so it outputs raw CSS only
  (no style wrapper). Plain-text comments only - never Liquid tags inside CSS comments.
{% endcomment %}
:root { color-scheme: only light; }
html { color-scheme: only light; forced-color-adjust: none; }
body {
  background: var(--ct-bg) !important;
  color: var(--ct-text) !important;
  letter-spacing: normal !important;
  overflow-x: hidden;
}

:root {
  --ct-bg:#ffffff; --ct-bg-surface:#ffffff; --ct-bg-raised:#ffffff;
  --ct-bg-control:rgba(30,125,52,.08); --ct-bg-control-h:rgba(30,125,52,.16);
  --ct-bg-overlay:rgba(18,24,28,.80);

  --ct-text:#16181d; --ct-text-2:#6b7280; --ct-text-3:#8b929a; --ct-text-off:#c2c8cd;
  --ct-espresso:#16181d; --ct-footer-bg:#f6f8f9;

  --ct-border:#e7e9ec; --ct-border-strong:rgba(22,24,29,.20);
  --ct-border-subtle:rgba(22,24,29,.12); --ct-border-faint:rgba(22,24,29,.07);

  --ct-shadow-xs:0 1px 2px rgba(20,30,24,.08);
  --ct-shadow-sm:0 3px 12px rgba(20,30,24,.06);
  --ct-shadow-md:0 8px 20px rgba(20,30,24,.08);
  --ct-shadow-lg:0 16px 36px rgba(20,30,24,.10);
  --ct-shadow-2xl:0 26px 56px rgba(20,30,24,.12);

  --ct-accent: {{ settings.color_accent | default: '#1e7d34' }};
  --ct-accent-strong: {{ settings.color_accent_hover | default: '#176a2b' }};
  {%- comment -%} RGB triples for Dawn's --color-* vars, which use rgb()/rgba() (hex would break them) {%- endcomment -%}
  --ct-accent-rgb: {{ settings.color_accent.red }},{{ settings.color_accent.green }},{{ settings.color_accent.blue }};
  --ct-accent-strong-rgb: {{ settings.color_accent_hover.red }},{{ settings.color_accent_hover.green }},{{ settings.color_accent_hover.blue }};
  --ct-accent-text:#176a2b; --ct-accent-subtle:#eef7f0; --ct-accent-border:#bfe3cb;
  --ct-accent-glow:rgba(30,125,52,.22);

  /* GardenStudio design surfaces */
  --ct-announcement-bg:#f1f3f4; --ct-announcement-text:#525a61;
  --ct-media-slot-bg:#f3f5f4; --ct-media-slot-icon:#9bb1a4; --ct-media-slot-stroke:#b3c4ba;
  --ct-media-slot-gradient:linear-gradient(135deg, #eef2f1, #e2eae5);
  --ct-value-bg:#fbfdfb; --ct-value-ink:#17203b; --ct-value-border:#ffe0b8;
  --ct-info-blue:#1da1f2; --ct-interactive-border:#c4ccd2; --ct-interactive-border-hover:#bcd6c4;
  --ct-protection-accent:#149a98; --ct-protection-bg:#e7f6f5;
  --ct-table-alt-bg:#fafbfc; --ct-video-bg:#0d0f12; --ct-muted-chip:#4b5563;

  /* Status commerce signals - deliberately separate from brand */
  --ct-urgency:#e23a2a;
  --ct-success:#1e7d34; --ct-success-dark:#176a2b; --ct-success-light:#eef7f0;
  --ct-warning:#f4b400; --ct-warning-dark:#9a6b00; --ct-warning-light:#fbefce;
  --ct-error:#e23a2a; --ct-error-dark:#b12b20; --ct-error-light:#fde4e1;

  /* Commerce */
  --ct-price:#1e7d34; --ct-price-was:#6b7280; --ct-price-save:#e23a2a;
  --ct-badge-sale:#e23a2a; --ct-badge-new:#1e7d34; --ct-badge-best:#1e7d34;
  --ct-stock-in:#1e7d34; --ct-stock-low:#f4b400; --ct-stock-out:#9ca3af;
  --ct-rating:#f4b400; --ct-rating-empty:#e7e9ec; --ct-touch:48px;
  --ct-swatch-coffee:#7B5A3E; --ct-swatch-oatmeal:#E4D8C4; --ct-swatch-black:#25211D; --ct-swatch-grey:#B8B3AA;

  /* Radius - soft and cozy */
  --ct-r-sm:6px;
  --ct-r-md: {{ settings.border_radius | default: 12 }}px;
  --ct-r-lg:18px; --ct-r-xl:24px; --ct-r-pill:9999px;

  --ct-font-display: 'Poppins', system-ui, sans-serif;
  --ct-font-heading: 'Poppins', system-ui, sans-serif;
  --ct-font-body: 'Inter', system-ui, sans-serif;
  --ct-font-mono: 'Inter', ui-monospace, monospace;
  --font-heading-family: 'Poppins', system-ui, sans-serif;
  --font-body-family: 'Inter', system-ui, sans-serif;

  --ct-text-xs:12px; --ct-text-sm:13px; --ct-text-base:15px; --ct-text-md:16px;
  --ct-text-lg:20px; --ct-text-xl:26px; --ct-text-2xl:32px; --ct-text-3xl:40px; --ct-text-4xl:48px;
  --ct-fw-normal:400; --ct-fw-medium:500; --ct-fw-semi:600; --ct-fw-bold:700;
  --ct-leading-tight:1.15; --ct-leading-base:1.6; --ct-leading-loose:1.78;

  --ct-space-1:4px; --ct-space-2:8px; --ct-space-3:12px; --ct-space-4:20px;
  --ct-space-5:32px; --ct-space-6:48px; --ct-space-7:80px; --ct-space-8:128px;

  --ct-mw: {{ settings.page_width | default: 1120 }}px; --ct-gutter:24px; --ct-gutter-m:16px;
  --ct-on-accent:#fff;
  --ct-product-layout-width:var(--ct-mw);
  --ct-product-layout-gap:var(--ct-space-6);
  --ct-product-layout-media:minmax(0, 1.05fr);
  --ct-product-layout-buy:minmax(0, 0.95fr);
  --ct-product-sticky-top:90px;
  --ct-product-button-height:54px;
  --ct-product-pill-button-height:56px;
  --ct-product-button-radius:13px;
  --ct-product-form-gap:11px;
  --ct-product-details-offset:56px;
  --ct-form-field-height:56px;
  --ct-form-field-pad-x:18px;
  --ct-scarcity-border:#ffe2a8;
  --ct-scarcity-track:#fce3ae;
  --ct-gallery-arrow-size:44px;
  --ct-gallery-icon-size:20px;
  --ct-gallery-dot-size:8px;
  --ct-gallery-dot-active-width:24px;
  --ct-gallery-dot-gap:var(--ct-space-2);
  --ct-gallery-heart-size:42px;
  --ct-gallery-control-inset:14px;
  --ct-gallery-badge-inset:16px;
  --ct-gallery-dots-offset:16px;
  --ct-gallery-badge-font:11px;
  --ct-gallery-badge-pad-y:7px;
  --ct-gallery-badge-pad-x:13px;
  --ct-focus:0 0 0 2px var(--ct-bg), 0 0 0 4px var(--ct-accent-text);

  --ct-dur-fast:120ms; --ct-dur-base:240ms; --ct-dur-slow:480ms;
  --ct-ease-out:cubic-bezier(.22,1,.36,1);
  --ct-ease-spring:cubic-bezier(.34,1.56,.64,1);
  --ct-ease-in-out:cubic-bezier(.65,0,.35,1);

  --ct-glass: {{ settings.glass_opacity | default: 0.9 }};
}

@media (prefers-reduced-motion: reduce) {
  :root { --ct-dur-fast:0ms; --ct-dur-base:0ms; --ct-dur-slow:0ms; }
}
