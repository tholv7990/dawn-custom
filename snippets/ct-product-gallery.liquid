{% comment %}
  Reusable CozyClaw product gallery.

  Accepts:
  - product: product object
  - image: optional leading image_picker image
  - fallback_icon: optional icon name when no media exists
  - wrapper_class, carousel_class, track_class, slide_class, image_class, dots_class, dot_class
  - arrow_class, prev_class, next_class
  - badge, badge_class
  - show_heart, heart_class
  - enable_desktop_drag: false disables mouse drag while keeping mobile native swipe
  - render_product_media: true uses product-thumbnail for PDP modal/zoom support
  - media_width, variant_images
{% endcomment %}

{%- liquid
  assign gallery_product = product
  assign gallery_image = image
  assign gallery_wrapper_class = wrapper_class | default: 'ct-product-gallery'
  assign gallery_carousel_class = carousel_class | default: 'ct-product-gallery__carousel'
  assign gallery_track_class = track_class | default: 'ct-product-gallery__track'
  assign gallery_slide_class = slide_class | default: 'ct-product-gallery__slide'
  assign gallery_image_class = image_class | default: 'ct-product-gallery__img'
  assign gallery_dots_class = dots_class | default: 'ct-product-gallery__dots'
  assign gallery_dot_class = dot_class | default: 'ct-product-gallery__dot'
  assign gallery_arrow_class = arrow_class | default: 'ct-product-gallery__arrow'
  assign gallery_prev_class = prev_class
  assign gallery_next_class = next_class
  if gallery_prev_class == blank
    assign gallery_prev_class = gallery_arrow_class | append: '--prev'
  endif
  if gallery_next_class == blank
    assign gallery_next_class = gallery_arrow_class | append: '--next'
  endif
  assign gallery_badge = badge
  assign gallery_badge_class = badge_class | default: 'ct-product-gallery__badge'
  assign gallery_heart_class = heart_class | default: 'ct-product-gallery__heart'
  assign gallery_fallback_icon = fallback_icon | default: 'paw'
  assign gallery_drag_enabled = enable_desktop_drag | default: true
  assign use_product_media = render_product_media | default: false
  assign gallery_media_width = media_width | default: 0.65
  assign featured_media = gallery_product.selected_or_first_available_variant.featured_media
  assign featured_media_id = ''
  if featured_media != blank
    assign featured_media_id = featured_media.id
  endif
-%}

<ct-product-gallery class="{{ gallery_wrapper_class }}" data-gallery data-dot-class="{{ gallery_dot_class }}">
  <div class="{{ gallery_carousel_class }}">
    {%- if gallery_badge != blank -%}
      <span class="{{ gallery_badge_class }}">{{ gallery_badge }}</span>
    {%- endif -%}

    {%- if show_heart -%}
      <button type="button" class="{{ gallery_heart_class }}" aria-label="Save product" data-gallery-heart>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 21s-7.5-4.6-10-9.3C0.6 8.4 2.3 5 5.8 5c2 0 3.4 1.2 4.2 2.4C10.8 6.2 12.2 5 14.2 5c3.5 0 5.2 3.4 3.8 6.7C19.5 16.4 12 21 12 21z" fill="none" stroke="currentColor" stroke-width="2"/>
        </svg>
      </button>
    {%- endif -%}

    <button type="button" class="{{ gallery_arrow_class }} {{ gallery_prev_class }}" aria-label="Previous image" data-gallery-prev>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="{{ gallery_track_class }}" data-gallery-track{% unless gallery_drag_enabled %} data-gallery-drag="false"{% endunless %}>
      {%- if gallery_image != blank -%}
        <div
          class="{{ gallery_slide_class }}"
          data-gallery-slide
          data-gallery-full-image="{{ gallery_image | image_url: width: 1800 }}"
          data-gallery-full-alt="{{ gallery_image.alt | default: gallery_product.title | escape }}"
        >
          {{
            gallery_image
            | image_url: width: 1000
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '480, 720, 1000',
              sizes: '(max-width: 860px) 100vw, 48vw',
              class: gallery_image_class,
              draggable: false,
              alt: gallery_image.alt | default: gallery_product.title | escape
          }}
        </div>
      {%- endif -%}

      {%- if gallery_product != blank and gallery_product.media.size > 0 -%}
        {%- if featured_media != blank and gallery_image == blank -%}
          <div
            class="{{ gallery_slide_class }}"
            data-gallery-slide
            data-media-id="{{ featured_media.id }}"
            data-gallery-full-image="{{ featured_media.preview_image | image_url: width: 1800 }}"
            data-gallery-full-alt="{{ featured_media.preview_image.alt | default: gallery_product.title | escape }}"
          >
            {%- if use_product_media and featured_media.media_type != 'image' -%}
              {% render 'product-thumbnail',
                media: featured_media,
                media_count: gallery_product.media.size,
                position: 1,
                desktop_layout: section.settings.gallery_layout,
                mobile_layout: section.settings.mobile_thumbnails,
                loop: section.settings.enable_video_looping,
                modal_id: section.id,
                xr_button: true,
                media_width: gallery_media_width,
                media_fit: section.settings.media_fit,
                constrain_to_viewport: section.settings.constrain_to_viewport,
                lazy_load: false
              %}
            {%- else -%}
              {{
                featured_media.preview_image
                | image_url: width: 1000
                | image_tag:
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '480, 720, 1000',
                  sizes: '(max-width: 860px) 100vw, 48vw',
                  class: gallery_image_class,
                  draggable: false,
                  alt: featured_media.preview_image.alt | default: gallery_product.title | escape
              }}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- for media in gallery_product.media -%}
          {%- if media.preview_image != blank and media.id != featured_media_id -%}
            <div
              class="{{ gallery_slide_class }}"
              data-gallery-slide
              data-media-id="{{ media.id }}"
              data-gallery-full-image="{{ media.preview_image | image_url: width: 1800 }}"
              data-gallery-full-alt="{{ media.preview_image.alt | default: gallery_product.title | escape }}"
            >
            {%- if use_product_media and media.media_type != 'image' -%}
                {%- liquid
                  assign media_position = forloop.index
                  assign lazy_load = true
                  if forloop.first
                    assign lazy_load = false
                  endif
                -%}
                {% render 'product-thumbnail',
                  media: media,
                  media_count: gallery_product.media.size,
                  position: media_position,
                  desktop_layout: section.settings.gallery_layout,
                  mobile_layout: section.settings.mobile_thumbnails,
                  loop: section.settings.enable_video_looping,
                  modal_id: section.id,
                  xr_button: true,
                  media_width: gallery_media_width,
                  media_fit: section.settings.media_fit,
                  constrain_to_viewport: section.settings.constrain_to_viewport,
                  lazy_load: lazy_load
                %}
              {%- else -%}
                {{
                  media.preview_image
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    widths: '480, 720, 1000',
                    sizes: '(max-width: 860px) 100vw, 48vw',
                    class: gallery_image_class,
                    draggable: false,
                    alt: media.preview_image.alt | default: gallery_product.title | escape
                }}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- elsif gallery_image == blank and gallery_product.featured_image != blank -%}
        <div
          class="{{ gallery_slide_class }}"
          data-gallery-slide
          data-gallery-full-image="{{ gallery_product.featured_image | image_url: width: 1800 }}"
          data-gallery-full-alt="{{ gallery_product.featured_image.alt | default: gallery_product.title | escape }}"
        >
          {{
            gallery_product.featured_image
            | image_url: width: 1000
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '480, 720, 1000',
              sizes: '(max-width: 860px) 100vw, 48vw',
              class: gallery_image_class,
              draggable: false,
              alt: gallery_product.featured_image.alt | default: gallery_product.title | escape
          }}
        </div>
      {%- elsif gallery_image == blank -%}
        <div class="{{ gallery_slide_class }}" data-gallery-slide>
          <span class="ct-gallery-placeholder" aria-hidden="true">{% render 'ct-fa-icon', icon: gallery_fallback_icon %}</span>
        </div>
      {%- endif -%}
    </div>

    <button type="button" class="{{ gallery_arrow_class }} {{ gallery_next_class }}" aria-label="Next image" data-gallery-next>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="{{ gallery_dots_class }}" data-gallery-dots aria-label="Product image navigation"></div>
</ct-product-gallery>
