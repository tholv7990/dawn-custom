{% comment %}
  3-up vertical trust icons rendered inside the PDP buy box.
  Icons are mapped from the label meaning to Font Awesome Free inline SVGs.
  Accepts: block
{% endcomment %}
<div class="ct-trust-icons" {{ block.shopify_attributes }}>
  {%- assign slots = '1,2,3' | split: ',' -%}
  {%- for n in slots -%}
    {%- assign label_key = 'label_' | append: n -%}
    {%- assign label = block.settings[label_key] -%}
    {%- if label != blank -%}
      {%- liquid
        assign label_downcase = label | downcase
        assign fa_icon = 'shield-heart'
        assign icon_tone = 'green'
        if label_downcase contains 'shipping'
          assign fa_icon = 'truck-fast'
          assign icon_tone = 'coffee'
        elsif label_downcase contains 'secure' or label_downcase contains 'payment'
          assign fa_icon = 'lock'
          assign icon_tone = 'green-dark'
        elsif label_downcase contains 'support'
          assign fa_icon = 'headset'
          assign icon_tone = 'coffee'
        endif
      -%}
      <div class="ct-trust-icon">
        <span class="ct-trust-icon__circle ct-trust-icon__circle--{{ icon_tone }}" aria-hidden="true">{%- render 'ct-fa-icon', icon: fa_icon -%}</span>
        <span class="ct-trust-icon__label">{{ label }}</span>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>
