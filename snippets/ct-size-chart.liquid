{%- comment -%}
  Size guide modal — W3.T08. Shared snippet for the `size_chart` block in
  main-product / featured-product. A trigger button opens a Dawn <modal-dialog>
  (focus-trap + ESC + backdrop handled by global.js, loaded globally). Content
  source = rich text (e.g. a table), a Shopify page, or an image.

  Accepts: section_id, block
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign source = s.source | default: 'richtext'
  assign uid = section_id | append: '-' | append: block.id
  assign has_content = false
  if source == 'page' and s.page != blank
    assign has_content = true
  elsif source == 'image' and s.image != blank
    assign has_content = true
  elsif source == 'richtext' and s.content != blank
    assign has_content = true
  endif
-%}
{%- if has_content -%}
  {{ 'component-ct-size-chart.css' | asset_url | stylesheet_tag }}
  <modal-opener class="ct-size-chart" data-modal="#CtSizeChart-{{ uid }}"{% if block != blank %} {{ block.shopify_attributes }}{% endif %}>
    <button
      id="CtSizeChartBtn-{{ uid }}"
      class="ct-size-chart__trigger link"
      type="button"
      aria-haspopup="dialog"
    >
      {%- if s.icon != blank -%}{% render 'ct-icon', name: s.icon, class: 'ct-icon ct-size-chart__icon' %}{%- endif -%}
      {{ s.trigger_label | default: 'Size guide' | escape }}
    </button>
  </modal-opener>

  <modal-dialog id="CtSizeChart-{{ uid }}" class="ct-size-chart-modal">
    <div
      class="ct-size-chart-modal__content"
      role="dialog"
      aria-modal="true"
      aria-label="{{ s.heading | default: 'Size guide' | escape }}"
      tabindex="-1"
    >
      <button
        id="ModalClose-{{ uid }}"
        class="ct-size-chart-modal__close"
        type="button"
        aria-label="{{ s.close_label | default: 'Close' | escape }}"
      >
        {% render 'ct-icon', name: 'close', class: 'ct-icon' %}
      </button>

      {%- if s.heading != blank -%}
        <h2 class="ct-size-chart-modal__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}

      <div class="ct-size-chart-modal__body">
        {%- case source -%}
          {%- when 'page' -%}
            <div class="rte">{{ s.page.content }}</div>
          {%- when 'image' -%}
            {{ s.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 800, 1200', alt: s.heading | default: 'Size guide' | escape }}
          {%- else -%}
            <div class="rte">{{ s.content }}</div>
        {%- endcase -%}
      </div>
    </div>
  </modal-dialog>
{%- endif -%}
