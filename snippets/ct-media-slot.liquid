{%- comment -%}
  Fixed media slot. Keeps uploaded media contained, not cropped.
  Accepts: image, video, class, label, alt, ratio
{%- endcomment -%}
{%- assign slot_class = class | default: 'gs-media-slot' -%}
{%- assign slot_label = label | default: 'Image' -%}
<div class="{{ slot_class }} gs-media-slot"{% if ratio != blank %} style="aspect-ratio: {{ ratio }}"{% endif %}>
  {%- if video != blank -%}
    {{
      video
      | video_tag:
        image_size: '1600x',
        autoplay: true,
        loop: true,
        muted: true,
        playsinline: true,
        preload: 'auto',
        data-gs-autoplay-video: ''
    }}
  {%- elsif image != blank -%}
    {{
      image
      | image_url: width: 1200
      | image_tag:
        loading: 'lazy',
        widths: '360, 540, 720, 960, 1200',
        sizes: '(max-width: 760px) 82vw, 33vw',
        alt: alt | default: image.alt | default: slot_label | escape
    }}
  {%- else -%}
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="6" width="18" height="13" rx="2"></rect>
      <circle cx="9" cy="11" r="2"></circle>
      <path d="M3 17l5-4 4 3 3-3 6 5"></path>
    </svg>
    <span>{{ slot_label }}</span>
  {%- endif -%}
</div>
