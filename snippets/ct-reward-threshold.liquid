{%- comment -%}
  Outputs one reward threshold in active currency subunits.

  Priority:
  1. Separate Market integer metafields:
     localization.market.metafields.custom.free_shipping_threshold
     localization.market.metafields.custom.discount_threshold
     Also supports cozyclaw.free_shipping_threshold / cozyclaw.discount_threshold.
  2. localization.market.metafields.cozyclaw.reward_thresholds JSON
     {
       "free_shipping_threshold": 5000,
       "discount_threshold": 10000
     }
  3. Theme editor currency map, one line per ISO code:
     USD:5000,10000
     VND:125000000,250000000
  4. Theme editor shop-currency defaults, only when active currency matches shop.currency

  Never guessed-convert USD thresholds into another active currency. If the
  active currency is not configured, key: 'configured' outputs false and
  threshold keys output 0.

  Usage:
  {%- capture free_shipping_threshold -%}{% render 'ct-reward-threshold', key: 'free_shipping' %}{%- endcapture -%}
  {%- assign free_shipping_threshold = free_shipping_threshold | strip | plus: 0 -%}
{%- endcomment -%}
{%- liquid
  assign threshold_key = key | default: 'free_shipping'
  assign active_currency = cart.currency.iso_code | default: localization.country.currency.iso_code | default: shop.currency
  assign shop_currency = shop.currency
  assign free_shipping_threshold = 0
  assign discount_threshold = 0
  assign shop_free_shipping_threshold = settings.ct_free_shipping_threshold_cents | default: 0 | plus: 0
  assign shop_discount_threshold = settings.ct_discount_threshold_cents | default: 0 | plus: 0
  assign currency_threshold_lines = settings.ct_reward_thresholds_by_currency | default: '' | newline_to_br | split: '<br />'
  assign market_rewards = localization.market.metafields.cozyclaw.reward_thresholds.value
  assign market_free_shipping_integer = localization.market.metafields.custom.free_shipping_threshold.value | default: localization.market.metafields.cozyclaw.free_shipping_threshold.value
  assign market_discount_integer = localization.market.metafields.custom.discount_threshold.value | default: localization.market.metafields.cozyclaw.discount_threshold.value
  assign threshold_configured = false

  assign market_free_shipping_threshold = market_free_shipping_integer | default: 0 | plus: 0
  assign market_discount_threshold = market_discount_integer | default: 0 | plus: 0
  if market_free_shipping_threshold > 0 and market_discount_threshold > 0
    assign free_shipping_threshold = market_free_shipping_threshold
    assign discount_threshold = market_discount_threshold
    assign threshold_configured = true
  endif

  if threshold_configured == false and market_rewards != blank
    assign market_free_shipping_threshold = 0
    assign market_discount_threshold = 0
    if market_rewards.free_shipping_threshold != blank
      assign market_free_shipping_threshold = market_rewards.free_shipping_threshold | plus: 0
    elsif market_rewards.free_shipping_threshold_cents != blank
      assign market_free_shipping_threshold = market_rewards.free_shipping_threshold_cents | plus: 0
    endif

    if market_rewards.discount_threshold != blank
      assign market_discount_threshold = market_rewards.discount_threshold | plus: 0
    elsif market_rewards.discount_threshold_cents != blank
      assign market_discount_threshold = market_rewards.discount_threshold_cents | plus: 0
    endif

    if market_free_shipping_threshold > 0 and market_discount_threshold > 0
      assign free_shipping_threshold = market_free_shipping_threshold
      assign discount_threshold = market_discount_threshold
      assign threshold_configured = true
    endif
  endif

  if threshold_configured == false
    for threshold_line in currency_threshold_lines
      assign clean_line = threshold_line | strip | replace: ' ', ''
      if clean_line == blank or clean_line contains ':,' or clean_line contains '#'
        continue
      endif

      assign line_parts = clean_line | split: ':'
      assign line_currency = line_parts[0] | upcase
      if line_parts.size == 2 and line_currency == active_currency
        assign threshold_parts = line_parts[1] | split: ','
        assign mapped_free_shipping_threshold = threshold_parts[0] | plus: 0
        assign mapped_discount_threshold = threshold_parts[1] | plus: 0
        if mapped_free_shipping_threshold > 0 and mapped_discount_threshold > 0
          assign free_shipping_threshold = mapped_free_shipping_threshold
          assign discount_threshold = mapped_discount_threshold
          assign threshold_configured = true
        endif
        break
      endif
    endfor
  endif

  if threshold_configured == false and active_currency == shop_currency and shop_free_shipping_threshold > 0 and shop_discount_threshold > 0
    assign free_shipping_threshold = shop_free_shipping_threshold
    assign discount_threshold = shop_discount_threshold
    assign threshold_configured = true
  endif

  if threshold_key == 'configured'
    echo threshold_configured
  elsif threshold_configured == false
    echo 0
  elsif threshold_key == 'discount'
    echo discount_threshold
  else
    echo free_shipping_threshold
  endif
-%}
