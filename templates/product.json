{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "savings_line": {
          "type": "savings_line",
          "settings": {
            "prefix": "You save",
            "show_amount": true,
            "show_percent": true,
            "style": "text"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {}
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "quantity_breaks": {
          "type": "quantity_breaks",
          "settings": {
            "heading": "Save when you buy more",
            "layout": "normal",
            "enable_per_unit": false,
            "button_label": "Add to cart"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {}
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "sticky_atc": {
          "type": "sticky_atc",
          "settings": {
            "show_image": true,
            "show_title": true,
            "show_price": true,
            "show_save_badge": true,
            "button_label": "Add to cart",
            "save_label": "Save"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "savings_line",
        "variant_picker",
        "quantity_selector",
        "quantity_breaks",
        "buy_buttons",
        "description",
        "sticky_atc"
      ],
      "settings": {
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "mobile_thumbnails": "show"
      }
    },
    "trust_strip_1": {
      "type": "ct-trust-bar",
      "settings": {},
      "blocks": {
        "b1": {
          "type": "benefit",
          "settings": {
            "icon": "truck",
            "title": "Fast shipping",
            "text": "Dispatched quickly with tracking"
          }
        },
        "b2": {
          "type": "benefit",
          "settings": {
            "icon": "return",
            "title": "Easy returns",
            "text": "Hassle-free return process"
          }
        },
        "b3": {
          "type": "benefit",
          "settings": {
            "icon": "lock",
            "title": "Secure payments",
            "text": "Encrypted, trusted checkout"
          }
        }
      },
      "block_order": ["b1", "b2", "b3"]
    },
    "marquee": {
      "type": "ct-trust-marquee",
      "settings": {},
      "blocks": {
        "b1": {
          "type": "message",
          "settings": {
            "icon": "&#128666;",
            "text": "Free shipping on qualifying orders"
          }
        },
        "b2": {
          "type": "message",
          "settings": {
            "icon": "&#10003;",
            "text": "Quality you can trust"
          }
        },
        "b3": {
          "type": "message",
          "settings": {
            "icon": "&#8634;",
            "text": "Easy returns"
          }
        },
        "b4": {
          "type": "message",
          "settings": {
            "icon": "&#128737;",
            "text": "Secure checkout"
          }
        }
      },
      "block_order": ["b1", "b2", "b3", "b4"]
    },
    "why": {
      "type": "ct-icon-columns",
      "settings": {
        "heading": "Why you'll love it",
        "subheading": "Thoughtful details that make it easy to live with.",
        "columns": 2
      },
      "blocks": {
        "b1": {
          "type": "column",
          "settings": {
            "icon": "heart",
            "title": "Made for comfort",
            "body": "Soft, premium materials chosen so it feels great to use every day."
          }
        },
        "b2": {
          "type": "column",
          "settings": {
            "icon": "verified",
            "title": "Thoughtful design",
            "body": "Considered details that make it easy to use and a pleasure to own."
          }
        },
        "b3": {
          "type": "column",
          "settings": {
            "icon": "lock",
            "title": "Built to last",
            "body": "Durable construction that holds up to everyday use and keeps its shape."
          }
        },
        "b4": {
          "type": "column",
          "settings": {
            "icon": "recycle",
            "title": "Easy to care for",
            "body": "Simple, low-maintenance care so it keeps looking its best."
          }
        }
      },
      "block_order": ["b1", "b2", "b3", "b4"]
    },
    "details": {
      "type": "ct-tabs",
      "settings": {
        "heading": "Product details",
        "subheading": "Everything you need to know."
      },
      "blocks": {
        "b1": {
          "type": "tab",
          "settings": {
            "title": "Specifications",
            "content": "<ul><li><strong>Dimensions</strong> — Add product dimensions</li><li><strong>Materials</strong> — Add materials</li><li><strong>In the box</strong> — Add what's included</li></ul>"
          }
        },
        "b2": {
          "type": "tab",
          "settings": {
            "title": "Materials & care",
            "content": "<p>Add material details and care instructions here. This content is editable in the theme customizer.</p>"
          }
        }
      },
      "block_order": ["b1", "b2"]
    },
    "shipping": {
      "type": "ct-shipping-estimate",
      "settings": {
        "icon": "truck",
        "heading": "Shipping & delivery",
        "processing_days": 1,
        "transit_min": 3,
        "transit_max": 7,
        "show_dates": true,
        "note": "We ship with tracking. Delivery times vary by destination."
      }
    },
    "trust_strip_2": {
      "type": "ct-trust-bar",
      "settings": {},
      "blocks": {
        "b1": {
          "type": "benefit",
          "settings": {
            "icon": "verified",
            "title": "Thoughtfully made",
            "text": "Designed with care and attention"
          }
        },
        "b2": {
          "type": "benefit",
          "settings": {
            "icon": "chat",
            "title": "Support that cares",
            "text": "We're here before and after you buy"
          }
        },
        "b3": {
          "type": "payment",
          "settings": {
            "note": "Secure checkout"
          }
        }
      },
      "block_order": ["b1", "b2", "b3"]
    },
    "reviews": {
      "type": "ct-reviews",
      "settings": {},
      "blocks": {
        "b1": {
          "type": "review",
          "settings": {
            "name": "[Customer name]",
            "verified": false,
            "rating": 5,
            "title": "[Review title]",
            "body": "[Paste a genuine customer review here]"
          }
        },
        "b2": {
          "type": "review",
          "settings": {
            "name": "[Customer name]",
            "verified": false,
            "rating": 5,
            "title": "[Review title]",
            "body": "[Paste a genuine customer review here]"
          }
        },
        "b3": {
          "type": "review",
          "settings": {
            "name": "[Customer name]",
            "verified": false,
            "rating": 4,
            "title": "[Review title]",
            "body": "[Paste a genuine customer review here]"
          }
        }
      },
      "block_order": ["b1", "b2", "b3"]
    },
    "final_cta": {
      "type": "ct-cta-banner",
      "settings": {
        "eyebrow": "Ready when you are",
        "heading": "Make it yours today",
        "subheading": "Fast shipping, easy returns, and secure checkout — with help whenever you need it.",
        "button_label": "View options",
        "button_url": "#MainContent",
        "button2_label": "",
        "tint": true,
        "padding_top": 60,
        "padding_bottom": 60
      }
    }
  },
  "order": [
    "main",
    "trust_strip_1",
    "marquee",
    "why",
    "details",
    "shipping",
    "trust_strip_2",
    "reviews",
    "final_cta"
  ]
}
