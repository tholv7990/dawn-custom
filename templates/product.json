{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {}
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {}
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "share": {
          "type": "share",
          "settings": {}
        },
        "sticky_atc": {
          "type": "sticky_atc",
          "settings": {
            "show_image": true,
            "show_title": true,
            "show_price": true,
            "show_save_badge": true,
            "button_label": "Add to cart",
            "save_label": "Save"
          }
        },
        "quantity_breaks": {
          "type": "quantity_breaks",
          "settings": {
            "heading": "Choose your quantity",
            "layout": "normal",
            "enable_per_unit": false,
            "button_label": "Add to cart"
          }
        },
        "bundle": {
          "type": "bundle",
          "settings": {
            "heading": "Frequently bought together",
            "addon_1": "womens-minimalist-casual-chic-denim-jacket-vest",
            "addon_1_qty": 1,
            "enable_variant_select": true,
            "show_savings": true,
            "button_label": "Add bundle to cart"
          }
        },
        "product_upsells": {
          "type": "product_upsells",
          "settings": {
            "heading": "You may also like",
            "source": "manual",
            "products": [
              "womens-minimalist-casual-chic-denim-jacket-vest",
              "crew-neck-t-shirt-slim-fit-athletic-training-top"
            ],
            "columns": 4,
            "layout": "grid",
            "show_add": true,
            "show_variant": false,
            "exclude_in_cart": true
          }
        },
        "shipping_estimate": {
          "type": "shipping_estimate",
          "settings": {
            "heading": "Fast, tracked shipping",
            "processing_days": 1,
            "transit_min": 3,
            "transit_max": 7,
            "show_dates": true,
            "show_timeline": true
          }
        },
        "discount_code": {
          "type": "discount_code",
          "settings": {
            "heading": "Save 10%",
            "message": "Use this code at checkout.",
            "code": "SAVE10",
            "show_copy": true,
            "auto_apply": true
          }
        },
        "size_chart": {
          "type": "size_chart",
          "settings": {
            "trigger_label": "Size guide",
            "heading": "Size guide",
            "source": "richtext",
            "content": "<p>Size guide</p><ul><li>S: 36in chest</li><li>M: 40in chest</li></ul>"
          }
        },
        "custom_field": {
          "type": "custom_field",
          "settings": {
            "label": "Gift message",
            "field_type": "textarea",
            "placeholder": "Write your message",
            "required": false
          }
        },
        "gift_offer": {
          "type": "gift_offer",
          "settings": {
            "gift_product": "womens-minimalist-casual-chic-denim-jacket-vest",
            "threshold_cents": "100000",
            "locked_text": "Spend [amount] more for a free gift",
            "unlocked_text": "Free gift added!",
            "show_bar": true,
            "show_gift_preview": true
          }
        },
        "reviews_showcase": {
          "type": "reviews_showcase",
          "settings": {
            "heading": "What customers say",
            "show_score": true,
            "fallback_score": "4.8",
            "fallback_count": "126",
            "quote_1_text": "Exactly as described, great quality.",
            "quote_1_author": "Sam R.",
            "quote_1_rating": 5,
            "quote_1_verified": true
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "quantity_breaks",
        "description",
        "share",
        "sticky_atc",
        "bundle",
        "product_upsells",
        "shipping_estimate",
        "discount_code",
        "size_chart",
        "custom_field",
        "gift_offer",
        "reviews_showcase"
      ],
      "settings": {}
    },
    "related-products": {
      "type": "related-products",
      "settings": {}
    }
  },
  "order": [
    "main",
    "related-products"
  ]
}
