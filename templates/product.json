{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {}
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {}
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "share": {
          "type": "share",
          "settings": {}
        },
        "sticky_atc": {
          "type": "sticky_atc",
          "settings": {
            "show_image": true,
            "show_title": true,
            "show_price": true,
            "show_save_badge": true,
            "button_label": "Add to cart",
            "save_label": "Save"
          }
        },
        "quantity_breaks": {
          "type": "quantity_breaks",
          "settings": {
            "heading": "Choose your quantity",
            "layout": "normal",
            "enable_per_unit": false,
            "button_label": "Add to cart"
          }
        },
        "bundle": {
          "type": "bundle",
          "settings": {
            "heading": "Frequently bought together",
            "addon_1": "womens-minimalist-casual-chic-denim-jacket-vest",
            "addon_1_qty": 1,
            "enable_variant_select": true,
            "show_savings": true,
            "button_label": "Add bundle to cart"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "quantity_breaks",
        "description",
        "share",
        "sticky_atc",
        "bundle"
      ],
      "settings": {}
    },
    "related-products": {
      "type": "related-products",
      "settings": {}
    }
  },
  "order": [
    "main",
    "related-products"
  ]
}
