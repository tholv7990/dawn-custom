<section class="gs-scope gs-brand-strip">
  <div class="gs-marquee-track" style="--gs-marquee-duration: {{ section.settings.speed }}s;">
    {%- for repeat in (1..2) -%}
      <div class="gs-marquee-set"{% if repeat > 1 %} aria-hidden="true"{% endif %}>
      {%- for block in section.blocks -%}
        <span class="gs-brand-strip__item"{% if repeat == 1 %} {{ block.shopify_attributes }}{% endif %}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 320
              | image_tag:
                loading: 'lazy',
                widths: '120, 180, 240, 320',
                sizes: '160px',
                alt: block.settings.text | default: 'Brand logo' | escape
            }}
          {%- elsif block.settings.logo_style != 'text' -%}
            {% render 'gs-press-logo', logo: block.settings.logo_style, label: block.settings.text %}
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </span>
      {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "GS brand strip",
  "settings": [{ "type": "range", "id": "speed", "label": "Speed", "min": 30, "max": 90, "step": 5, "default": 60 }],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "select",
          "id": "logo_style",
          "label": "Built-in logo",
          "options": [
            { "value": "text", "label": "Text fallback" },
            { "value": "gma", "label": "Good Morning America style" },
            { "value": "shape", "label": "Shape style" },
            { "value": "wired", "label": "WIRED style" },
            { "value": "bbc", "label": "BBC style" },
            { "value": "usatoday", "label": "USA Today style" }
          ],
          "default": "text"
        },
        { "type": "image_picker", "id": "image", "label": "Brand image" },
        { "type": "text", "id": "text", "label": "Text fallback / alt text", "default": "Brand logo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GS brand strip",
      "blocks": [
        { "type": "brand", "settings": { "logo_style": "gma", "text": "Good Morning America" } },
        { "type": "brand", "settings": { "logo_style": "shape", "text": "Shape" } },
        { "type": "brand", "settings": { "logo_style": "wired", "text": "WIRED" } },
        { "type": "brand", "settings": { "logo_style": "bbc", "text": "BBC" } },
        { "type": "brand", "settings": { "logo_style": "usatoday", "text": "USA Today" } }
      ]
    }
  ]
}
{% endschema %}
