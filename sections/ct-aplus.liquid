{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-aplus.css' | asset_url | stylesheet_tag }}

{% render 'ct-section-padding', section: section %}

{%- assign layout = section.settings.layout | default: 'banners' -%}
{%- assign section_id = section.settings.anchor_id | default: section.id -%}

<div id="{{ section_id }}" class="page-width section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  {% render 'ct-section-head', kicker: section.settings.kicker, heading: section.settings.heading %}

  {%- if layout == 'spec-grid' -%}
    {%- comment -%} Compact 3-up spec grid per landing HTML .spec-grid {%- endcomment -%}
    <div class="ct-spec-grid" data-reveal>
      {%- for block in section.blocks -%}
        <div class="ct-spec-card" {{ block.shopify_attributes }}>
          <div class="ct-spec-card__k">{{ block.settings.title }}</div>
          <div class="ct-spec-card__v">{{ block.settings.body }}</div>
        </div>
      {%- endfor -%}
    </div>

  {%- elsif layout == 'assure-grid' -%}
    {%- comment -%} 2-up assurance cards per landing HTML .assure-grid {%- endcomment -%}
    <div class="ct-assure-grid" data-reveal>
      {%- for block in section.blocks -%}
        <div class="ct-assure-card" {{ block.shopify_attributes }}>
          <h3 class="ct-assure-card__title">
            {%- if block.settings.emoji != blank -%}<span aria-hidden="true">{{ block.settings.emoji }}</span> {% endif -%}
            {{ block.settings.title }}
          </h3>
          <p class="ct-assure-card__body">{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>

  {%- elsif layout == 'materials-care' -%}
    {%- comment -%} 2-panel spec rows per cozyclaw-homepage.html §materials {%- endcomment -%}
    <section class="ct-aplus ct-aplus--materials color-{{ section.settings.color_scheme }}" id="{{ section.settings.anchor_id }}">
      <div class="ct-aplus__mc-inner">
        <div class="ct-aplus__mc-grid">
          {%- for block in section.blocks -%}
            <div class="ct-aplus__mc-panel" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
              {%- if block.settings.specs_rows != blank -%}
                {%- assign rows = block.settings.specs_rows | newline_to_br | split: '<br />' -%}
                {%- for row in rows -%}
                  {%- assign clean = row | strip | strip_newlines -%}
                  {%- if clean != blank and clean contains '|' -%}
                    {%- assign parts = clean | split: '|' -%}
                    <div class="ct-aplus__spec"><span>{{ parts[0] | strip }}</span><b>{{ parts[1] | strip }}</b></div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {%- if block.settings.body != blank -%}<p class="ct-aplus__mc-note">{{ block.settings.body }}</p>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>

  {%- elsif layout == 'brand-story' -%}
    {%- assign story_block = section.blocks | first -%}
    <section class="ct-brand-story color-{{ section.settings.color_scheme }}" id="{{ section.settings.anchor_id }}" data-reveal>
      <div class="ct-brand-story__copy">
        {%- if section.settings.kicker != blank -%}<span class="ct-eyebrow">{{ section.settings.kicker }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if story_block != blank and story_block.settings.body != blank -%}
          {{ story_block.settings.body | newline_to_br }}
        {%- endif -%}
        {%- if story_block != blank and story_block.settings.tag != blank -%}<p class="ct-brand-story__tag">{{ story_block.settings.tag }}</p>{%- endif -%}
      </div>
      <div class="ct-brand-story__media">
        {%- if story_block != blank and story_block.settings.image != blank -%}
          {{
            story_block.settings.image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '480, 720, 900',
              sizes: '(max-width: 760px) 100vw, 42vw',
              class: 'ct-brand-story__img',
              alt: story_block.settings.image.alt | default: section.settings.heading | escape
          }}
        {%- else -%}
          <span aria-hidden="true">{%- render 'ct-fa-icon', icon: 'paw' -%}</span>
        {%- endif -%}
      </div>
    </section>

  {%- elsif layout == 'guarantee-4' -%}
    {%- comment -%} 4-item accent-subtle panel per cozyclaw-homepage.html §guarantee {%- endcomment -%}
    <section class="ct-aplus ct-aplus--guarantee color-{{ section.settings.color_scheme }}" id="{{ section.settings.anchor_id }}">
      <div class="page-width">
        <div class="ct-aplus__guarantee-panel">
          {%- for block in section.blocks -%}
            {%- liquid
              assign fa_icon = 'shield-heart'
              assign icon_tone = 'gold'
              case block.settings.icon_svg
                when 'shield'
                  assign fa_icon = 'clock'
                  assign icon_tone = 'gold'
                when 'truck'
                  assign fa_icon = 'truck-fast'
                  assign icon_tone = 'green'
                when 'box'
                  assign fa_icon = 'check-double'
                  assign icon_tone = 'clay'
                when 'lock'
                  assign fa_icon = 'shield-halved'
                  assign icon_tone = 'coffee'
              endcase
            -%}
            <div class="ct-aplus__guarantee-item" {{ block.shopify_attributes }}>
              <span class="ct-aplus__guarantee-ic ct-aplus__guarantee-ic--{{ icon_tone }}">
                {%- render 'ct-fa-icon', icon: fa_icon -%}
              </span>
              {%- if block.settings.title != blank -%}<b>{{ block.settings.title }}</b>{%- endif -%}
              {%- if block.settings.body != blank -%}<p>{{ block.settings.body }}</p>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>

  {%- else -%}
    {%- comment -%} Default banners layout (horizontal cards w/ image + text) {%- endcomment -%}
    <div class="ct-aplus-list{% if layout == 'story-rows' %} ct-aplus-list--story{% endif %}">
      {%- for block in section.blocks -%}
        {%- assign ct_rev = forloop.index0 | modulo: 2 -%}
        <div class="ct-card ct-aplus-banner{% if ct_rev == 1 %} ct-aplus-banner--reverse{% endif %}" data-reveal {{ block.shopify_attributes }}>
          <div class="ct-aplus-img">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'ct-aplus-img__media', alt: block.settings.title | escape }}
            {%- else -%}
              <span>{{ block.settings.emoji | default: '💧' }}</span>
            {%- endif -%}
          </div>
          <div>
            {%- if block.settings.number != blank -%}<div class="ct-aplus-num">{{ block.settings.number }}</div>{%- endif -%}
            <h3 class="ct-aplus-title">{{ block.settings.title }}</h3>
            <p class="ct-aplus-body">{{ block.settings.body }}</p>
            {%- if block.settings.tag != blank -%}<span class="ct-aplus-tag">{{ block.settings.tag }}</span>{%- endif -%}
            {%- assign specs = block.settings.specs | split: ',' -%}
            {%- if specs.size > 0 and block.settings.specs != blank -%}
              <div class="ct-aplus-specs">
                {%- for spec in specs -%}<span class="ct-aplus-spec">{{ spec | strip }}</span>{%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "CT A+ block",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "options": [
      { "value": "banners",        "label": "Banners (image + text)" },
      { "value": "story-rows",     "label": "Story rows (homepage)" },
      { "value": "spec-grid",      "label": "Spec grid (3 compact)" },
      { "value": "assure-grid",    "label": "Assure grid (2 assurance cards)" },
      { "value": "materials-care", "label": "Materials & care (2 panels of spec rows)" },
      { "value": "brand-story",    "label": "Brand story (dark split)" },
      { "value": "guarantee-4",    "label": "Guarantee panel (4 items, accent-subtle bg)" }
    ], "default": "banners" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id (e.g. \"details\")", "info": "Renders id=\"\" on the section wrapper so nav links like #details scroll here." },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built different — here's why" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (banners layout)" },
        { "type": "text", "id": "emoji", "label": "Emoji (banners + assure-grid)", "default": "💧" },
        { "type": "text", "id": "number", "label": "Number badge (banners layout)", "default": "01" },
        { "type": "text", "id": "title", "label": "Title / spec key", "default": "Feature — short headline" },
        { "type": "textarea", "id": "body", "label": "Body / spec value", "default": "2–3 sentences explaining the benefit." },
        { "type": "text", "id": "tag", "label": "Tag pill (banners layout)" },
        { "type": "text", "id": "specs", "label": "Specs (comma-separated, banners layout)", "default": "Spec 1, Spec 2" },
        { "type": "textarea", "id": "specs_rows", "label": "Spec rows (materials-care only)",
          "info": "One per line, format: 'Label | Value'. Example: 'Cover | Soft coral fleece'" },
        { "type": "select", "id": "icon_svg", "label": "Icon (guarantee-4 only)",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "truck",  "label": "Truck" },
            { "value": "box",    "label": "Box" },
            { "value": "lock",   "label": "Lock" }
          ],
          "default": "shield" }
      ]
    }
  ],
  "max_blocks": 7,
  "presets": [
    {
      "name": "CT A+ banners",
      "blocks": [
        { "type": "banner", "settings": { "emoji": "💧", "number": "01", "title": "Feature 01" } },
        { "type": "banner", "settings": { "emoji": "⚙️", "number": "02", "title": "Feature 02" } }
      ]
    }
  ]
}
{% endschema %}
