{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-ba.css' | asset_url | stylesheet_tag }}

{% render 'ct-section-padding', section: section %}

<div class="page-width section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <div class="ct-section-head" data-reveal>
      {%- if section.settings.kicker != blank -%}<div class="ct-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
      <h2 class="ct-section-head__title">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}
  <div class="ct-ba-container" data-ba data-reveal>
    <div class="ct-ba-before">
      {%- if section.settings.before_image != blank -%}
        {{ section.settings.before_image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'ct-ba-media', alt: section.settings.before_label | escape }}
      {%- else -%}
        <span class="ct-ba-ph">{{ section.settings.before_label }}</span>
      {%- endif -%}
    </div>
    <div class="ct-ba-after">
      {%- if section.settings.after_image != blank -%}
        {{ section.settings.after_image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'ct-ba-media', alt: section.settings.after_label | escape }}
      {%- else -%}
        <span class="ct-ba-ph ct-ba-ph--after">{{ section.settings.after_label }}</span>
      {%- endif -%}
    </div>
    <div class="ct-ba-handle" aria-hidden="true"></div>
    <span class="ct-ba-label ct-ba-label--before">{{ section.settings.before_tag }}</span>
    <span class="ct-ba-label ct-ba-label--after">{{ section.settings.after_tag }}</span>
  </div>
</div>

{% schema %}
{
  "name": "CT Before / after",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Real results" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "12 weeks, side by side" },
    { "type": "image_picker", "id": "before_image", "label": "Before image" },
    { "type": "image_picker", "id": "after_image", "label": "After image" },
    { "type": "text", "id": "before_label", "label": "Before placeholder text", "default": "Week 1" },
    { "type": "text", "id": "after_label", "label": "After placeholder text", "default": "Week 12" },
    { "type": "text", "id": "before_tag", "label": "Before tag", "default": "Before" },
    { "type": "text", "id": "after_tag", "label": "After tag", "default": "After" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "presets": [ { "name": "CT Before / after" } ]
}
{% endschema %}
