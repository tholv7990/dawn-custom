<section class="cth-signup" id="signup">
  <div class="cth-signup__inner">
    <span class="cth-eyebrow">Join the litter</span>
    <h2>15% off your first order - any size</h2>
    <p>Join the list and we'll email your 15% code, plus first dibs on new colors. No spam, unsubscribe anytime.</p>
    {%- form 'customer', class: 'cth-signup__form', data-ct-newsletter-form: '' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,cozyclaw-homepage">
      <input type="hidden" name="contact[accepts_marketing]" value="true">
      {%- if form.posted_successfully? -%}<span hidden data-ct-newsletter-success></span>{%- endif -%}
      <input type="email" name="contact[email]" placeholder="you@email.com" autocomplete="email" required>
      <button class="cth-btn cth-btn--coral" type="submit" disabled aria-disabled="true">Send my code</button>
      <span class="cth-signup__err" data-newsletter-err>Please enter a valid email address.</span>
    {%- endform -%}
    <small>We'll email your code &middot; 15% off your first order, any value &middot; one discount per order - offers don't combine</small>
  </div>
</section>

{% schema %}
{
  "name": "CT home signup",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [],
  "presets": [{ "name": "CT home signup" }]
}
{% endschema %}
