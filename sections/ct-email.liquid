{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-email.css' | asset_url | stylesheet_tag }}

{% render 'ct-section-padding', section: section %}

<div class="page-width section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="ct-email-inner" data-reveal>
    {%- if section.settings.kicker != blank -%}<div class="ct-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="ct-email-title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="ct-email-sub">{{ section.settings.subheading }}</p>{%- endif -%}

    {%- form 'customer', class: 'ct-email-formwrap' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <div class="ct-email-success">
          <div class="ct-email-success__icon">✓</div>
          <div class="ct-email-success__title">{{ section.settings.success_title }}</div>
          <div class="ct-email-success__text">{{ section.settings.success_text }}</div>
        </div>
      {%- else -%}
        <div class="ct-email-form">
          <input
            class="ct-email-input"
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder }}"
            aria-label="{{ section.settings.placeholder }}"
            autocorrect="off"
            autocapitalize="off"
            required
          >
          <button type="submit" class="ct-btn ct-btn--primary">{{ section.settings.button_label }}</button>
        </div>
        {%- if form.errors -%}
          <div class="ct-email-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</div>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.disclaimer != blank -%}<div class="ct-email-fine">{{ section.settings.disclaimer }}</div>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CT Email",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Join 10,000+ athletes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get weekly training tips + exclusive offers" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "No spam. Unsubscribe any time. Join athletes who train smarter every week." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe →" },
    { "type": "text", "id": "disclaimer", "label": "Fine print", "default": "By subscribing you agree to our Privacy Policy. Unsubscribe any time." },
    { "type": "header", "content": "Success message" },
    { "type": "text", "id": "success_title", "label": "Success title", "default": "You're in!" },
    { "type": "text", "id": "success_text", "label": "Success text", "default": "Check your inbox for a welcome email." },
    { "type": "header", "content": "Section" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 44 }
  ],
  "presets": [ { "name": "CT Email" } ]
}
{% endschema %}
