{% render 'ct-section-padding', section: section %}

<section class="gs-scope ct-quote section-{{ section.id }}-padding">
  <div class="gs-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="gs-section-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="gs-section-sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    <figure class="ct-quote__figure">
      {%- if section.settings.show_stars -%}
        <div class="ct-quote__stars">
          {% render 'ct-rating-stars', rating: 5 %}
        </div>
      {%- endif -%}
      <blockquote class="ct-quote__quote" cite="{{ section.settings.author | escape }}">
        {{ section.settings.quote | escape }}
      </blockquote>
      <figcaption class="ct-quote__cite">
        <span class="ct-quote__author">{{ section.settings.author | escape }}</span>
        {%- if section.settings.author_role != blank -%}
          <span class="ct-quote__role">{{ section.settings.author_role | escape }}</span>
        {%- endif -%}
      </figcaption>
    </figure>
  </div>
</section>

{% style %}
  .ct-quote .ct-quote__figure {
    margin: 0;
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }

  .ct-quote .ct-quote__stars {
    display: flex;
    justify-content: center;
    margin-bottom: var(--ct-space-5);
  }

  .ct-quote .ct-quote__quote {
    margin: 0;
    font-family: var(--font-heading-family, serif);
    font-size: var(--ct-h3);
    font-weight: var(--ct-fw-medium);
    line-height: var(--ct-leading-tight);
    color: var(--ct-text);
  }

  .ct-quote .ct-quote__quote::before {
    content: "\201C";
  }

  .ct-quote .ct-quote__quote::after {
    content: "\201D";
  }

  .ct-quote .ct-quote__cite {
    display: flex;
    flex-direction: column;
    gap: var(--ct-space-1);
    margin-top: var(--ct-space-6);
    font-style: normal;
  }

  .ct-quote .ct-quote__author {
    font-size: var(--ct-text-base);
    font-weight: var(--ct-fw-semi);
    color: var(--ct-text);
  }

  .ct-quote .ct-quote__role {
    font-size: var(--ct-text-sm);
    color: var(--ct-text-2);
  }
{% endstyle %}

{% schema %}
{
  "name": "Pull quote",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "A short, neutral placeholder testimonial sentence."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default": "Author name"
    },
    {
      "type": "text",
      "id": "author_role",
      "label": "Author role or company",
      "default": "Role or company"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show stars",
      "default": false
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Pull quote"
    }
  ]
}
{% endschema %}
