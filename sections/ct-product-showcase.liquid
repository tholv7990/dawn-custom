{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-product-showcase.css' | asset_url | stylesheet_tag }}

{% render 'ct-section-padding', section: section %}

{%- assign showcase_product = section.settings.product -%}
{%- assign section_id = section.settings.anchor_id | default: section.id -%}
{%- assign showcase_image = section.settings.image -%}
{%- if showcase_image == blank and showcase_product != blank -%}
  {%- assign showcase_image = showcase_product.featured_image -%}
{%- endif -%}
{%- assign showcase_link = section.settings.button_link -%}
{%- if showcase_link == blank and showcase_product != blank -%}
  {%- assign showcase_link = showcase_product.url -%}
{%- endif -%}
{%- assign showcase_price = section.settings.price_fallback -%}
{%- if showcase_product != blank -%}
  {%- if settings.currency_code_enabled -%}
    {%- assign showcase_price = showcase_product.price_min | money_with_currency -%}
  {%- else -%}
    {%- assign showcase_price = showcase_product.price_min | money -%}
  {%- endif -%}
{%- endif -%}

<div id="{{ section_id }}" class="page-width section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <section class="ct-product-showcase" data-reveal>
    <div class="ct-product-showcase__gallery">
      <div class="ct-product-showcase__media">
        {%- if showcase_image != blank -%}
          {{
            showcase_image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '480, 720, 1000',
              sizes: '(max-width: 860px) 100vw, 48vw',
              class: 'ct-product-showcase__img',
              alt: showcase_image.alt | default: showcase_product.title | escape
          }}
        {%- else -%}
          <span class="ct-product-showcase__placeholder" aria-hidden="true">{%- render 'ct-fa-icon', icon: 'paw' -%}</span>
        {%- endif -%}
      </div>
      <div class="ct-product-showcase__dots" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </div>
    </div>

    <div class="ct-product-showcase__buy">
      {%- if section.settings.kicker != blank -%}<span class="ct-eyebrow">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.rating_text != blank -%}
        <div class="ct-rating-row ct-product-showcase__rating">
          <span class="ct-stars" aria-hidden="true">★★★★★</span>
          <span class="ct-rating-count">{{ section.settings.rating_text }}</span>
        </div>
      {%- endif -%}
      {%- if showcase_price != blank -%}
        <div class="ct-product-showcase__price">
          <span>{{ section.settings.price_prefix }}</span>
          <b>{{ showcase_price }}</b>
        </div>
      {%- endif -%}
      {%- if section.settings.price_note != blank -%}<p class="ct-product-showcase__note">{{ section.settings.price_note }}</p>{%- endif -%}

      {%- if section.settings.color_label != blank -%}
        <div class="ct-product-showcase__opt">
          <span>{{ section.settings.color_label }}</span>
          <div class="ct-product-showcase__swatches" aria-label="{{ section.settings.color_label | escape }}">
            <i style="--swatch: var(--ct-swatch-coffee)" title="Coffee"></i>
            <i style="--swatch: var(--ct-swatch-grey)" title="Grey"></i>
            <i style="--swatch: var(--ct-swatch-black)" title="Black"></i>
          </div>
        </div>
      {%- endif -%}
      {%- if section.settings.option_note != blank -%}<p class="ct-product-showcase__note">{{ section.settings.option_note }}</p>{%- endif -%}

      <div class="ct-product-showcase__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="ct-btn ct-btn--primary ct-btn--lg ct-btn--full" href="{{ showcase_link | default: '#' }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a class="ct-btn ct-btn--outlined ct-btn--full" href="{{ section.settings.button_link_2 | default: '#' }}">{{ section.settings.button_label_2 }}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.assurance != blank -%}
        <div class="ct-product-showcase__assurance">
          {%- assign assurance_lines = section.settings.assurance | newline_to_br | split: '<br />' -%}
          {%- for line in assurance_lines -%}
            {%- assign clean = line | strip | strip_newlines -%}
            {%- if clean != blank -%}<span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>{{ clean }}</span>{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "CT Product showcase",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "product" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Image override" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The CozyClaw™ Plush Pet Sofa" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One little sofa. A whole lot of calm." },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.9/5 · 13 reviews" },
    { "type": "text", "id": "price_prefix", "label": "Price prefix", "default": "From" },
    { "type": "text", "id": "price_fallback", "label": "Price fallback" },
    { "type": "text", "id": "price_note", "label": "Price note", "default": "Free shipping at $50+." },
    { "type": "text", "id": "color_label", "label": "Color label", "default": "Available in Coffee · Grey · Black" },
    { "type": "text", "id": "option_note", "label": "Option note", "default": "Two roomy sizes: 60 x 80 cm and 80 x 90 cm. Pick your color and size on the product page." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Cozy Sofa" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_label_2", "label": "Second button label", "default": "See the Cleaner Couch Kit" },
    { "type": "url", "id": "button_link_2", "label": "Second button link" },
    { "type": "textarea", "id": "assurance", "label": "Assurance chips", "default": "30-night cozy trial\nFree shipping at $50+\nSecure checkout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [ { "name": "CT Product showcase" } ]
}
{% endschema %}
