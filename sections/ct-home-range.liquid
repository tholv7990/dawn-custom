{%- liquid
  assign main_product = section.settings.main_product
  assign addon_one = section.settings.addon_one
  assign addon_two = section.settings.addon_two
  assign main_url = main_product.url | default: routes.all_products_collection_url
  assign addon_one_url = addon_one.url | default: routes.all_products_collection_url
  assign addon_two_url = addon_two.url | default: routes.all_products_collection_url
  assign main_price = section.settings.main_price_fallback
  assign addon_one_price = section.settings.addon_one_price_fallback
  assign addon_two_price = section.settings.addon_two_price_fallback

  if main_product != blank
    if settings.currency_code_enabled
      assign main_price = main_product.price_min | money_with_currency
    else
      assign main_price = main_product.price_min | money
    endif
  endif
  if addon_one != blank
    if settings.currency_code_enabled
      assign addon_one_price = addon_one.price_min | money_with_currency
    else
      assign addon_one_price = addon_one.price_min | money
    endif
  endif
  if addon_two != blank
    if settings.currency_code_enabled
      assign addon_two_price = addon_two.price_min | money_with_currency
    else
      assign addon_two_price = addon_two.price_min | money
    endif
  endif
-%}

<section class="cth-range" id="shop-range">
  <div class="page-width">
    <div class="cth-head"><span class="cth-eyebrow">Shop the range</span><h2>Cozy on its own. Better together.</h2><p>The sofa they curl up in, plus the everyday extras - grab any of them on their own, or pair them up.</p></div>
    <div class="cth-range__grid">
      {% render 'ct-product-card',
        product: main_product,
        url: main_url,
        title: 'Cozy Plush Pet Sofa',
        description: 'The raised-wall bed they curl into - and pick over your couch.',
        price: main_price,
        badge: 'Bestseller'
      %}
      {% render 'ct-product-card',
        product: addon_one,
        url: addon_one_url,
        title: 'Deshedding Glove',
        description: 'Lifts loose fur off your pet before it ends up on the furniture.',
        price: addon_one_price
      %}
      {% render 'ct-product-card',
        product: addon_two,
        url: addon_two_url,
        title: 'ChompClean Chew Toy',
        description: 'A squeaky chew toy to keep them happily busy.',
        price: addon_two_price
      %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CT home range",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "product", "id": "main_product", "label": "Main product" },
    { "type": "product", "id": "addon_one", "label": "Addon 1" },
    { "type": "product", "id": "addon_two", "label": "Addon 2" },
    { "type": "text", "id": "main_price_fallback", "label": "Main price fallback", "default": "$59.99" },
    { "type": "text", "id": "addon_one_price_fallback", "label": "Addon 1 price fallback", "default": "$14.99" },
    { "type": "text", "id": "addon_two_price_fallback", "label": "Addon 2 price fallback", "default": "$17.99" }
  ],
  "presets": [{ "name": "CT home range" }]
}
{% endschema %}
