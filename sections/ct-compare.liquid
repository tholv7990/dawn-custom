{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-compare.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding{padding-top:{{ section.settings.padding_top | times: 0.75 | round: 0 }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px}
  @media screen and (min-width:750px){.section-{{ section.id }}-padding{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}
{%- endstyle -%}

{%- liquid
  assign cell_keys = 'brand,col2,col3' | split: ','
-%}

<div class="page-width section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <div class="ct-section-head" data-reveal>
      {%- if section.settings.kicker != blank -%}<div class="ct-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
      <h2 class="ct-section-head__title">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}
  <div class="ct-compare-scroll" data-reveal>
    <table class="ct-compare">
      <thead>
        <tr>
          <th style="width:40%">{{ section.settings.feature_label }}</th>
          <th class="ct-compare__brand">{{ section.settings.brand_label }} ★</th>
          <th>{{ section.settings.col2_label }}</th>
          <th>{{ section.settings.col3_label }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          <tr {{ block.shopify_attributes }}>
            <td>{{ block.settings.feature }}</td>
            {%- for key in cell_keys -%}
              {%- assign type_key = key | append: '_type' -%}
              {%- assign text_key = key | append: '_text' -%}
              {%- assign cell_type = block.settings[type_key] -%}
              <td{% if key == 'brand' %} class="ct-compare__brand"{% endif %}>
                {%- case cell_type -%}
                  {%- when 'check' -%}<span class="ct-cmp-check">✓</span>
                  {%- when 'cross' -%}<span class="ct-cmp-cross">✗</span>
                  {%- when 'dash' -%}<span class="ct-cmp-dash">—</span>
                  {%- else -%}{{ block.settings[text_key] }}
                {%- endcase -%}
              </td>
            {%- endfor -%}
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "CT Compare",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why it wins" },
    { "type": "text", "id": "feature_label", "label": "Feature column header", "default": "Feature" },
    { "type": "text", "id": "brand_label", "label": "Brand column header", "default": "Our brand" },
    { "type": "text", "id": "col2_label", "label": "Column 2 header", "default": "Cables" },
    { "type": "text", "id": "col3_label", "label": "Column 3 header", "default": "Free weights" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Progressive resistance" },
        { "type": "select", "id": "brand_type", "label": "Brand cell", "options": [ { "value": "check", "label": "Check" }, { "value": "cross", "label": "Cross" }, { "value": "dash", "label": "Dash" }, { "value": "text", "label": "Custom text" } ], "default": "check" },
        { "type": "text", "id": "brand_text", "label": "Brand cell text (if Custom)" },
        { "type": "select", "id": "col2_type", "label": "Column 2 cell", "options": [ { "value": "check", "label": "Check" }, { "value": "cross", "label": "Cross" }, { "value": "dash", "label": "Dash" }, { "value": "text", "label": "Custom text" } ], "default": "cross" },
        { "type": "text", "id": "col2_text", "label": "Column 2 text (if Custom)" },
        { "type": "select", "id": "col3_type", "label": "Column 3 cell", "options": [ { "value": "check", "label": "Check" }, { "value": "cross", "label": "Cross" }, { "value": "dash", "label": "Dash" }, { "value": "text", "label": "Custom text" } ], "default": "cross" },
        { "type": "text", "id": "col3_text", "label": "Column 3 text (if Custom)" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "CT Compare",
      "blocks": [
        { "type": "row", "settings": { "feature": "Progressive resistance", "brand_type": "check", "col2_type": "check", "col3_type": "cross" } },
        { "type": "row", "settings": { "feature": "No setup required", "brand_type": "check", "col2_type": "cross", "col3_type": "cross" } },
        { "type": "row", "settings": { "feature": "Lifetime warranty", "brand_type": "check", "col2_type": "cross", "col3_type": "cross" } }
      ]
    }
  ]
}
{% endschema %}
