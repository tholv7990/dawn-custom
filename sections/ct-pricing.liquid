{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-pricing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% render 'ct-section-padding', section: section %}

{%- assign ct_product = section.settings.product -%}
{%- assign layout = section.settings.layout | default: 'plans' -%}
{%- assign section_id = section.settings.anchor_id | default: section.id -%}

<div id="{{ section_id }}" class="page-width section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  {% render 'ct-section-head', kicker: section.settings.kicker, heading: section.settings.heading %}
  {%- if section.settings.subheading != blank -%}
    <p class="ct-pricing__sub" data-reveal>{{ section.settings.subheading }}</p>
  {%- endif -%}

  {%- if layout == 'bundle' -%}
    {%- comment -%} Compact bundle cards per cozyclaw-landing.html .bundle-grid.
        Each block can pick its own product (block.settings.block_product); when
        set, name + prices + save chip auto-bind to live Shopify data. Hardcoded
        text settings act as fallbacks when no product is picked. {%- endcomment -%}
    <div class="ct-bundle-grid" data-reveal>
      {%- for block in section.blocks -%}
        {%- assign flag_class = '' -%}
        {%- if block.settings.flag_style == 'urgency' -%}{%- assign flag_class = ' ct-bundle-flag--urgency' -%}{%- endif -%}
        {%- assign bp = block.settings.block_product -%}
        {%- assign bundle_name = block.settings.name -%}
        {%- if bp != blank and bp.title != blank -%}{%- assign bundle_name = bp.title -%}{%- endif -%}
        {%- assign bundle_now = block.settings.price_fallback -%}
        {%- assign bundle_was = block.settings.price_was -%}
        {%- assign bundle_save = block.settings.save_text -%}
        {%- if bp != blank -%}
          {%- assign bundle_now = bp.price | money -%}
          {%- if bp.compare_at_price > bp.price -%}
            {%- assign bundle_was = bp.compare_at_price | money -%}
            {%- assign save_diff = bp.compare_at_price | minus: bp.price -%}
            {%- assign bundle_save = save_diff | money | prepend: 'Save ' -%}
          {%- else -%}
            {%- assign bundle_was = blank -%}
            {%- assign bundle_save = blank -%}
          {%- endif -%}
        {%- endif -%}
        <div class="ct-bundle-card{% if block.settings.featured %} ct-bundle-card--best{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}
            <span class="ct-bundle-flag{{ flag_class }}">{{ block.settings.badge }}</span>
          {%- endif -%}
          {%- if block.settings.emoji != blank -%}
            <div class="ct-bundle-emoji" aria-hidden="true">{{ block.settings.emoji }}</div>
          {%- endif -%}
          <div class="ct-bundle-name">{{ bundle_name }}</div>
          <div class="ct-bundle-prices">
            <span class="ct-bundle-now">{{ bundle_now }}</span>
            {%- if bundle_was != blank -%}<span class="ct-bundle-was">{{ bundle_was }}</span>{%- endif -%}
          </div>
          {%- if bundle_save != blank -%}<div class="ct-bundle-save">{{ bundle_save }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.bottom_button_label != blank -%}
      <div class="ct-bundle-bottom" data-reveal>
        <a class="ct-btn ct-btn--primary ct-btn--lg" href="{{ section.settings.bottom_button_link | default: '#' }}">{{ section.settings.bottom_button_label }}</a>
      </div>
    {%- endif -%}

  {%- else -%}
    {%- comment -%} Original plans layout (variant-driven product picker) {%- endcomment -%}
    <div class="ct-plan-grid">
      {%- for block in section.blocks -%}
        {%- assign vnum = block.settings.variant_position | default: forloop.index -%}
        {%- assign vidx = vnum | minus: 1 -%}
        {%- assign variant = blank -%}
        {%- if ct_product != blank -%}{%- assign variant = ct_product.variants[vidx] -%}{%- endif -%}
        {%- assign style = block.settings.button_style | default: 'primary' -%}
        <div class="ct-card ct-plan{% if block.settings.featured %} ct-plan--featured{% endif %}" data-reveal data-delay="{{ forloop.index0 | times: 80 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.featured and block.settings.badge != blank -%}<div class="ct-plan__badge">{{ block.settings.badge }}</div>{%- endif -%}
          {%- if block.settings.tag != blank -%}<div class="ct-plan__tag">{{ block.settings.tag }}</div>{%- endif -%}
          {%- if block.settings.emoji != blank -%}<div class="ct-plan__emoji" aria-hidden="true">{{ block.settings.emoji }}</div>{%- endif -%}
          <div class="ct-plan__name">{{ block.settings.name }}</div>
          {%- if block.settings.tagline != blank -%}<div class="ct-plan__tagline">{{ block.settings.tagline }}</div>{%- endif -%}
          <div class="ct-plan__price-row">
            <span class="ct-plan__price">
              {%- if variant != blank -%}{{ variant.price | money }}{%- else -%}{{ block.settings.price_fallback }}{%- endif -%}
            </span>
            {%- if block.settings.price_diff != blank -%}<span class="ct-plan__price-diff">{{ block.settings.price_diff }}</span>{%- endif -%}
          </div>
          {%- if block.settings.price_note != blank -%}<div class="ct-plan__price-note">{{ block.settings.price_note }}</div>{%- endif -%}
          {%- if block.settings.save_text != blank -%}<div class="ct-plan__save">{{ block.settings.save_text }}</div>{%- endif -%}

          {%- if block.settings.features != blank -%}
            <ul class="ct-plan__features">
              {%- assign feats = block.settings.features | newline_to_br | split: '<br />' -%}
              {%- for feat in feats -%}
                {%- assign feat_text = feat | strip_newlines | strip -%}
                {%- if feat_text != blank -%}
                  {%- assign marker = feat_text | slice: 0 -%}
                  {%- if marker == '-' or marker == '~' -%}
                    <li class="ct-plan__feature ct-plan__feature--dim">{{ feat_text | remove_first: marker | strip }}</li>
                  {%- else -%}
                    <li class="ct-plan__feature">{{ feat_text }}</li>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if ct_product != blank and variant != blank -%}
            {%- assign form_id = 'ct-plan-' | append: section.id | append: '-' | append: block.id -%}
            {%- assign plan_btn_class = 'ct-btn ct-btn--' | append: style | append: ' ct-btn--full' -%}
            {% render 'ct-add-to-cart', product: ct_product, variant: variant, label: block.settings.button_label, btn_class: plan_btn_class, form_id: form_id, section_id: section.id %}
          {%- else -%}
            <a class="ct-btn ct-btn--{{ style }} ct-btn--full" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label }}</a>
          {%- endif -%}

          {%- if block.settings.note != blank -%}<div class="ct-plan__note">{{ block.settings.note }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_trust and section.settings.trust_chips != blank -%}
      {% render 'ct-trust-chips', chips: section.settings.trust_chips, wrap_style: 'margin-top:24px', reveal: true %}
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "CT Pricing",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "plans", "label": "Plans (full cards)" }, { "value": "bundle", "label": "Bundle (compact)" } ], "default": "plans" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id (e.g. \"bundle\")" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pick your system" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One system. Three ways in." },
    { "type": "textarea", "id": "subheading", "label": "Sub-heading (bundle layout)" },
    { "type": "product", "id": "product", "label": "Product (plans layout)" },
    { "type": "header", "content": "Bundle bottom CTA" },
    { "type": "text", "id": "bottom_button_label", "label": "Bottom CTA label", "default": "Add Bundle to Cart →" },
    { "type": "url", "id": "bottom_button_link", "label": "Bottom CTA link" },
    { "type": "header", "content": "Trust chips (plans)" },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust chips", "default": false },
    { "type": "textarea", "id": "trust_chips", "label": "Trust chips (one per line)" },
    { "type": "header", "content": "Section" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan / bundle card",
      "settings": [
        { "type": "product", "id": "block_product", "label": "Product (for dynamic source binding, bundle layout)", "info": "Pick the product this card represents so name / price fields can be connected to live Shopify data via the chain-link 'Connect dynamic source' icon. Plans layout uses the section-level Product + variant number instead." },
        { "type": "checkbox", "id": "featured", "label": "Featured (accent border)", "default": false },
        { "type": "text", "id": "badge", "label": "Flag / badge (top pill)" },
        { "type": "select", "id": "flag_style", "label": "Flag color (bundle layout)", "options": [ { "value": "accent", "label": "Accent (purple)" }, { "value": "urgency", "label": "Urgency (red)" } ], "default": "accent" },
        { "type": "text", "id": "tag", "label": "Tag (plans layout)" },
        { "type": "text", "id": "emoji", "label": "Emoji" },
        { "type": "text", "id": "name", "label": "Name", "default": "Product Name" },
        { "type": "text", "id": "tagline", "label": "Tagline (italic, plans)" },
        { "type": "number", "id": "variant_position", "label": "Variant number (plans)" },
        { "type": "text", "id": "price_diff", "label": "Price diff (plans)" },
        { "type": "text", "id": "price_note", "label": "Price note (plans)" },
        { "type": "text", "id": "save_text", "label": "Save chip" },
        { "type": "textarea", "id": "features", "label": "Features (plans, one per line)" },
        { "type": "text", "id": "button_label", "label": "Per-card button (plans)" },
        { "type": "select", "id": "button_style", "label": "Button style (plans)", "options": [ { "value": "primary", "label": "Primary" }, { "value": "outlined", "label": "Outlined" }, { "value": "soft", "label": "Soft" } ], "default": "primary" },
        { "type": "url", "id": "button_link", "label": "Button link (plans)" },
        { "type": "text", "id": "price_fallback", "label": "Now price", "default": "$35.97" },
        { "type": "text", "id": "price_was", "label": "Was price (struck, bundle)" },
        { "type": "text", "id": "note", "label": "Note under button (plans)" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "CT Pricing",
      "blocks": [
        { "type": "plan", "settings": { "tag": "Basic", "name": "The Plan", "button_style": "outlined", "price_fallback": "$35.97" } }
      ]
    }
  ]
}
{% endschema %}
