{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-pricing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% render 'ct-section-padding', section: section %}

{%- assign ct_product = section.settings.product -%}
{%- assign layout = section.settings.layout | default: 'plans' -%}
{%- assign section_id = section.settings.anchor_id | default: section.id -%}

{%- if layout == 'automatic-savings' -%}
  <script src="{{ 'ct-pricing.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div id="{{ section_id }}" class="page-width section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  {%- unless layout == 'cleaner-kit' -%}
    {% render 'ct-section-head', kicker: section.settings.kicker, heading: section.settings.heading %}
    {%- if section.settings.subheading != blank -%}
      <p class="ct-pricing__sub" data-reveal>{{ section.settings.subheading }}</p>
    {%- endif -%}
  {%- endunless -%}

  {%- if layout == 'automatic-savings' -%}
    {%- liquid
      capture savings_free_shipping_threshold_raw
        render 'ct-reward-threshold', key: 'free_shipping'
      endcapture
      capture savings_discount_threshold_raw
        render 'ct-reward-threshold', key: 'discount'
      endcapture
      capture savings_reward_thresholds_configured_raw
        render 'ct-reward-threshold', key: 'configured'
      endcapture
      assign savings_free_shipping_threshold = savings_free_shipping_threshold_raw | strip | plus: 0
      assign savings_discount_threshold = savings_discount_threshold_raw | strip | plus: 0
      assign savings_reward_thresholds_configured = savings_reward_thresholds_configured_raw | strip
      assign savings_demo_total = savings_discount_threshold | times: 140 | divided_by: 100
      assign savings_max_total = savings_discount_threshold | times: 150 | divided_by: 100
      assign savings_percent = section.settings.automatic_discount_percent | default: 15
      if settings.currency_code_enabled
        assign savings_free_shipping_money = savings_free_shipping_threshold | money_with_currency
        assign savings_discount_money = savings_discount_threshold | money_with_currency
        assign savings_max_money = savings_max_total | money_with_currency
        assign savings_demo_total_money = savings_demo_total | money_with_currency
      else
        assign savings_free_shipping_money = savings_free_shipping_threshold | money
        assign savings_discount_money = savings_discount_threshold | money
        assign savings_max_money = savings_max_total | money
        assign savings_demo_total_money = savings_demo_total | money
      endif
    -%}
    {%- if savings_reward_thresholds_configured == 'true' -%}
      <ct-savings-calculator
        class="ct-savings"
        data-free-shipping-threshold="{{ savings_free_shipping_threshold }}"
        data-discount-threshold="{{ savings_discount_threshold }}"
        data-discount-percent="{{ savings_percent }}"
        data-max-total="{{ savings_max_total }}"
        data-money-format="{{ shop.money_format | escape }}"
        data-reveal
      >
        <div class="ct-savings__top">
          <div>
            <p class="ct-savings__label">Reward milestones</p>
            <output class="ct-savings__amount" data-savings-amount for="ct-savings-range-{{ section.id }}">
              {{ savings_demo_total_money }}
            </output>
          </div>
          <p class="ct-savings__status" data-savings-status>
            {{ savings_discount_money }} reached - {{ savings_percent }}% off + free shipping
          </p>
        </div>

        <div class="ct-savings__track-wrap">
          <div class="ct-savings__milestone ct-savings__milestone--shipping">
            <span>{{ savings_free_shipping_money }} <small>Free shipping</small></span>
          </div>
          <div class="ct-savings__milestone ct-savings__milestone--discount">
            <span>{{ savings_discount_money }} <small>{{ savings_percent }}% off</small></span>
          </div>
          <div class="ct-savings__track" aria-hidden="true">
            <span class="ct-savings__fill" data-savings-fill></span>
            <span class="ct-savings__mark ct-savings__mark--shipping"></span>
            <span class="ct-savings__mark ct-savings__mark--discount"></span>
          </div>
          <input
            id="ct-savings-range-{{ section.id }}"
            class="ct-savings__range"
            type="range"
            min="0"
            max="{{ savings_max_total }}"
            step="500"
            value="{{ savings_demo_total }}"
            aria-label="Try an order total"
            data-savings-range
          >
          <div class="ct-savings__scale" aria-hidden="true">
            <span>{{ 0 | money }}</span>
            <span>{{ savings_max_money }}+</span>
          </div>
        </div>

        <div class="ct-savings__chips" aria-label="Automatic savings details">
          <span>No code needed</span>
          <span>Applied at checkout</span>
          <span>30-night risk-free trial</span>
        </div>

        {%- if section.settings.bottom_button_label != blank -%}
          <a class="ct-btn ct-btn--primary ct-btn--lg ct-savings__cta" href="{{ section.settings.bottom_button_link | default: '#' }}">
            {{ section.settings.bottom_button_label }}
          </a>
        {%- endif -%}
        <p class="ct-savings__note">Discounts apply to your whole cart - mix any colours & sizes.</p>
      </ct-savings-calculator>
    {%- else -%}
      <div class="ct-savings" data-reveal>
        <div class="ct-savings__top">
          <div>
            <p class="ct-savings__label">Reward milestones</p>
            <p class="ct-savings__amount">Calculated at checkout</p>
          </div>
          <p class="ct-savings__status">Rewards are calculated for your market at checkout.</p>
        </div>
      </div>
    {%- endif -%}

  {%- elsif layout == 'cleaner-kit' -%}
    {%- assign kit_image = section.settings.kit_image -%}
    {%- if kit_image == blank -%}
      {%- assign first_addon = section.blocks | where: 'type', 'addon' | first -%}
      {%- if first_addon != blank and first_addon.settings.product != blank -%}
        {%- assign kit_image = first_addon.settings.product.featured_image -%}
      {%- endif -%}
    {%- endif -%}
    <section class="ct-cleaner-kit color-{{ section.settings.color_scheme }}" data-reveal>
      <div class="ct-cleaner-kit__copy">
        {%- if section.settings.kicker != blank -%}<span class="ct-eyebrow">{{ section.settings.kicker }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
        {%- if section.settings.bottom_button_label != blank -%}
          <a class="ct-btn ct-btn--primary ct-btn--lg" href="{{ section.settings.bottom_button_link | default: '#' }}">{{ section.settings.bottom_button_label }}</a>
        {%- endif -%}
      </div>
      <div class="ct-cleaner-kit__media">
        {%- if kit_image != blank -%}
          {{
            kit_image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '480, 720, 900',
              sizes: '(max-width: 760px) 100vw, 42vw',
              class: 'ct-cleaner-kit__img',
              alt: kit_image.alt | default: section.settings.heading | escape
          }}
        {%- else -%}
          <span aria-hidden="true">{%- render 'ct-fa-icon', icon: 'paw' -%}</span>
        {%- endif -%}
      </div>
    </section>

  {%- elsif layout == 'bundle' -%}
    {%- comment -%} Compact bundle cards per cozyclaw-landing.html .bundle-grid.
        Each block can pick its own product (block.settings.block_product); when
        set, name + prices + save chip auto-bind to live Shopify data. Hardcoded
        text settings act as fallbacks when no product is picked. {%- endcomment -%}
    <div class="ct-bundle-grid" data-reveal>
      {%- for block in section.blocks -%}
        {%- assign flag_class = '' -%}
        {%- if block.settings.flag_style == 'urgency' -%}{%- assign flag_class = ' ct-bundle-flag--urgency' -%}{%- endif -%}
        {%- assign bp = block.settings.block_product -%}
        {%- assign bundle_name = block.settings.name -%}
        {%- if bp != blank and bp.title != blank -%}{%- assign bundle_name = bp.title -%}{%- endif -%}
        {%- assign bundle_now = block.settings.price_fallback -%}
        {%- assign bundle_was = block.settings.price_was -%}
        {%- assign bundle_save = block.settings.save_text -%}
        {%- if bp != blank -%}
          {%- if settings.currency_code_enabled -%}
            {%- assign bundle_now = bp.price | money_with_currency -%}
          {%- else -%}
            {%- assign bundle_now = bp.price | money -%}
          {%- endif -%}
          {%- if bp.compare_at_price > bp.price -%}
            {%- if settings.currency_code_enabled -%}
              {%- assign bundle_was = bp.compare_at_price | money_with_currency -%}
            {%- else -%}
              {%- assign bundle_was = bp.compare_at_price | money -%}
            {%- endif -%}
            {%- assign save_diff = bp.compare_at_price | minus: bp.price -%}
            {%- if settings.currency_code_enabled -%}
              {%- assign bundle_save_money = save_diff | money_with_currency -%}
            {%- else -%}
              {%- assign bundle_save_money = save_diff | money -%}
            {%- endif -%}
            {%- assign bundle_save = bundle_save_money | prepend: 'Save ' -%}
          {%- else -%}
            {%- assign bundle_was = blank -%}
            {%- assign bundle_save = blank -%}
          {%- endif -%}
        {%- endif -%}
        <div class="ct-bundle-card{% if block.settings.featured %} ct-bundle-card--best{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}
            <span class="ct-bundle-flag{{ flag_class }}">{{ block.settings.badge }}</span>
          {%- endif -%}
          {%- if block.settings.emoji != blank -%}
            <div class="ct-bundle-emoji" aria-hidden="true">{{ block.settings.emoji }}</div>
          {%- endif -%}
          <div class="ct-bundle-name">{{ bundle_name }}</div>
          <div class="ct-bundle-prices">
            <span class="ct-bundle-now">{{ bundle_now }}</span>
            {%- if bundle_was != blank -%}<span class="ct-bundle-was">{{ bundle_was }}</span>{%- endif -%}
          </div>
          {%- if bundle_save != blank -%}<div class="ct-bundle-save">{{ bundle_save }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.bottom_button_label != blank -%}
      <div class="ct-bundle-bottom" data-reveal>
        <a class="ct-btn ct-btn--primary ct-btn--lg" href="{{ section.settings.bottom_button_link | default: '#' }}">{{ section.settings.bottom_button_label }}</a>
      </div>
    {%- endif -%}

  {%- elsif layout == 'tier-pair' -%}
    {%- liquid
      assign plan_blocks = section.blocks | where: 'type', 'plan'
      assign addon_blocks = section.blocks | where: 'type', 'addon'
      assign discount_percent = section.settings.automatic_discount_percent | default: 15
      capture free_shipping_threshold_raw
        render 'ct-reward-threshold', key: 'free_shipping'
      endcapture
      capture discount_threshold_raw
        render 'ct-reward-threshold', key: 'discount'
      endcapture
      capture reward_thresholds_configured_raw
        render 'ct-reward-threshold', key: 'configured'
      endcapture
      assign discount_threshold_cents = discount_threshold_raw | strip | plus: 0
      assign free_shipping_threshold_cents = free_shipping_threshold_raw | strip | plus: 0
      assign reward_thresholds_configured = reward_thresholds_configured_raw | strip
      if settings.currency_code_enabled
        assign discount_threshold_money = discount_threshold_cents | money_with_currency
        assign free_shipping_threshold_money = free_shipping_threshold_cents | money_with_currency
      else
        assign discount_threshold_money = discount_threshold_cents | money
        assign free_shipping_threshold_money = free_shipping_threshold_cents | money
      endif
    -%}
    <section class="ct-tier-pair color-{{ section.settings.color_scheme }}" id="{{ section_id }}">
      <div class="ct-tier-pair__inner">
        <div class="ct-tier-pair__grid">
          {%- for block in plan_blocks -%}
              {%- assign tier_p = block.settings.block_product -%}
              {%- assign tier_qty = 1 -%}
              {%- if block.settings.featured -%}{%- assign tier_qty = 2 -%}{%- endif -%}
              {%- assign tier_regular_cents = 0 -%}
              {%- assign tier_discounted_cents = 0 -%}
              {%- assign tier_savings_cents = 0 -%}
              {%- assign tier_regular_money = blank -%}
              {%- assign tier_discounted_money = blank -%}
              {%- assign tier_savings_money = blank -%}
              {%- assign tier_discount_eligible = false -%}
                {%- if tier_p != blank -%}
                  {%- assign tier_regular_cents = tier_p.price_min | times: tier_qty -%}
                {%- if reward_thresholds_configured == 'true' and tier_regular_cents >= discount_threshold_cents -%}
                  {%- assign tier_discount_eligible = true -%}
                  {%- assign discount_multiplier = 100 | minus: discount_percent -%}
                  {%- assign tier_discounted_cents = tier_regular_cents | times: discount_multiplier | divided_by: 100 -%}
                  {%- assign tier_savings_cents = tier_regular_cents | minus: tier_discounted_cents -%}
                {%- else -%}
                  {%- assign tier_discounted_cents = tier_regular_cents -%}
                {%- endif -%}
                {%- if settings.currency_code_enabled -%}
                  {%- assign tier_regular_money = tier_regular_cents | money_with_currency -%}
                  {%- assign tier_discounted_money = tier_discounted_cents | money_with_currency -%}
                  {%- assign tier_savings_money = tier_savings_cents | money_with_currency -%}
                {%- else -%}
                  {%- assign tier_regular_money = tier_regular_cents | money -%}
                  {%- assign tier_discounted_money = tier_discounted_cents | money -%}
                  {%- assign tier_savings_money = tier_savings_cents | money -%}
                {%- endif -%}
              {%- endif -%}
              <div class="ct-tier{% if block.settings.featured %} ct-tier--pop{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.featured and block.settings.badge != blank -%}
                  <span class="ct-tier-badge">{{ block.settings.badge }}</span>
                {%- endif -%}
                <h3 class="ct-tier__name">{{ block.settings.name }}</h3>
                {%- if block.settings.tagline != blank -%}<span class="ct-tier__sub">{{ block.settings.tagline }}</span>{%- endif -%}
                {%- if block.settings.image != blank -%}
                  <div class="ct-tier__media">
                    <img class="ct-tier__img" src="{{ block.settings.image | image_url: width: 600 }}" width="600" height="375" alt="{{ block.settings.image.alt | escape | default: block.settings.name }}" loading="lazy">
                  </div>
                {%- elsif tier_p != blank and tier_p.featured_image != blank -%}
                  <div class="ct-tier__media">
                    <img class="ct-tier__img" src="{{ tier_p.featured_image | image_url: width: 600 }}" width="600" height="375" alt="{{ tier_p.title }}" loading="lazy">
                  </div>
                {%- endif -%}
                {%- if block.settings.features != blank -%}
                  <ul class="ct-tier__feat">
                    {%- assign feat_lines = block.settings.features | newline_to_br | split: '<br />' -%}
                    {%- for line in feat_lines -%}
                      {%- assign clean = line | strip | strip_newlines -%}
                      {%- if clean != blank -%}
                        {%- assign is_hl = false -%}
                        {%- if clean contains '**' -%}{%- assign is_hl = true -%}{%- assign clean = clean | replace: '**', '' -%}{%- endif -%}
                        <li{% if is_hl %} class="ct-tier__feat--hl"{% endif %}>
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>{{ clean }}
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
                <div class="ct-tier__price">
                  <span class="ct-tier__per">
                    {%- if block.settings.featured -%}bundle price{%- else -%}each{%- endif -%}
                  </span>
                  <b>
                    {%- if tier_p != blank and block.settings.featured -%}
                      {{ tier_discounted_money }}
                    {%- elsif tier_p != blank -%}
                      {{ tier_regular_money }}
                    {%- else -%}
                      {{ block.settings.price_fallback }}
                    {%- endif -%}
                  </b>
                  {%- if tier_p != blank and block.settings.featured and tier_discount_eligible -%}
                    <span class="ct-tier__was">{{ tier_regular_money }}</span>
                    <span class="ct-tier__ship">{{ discount_percent }}% off {{ discount_threshold_money }}+ - save {{ tier_savings_money }}</span>
                  {%- elsif block.settings.featured and reward_thresholds_configured == 'true' -%}
                    <span class="ct-tier__ship">{{ discount_percent }}% off at {{ discount_threshold_money }}+</span>
                  {%- elsif reward_thresholds_configured == 'true' -%}
                    <span class="ct-tier__ship">regular price alone - free shipping at {{ free_shipping_threshold_money }}+</span>
                  {%- else -%}
                    <span class="ct-tier__ship">rewards calculated at checkout</span>
                  {%- endif -%}
                </div>
                {%- assign tier_btn_link = block.settings.button_link -%}
                {%- if tier_btn_link == blank and tier_p != blank -%}{%- assign tier_btn_link = tier_p.url -%}{%- endif -%}
                <a href="{{ tier_btn_link | default: '#' }}" class="ct-btn ct-btn--{% if block.settings.featured %}primary{% else %}outlined{% endif %} ct-btn--block">{{ block.settings.button_label | default: 'Choose this' }}</a>
              </div>
          {%- endfor -%}
        </div>
        {%- if addon_blocks.size > 0 -%}
          <div class="ct-bundle__addons">
            {%- if section.settings.addons_label != blank -%}
              <span class="ct-bundle__addons-label">{{ section.settings.addons_label }}</span>
            {%- endif -%}
            <div class="ct-bundle__addons-grid">
              {%- for block in addon_blocks -%}
                  {%- assign ap = block.settings.product -%}
                  {%- assign aimg = block.settings.image -%}
                  {%- if aimg == blank and ap != blank -%}{%- assign aimg = ap.featured_image -%}{%- endif -%}
                  {%- assign av = ap.selected_or_first_available_variant -%}
                  {%- assign addon_has_compare = false -%}
                  {%- if av != blank and av.compare_at_price > av.price -%}{%- assign addon_has_compare = true -%}{%- endif -%}
                  <div class="ct-bundle__addon" {{ block.shopify_attributes }}>
                    {%- if aimg != blank -%}
                      <span class="ct-bundle__addon-img"><img src="{{ aimg | image_url: width: 120 }}" width="120" height="120" alt="{{ aimg.alt | escape | default: block.settings.title | default: ap.title }}" loading="lazy"></span>
                    {%- endif -%}
                    <div>
                      <b>{{ block.settings.title | default: ap.title }}</b>
                      {%- if block.settings.desc != blank -%}<small>{{ block.settings.desc }}</small>{%- endif -%}
                  {%- if av != blank -%}
                    {%- if settings.currency_code_enabled -%}
                      {%- assign av_price_money = av.price | money_with_currency -%}
                      {%- assign av_compare_money = av.compare_at_price | money_with_currency -%}
                    {%- else -%}
                      {%- assign av_price_money = av.price | money -%}
                      {%- assign av_compare_money = av.compare_at_price | money -%}
                    {%- endif -%}
                    <span class="ct-bundle__addon-price">
                      + Add for extra cost:
                      <strong>{{ av_price_money }}</strong>
                      {%- if addon_has_compare -%}
                            <s>{{ av_compare_money }}</s>
                          {%- endif -%}
                        </span>
                      {%- else -%}
                        <span class="ct-bundle__addon-price">+ Add for extra cost</span>
                      {%- endif -%}
                    </div>
                  </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </section>

  {%- else -%}
    {%- comment -%} Original plans layout (variant-driven product picker) {%- endcomment -%}
    <div class="ct-plan-grid">
      {%- for block in section.blocks -%}
        {%- assign vnum = block.settings.variant_position | default: forloop.index -%}
        {%- assign vidx = vnum | minus: 1 -%}
        {%- assign variant = blank -%}
        {%- if ct_product != blank -%}{%- assign variant = ct_product.variants[vidx] -%}{%- endif -%}
        {%- assign style = block.settings.button_style | default: 'primary' -%}
        <div class="ct-card ct-plan{% if block.settings.featured %} ct-plan--featured{% endif %}" data-reveal data-delay="{{ forloop.index0 | times: 80 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.featured and block.settings.badge != blank -%}<div class="ct-plan__badge">{{ block.settings.badge }}</div>{%- endif -%}
          {%- if block.settings.tag != blank -%}<div class="ct-plan__tag">{{ block.settings.tag }}</div>{%- endif -%}
          {%- if block.settings.emoji != blank -%}<div class="ct-plan__emoji" aria-hidden="true">{{ block.settings.emoji }}</div>{%- endif -%}
          <div class="ct-plan__name">{{ block.settings.name }}</div>
          {%- if block.settings.tagline != blank -%}<div class="ct-plan__tagline">{{ block.settings.tagline }}</div>{%- endif -%}
          <div class="ct-plan__price-row">
            <span class="ct-plan__price">
              {%- if variant != blank -%}
                {%- if settings.currency_code_enabled -%}
                  {{ variant.price | money_with_currency }}
                {%- else -%}
                  {{ variant.price | money }}
                {%- endif -%}
              {%- else -%}{{ block.settings.price_fallback }}{%- endif -%}
            </span>
            {%- if block.settings.price_diff != blank -%}<span class="ct-plan__price-diff">{{ block.settings.price_diff }}</span>{%- endif -%}
          </div>
          {%- if block.settings.price_note != blank -%}<div class="ct-plan__price-note">{{ block.settings.price_note }}</div>{%- endif -%}
          {%- if block.settings.save_text != blank -%}<div class="ct-plan__save">{{ block.settings.save_text }}</div>{%- endif -%}

          {%- if block.settings.features != blank -%}
            <ul class="ct-plan__features">
              {%- assign feats = block.settings.features | newline_to_br | split: '<br />' -%}
              {%- for feat in feats -%}
                {%- assign feat_text = feat | strip_newlines | strip -%}
                {%- if feat_text != blank -%}
                  {%- assign marker = feat_text | slice: 0 -%}
                  {%- if marker == '-' or marker == '~' -%}
                    <li class="ct-plan__feature ct-plan__feature--dim">{{ feat_text | remove_first: marker | strip }}</li>
                  {%- else -%}
                    <li class="ct-plan__feature">{{ feat_text }}</li>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if ct_product != blank and variant != blank -%}
            {%- assign form_id = 'ct-plan-' | append: section.id | append: '-' | append: block.id -%}
            {%- assign plan_btn_class = 'ct-btn ct-btn--' | append: style | append: ' ct-btn--full' -%}
            {% render 'ct-add-to-cart', product: ct_product, variant: variant, label: block.settings.button_label, btn_class: plan_btn_class, form_id: form_id, section_id: section.id %}
          {%- else -%}
            <a class="ct-btn ct-btn--{{ style }} ct-btn--full" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label }}</a>
          {%- endif -%}

          {%- if block.settings.note != blank -%}<div class="ct-plan__note">{{ block.settings.note }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_trust and section.settings.trust_chips != blank -%}
      {% render 'ct-trust-chips', chips: section.settings.trust_chips, wrap_style: 'margin-top:24px', reveal: true %}
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "CT Pricing",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
