{% render 'ct-section-padding', section: section %}

<section class="gs-scope ct-cta section-{{ section.id }}-padding{% if section.settings.tint %} ct-cta--tint{% endif %}">
  <div class="gs-wrap">
    <div class="ct-cta__panel">
      {%- if section.settings.eyebrow != blank -%}
        <p class="gs-eyebrow ct-cta__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="gs-section-heading ct-cta__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="gs-section-sub ct-cta__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
        <div class="ct-cta__actions">
          {%- if section.settings.button_label != blank -%}
            {%- if section.settings.button_url != blank -%}
              <a class="ct-cta__btn ct-cta__btn--primary" href="{{ section.settings.button_url }}">{{ section.settings.button_label | escape }}</a>
            {%- else -%}
              <span class="ct-cta__btn ct-cta__btn--primary" role="button" aria-disabled="true">{{ section.settings.button_label | escape }}</span>
            {%- endif -%}
          {%- endif -%}
          {%- if section.settings.button2_label != blank -%}
            {%- if section.settings.button2_url != blank -%}
              <a class="ct-cta__btn ct-cta__btn--secondary" href="{{ section.settings.button2_url }}">{{ section.settings.button2_label | escape }}</a>
            {%- else -%}
              <span class="ct-cta__btn ct-cta__btn--secondary" role="button" aria-disabled="true">{{ section.settings.button2_label | escape }}</span>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .ct-cta .ct-cta__panel {
    text-align: center;
    max-width: 720px;
    margin-right: auto;
    margin-left: auto;
    padding: var(--ct-space-9) var(--ct-space-6);
    border-radius: var(--ct-r-xl);
    background: var(--ct-bg-surface);
    border: 1px solid var(--ct-border);
  }

  .ct-cta--tint .ct-cta__panel {
    background: var(--ct-action-tint);
    border-color: var(--ct-action-border);
  }

  .ct-cta .ct-cta__eyebrow {
    margin: 0 0 var(--ct-space-3);
    font-weight: var(--ct-fw-semi);
    letter-spacing: 0.08em;
    color: var(--ct-action);
  }

  .ct-cta .ct-cta__heading {
    margin: 0;
    color: var(--ct-text);
  }

  .ct-cta .ct-cta__sub {
    margin: var(--ct-space-3) auto 0;
    max-width: 560px;
    font-size: var(--ct-text-md);
    color: var(--ct-text-2);
    line-height: var(--ct-leading-base);
  }

  .ct-cta .ct-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--ct-space-3);
    margin-top: var(--ct-space-6);
  }

  .ct-cta .ct-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--ct-space-3) var(--ct-space-6);
    border-radius: var(--ct-r-pill);
    border: 1px solid transparent;
    font-size: var(--ct-text-base);
    font-weight: var(--ct-fw-semi);
    line-height: var(--ct-leading-tight);
    text-decoration: none;
    cursor: pointer;
    transition: background var(--ct-dur-base) var(--ct-ease-out), color var(--ct-dur-base) var(--ct-ease-out), border-color var(--ct-dur-base) var(--ct-ease-out);
  }

  .ct-cta .ct-cta__btn--primary {
    background: var(--ct-action);
    color: var(--ct-on-accent);
  }

  .ct-cta .ct-cta__btn--primary:hover {
    background: var(--ct-action-hover);
  }

  .ct-cta .ct-cta__btn--secondary {
    background: var(--ct-bg-surface);
    color: var(--ct-text);
    border-color: var(--ct-border-strong);
  }

  .ct-cta .ct-cta__btn--secondary:hover {
    background: var(--ct-bg-control);
  }

  .ct-cta .ct-cta__btn[aria-disabled="true"] {
    cursor: default;
    opacity: 0.6;
  }
{% endstyle %}

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to get started"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Add a short supporting line that gives shoppers a reason to take the next step."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Get started"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "button2_url",
      "label": "Secondary button link"
    },
    {
      "type": "checkbox",
      "id": "tint",
      "label": "Use tinted background",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "CTA banner"
    }
  ]
}
{% endschema %}
