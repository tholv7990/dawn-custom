{% render 'ct-section-padding', section: section %}

<section class="gs-scope gs-section section-{{ section.id }}-padding">
  <div class="gs-wrap">
    <div class="gs-feature-head">
      <h2 class="gs-section-heading">{{ section.settings.heading }}</h2>
      <p class="gs-section-sub">{{ section.settings.subheading }}</p>
    </div>
    {%- for block in section.blocks -%}
      {%- assign media_ratio = '4 / 3' -%}
      {%- if block.settings.video != blank and block.settings.video.aspect_ratio != blank -%}
        {%- assign media_ratio = block.settings.video.aspect_ratio -%}
      {%- elsif block.settings.image != blank and block.settings.image.aspect_ratio != blank -%}
        {%- assign media_ratio = block.settings.image.aspect_ratio -%}
      {%- endif -%}
      <div class="gs-feature{% if block.settings.image_side == 'left' %} gs-feature--reverse{% endif %}" {{ block.shopify_attributes }}>
        <div class="gs-feature__text">
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.body }}</p>
          <div class="gs-feature__tags">
            <span>{{ block.settings.tag_1 }}</span>
            <span>{{ block.settings.tag_2 }}</span>
          </div>
        </div>
        {% render 'ct-media-slot',
          image: block.settings.image,
          video: block.settings.video,
          class: 'gs-feature__media',
          label: block.settings.image_label,
          ratio: media_ratio
        %}
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Feature blocks",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Show the product story clearly" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Use these blocks to explain benefits, details, and use cases with merchant-owned copy." },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 60 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Feature heading" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Add feature copy that matches your product." },
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "image_picker", "id": "image", "label": "Image fallback" },
        { "type": "text", "id": "image_label", "label": "Placeholder label", "default": "Feature media" },
        { "type": "text", "id": "tag_1", "label": "Tag 1", "default": "Feature" },
        { "type": "text", "id": "tag_2", "label": "Tag 2", "default": "Detail" },
        { "type": "select", "id": "image_side", "label": "Image side", "options": [{ "value": "right", "label": "Right" }, { "value": "left", "label": "Left" }], "default": "right" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature blocks",
      "blocks": [
        { "type": "feature", "settings": { "image_side": "right" } },
        { "type": "feature", "settings": { "image_side": "left" } },
        { "type": "feature", "settings": { "image_side": "right" } }
      ]
    }
  ]
}
{% endschema %}
