{% render 'ct-section-padding', section: section %}

<section class="gs-scope gs-section section-{{ section.id }}-padding">
  <div class="gs-wrap">
    <div class="gs-feature-head">
      <h2 class="gs-section-heading">{{ section.settings.heading }}</h2>
      <p class="gs-section-sub">{{ section.settings.subheading }}</p>
    </div>
    {%- for block in section.blocks -%}
      {%- assign media_ratio = '4 / 3' -%}
      {%- if block.settings.video != blank and block.settings.video.aspect_ratio != blank -%}
        {%- assign media_ratio = block.settings.video.aspect_ratio -%}
      {%- elsif block.settings.image != blank and block.settings.image.aspect_ratio != blank -%}
        {%- assign media_ratio = block.settings.image.aspect_ratio -%}
      {%- endif -%}
      <div class="gs-feature{% if block.settings.image_side == 'left' %} gs-feature--reverse{% endif %}" {{ block.shopify_attributes }}>
        <div class="gs-feature__text">
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.body }}</p>
          <div class="gs-feature__tags">
            {%- if block.settings.tag_1 != blank -%}<span>{{ block.settings.tag_1 }}</span>{%- endif -%}
            {%- if block.settings.tag_2 != blank -%}<span>{{ block.settings.tag_2 }}</span>{%- endif -%}
          </div>
        </div>
        {% render 'ct-media-slot',
          image: block.settings.image,
          video: block.settings.video,
          class: 'gs-feature__media',
          label: block.settings.image_label,
          ratio: media_ratio
        %}
      </div>
    {%- endfor -%}
  </div>
</section>

{% style %}
  .section-{{ section.id }}-padding .gs-feature__text h3 {
    line-height: var(--ct-leading-tight);
    color: var(--ct-text);
  }

  .section-{{ section.id }}-padding .gs-feature__text p {
    max-width: 46ch;
    line-height: var(--ct-leading-base);
  }

  .section-{{ section.id }}-padding .gs-feature--reverse .gs-feature__text p {
    margin-left: auto;
  }

  .section-{{ section.id }}-padding .gs-feature__media {
    overflow: hidden;
    background: var(--ct-accent-subtle);
    box-shadow: var(--ct-shadow-sm);
  }

  .section-{{ section.id }}-padding .gs-feature__tags span {
    border: 1px solid var(--ct-accent-border);
    line-height: var(--ct-leading-tight);
    letter-spacing: 0.02em;
    transition: transform 0.2s ease;
  }

  .section-{{ section.id }}-padding .gs-feature__tags span:hover {
    transform: translateY(-1px);
  }

  @media (max-width: 749px) {
    .section-{{ section.id }}-padding .gs-feature__text p,
    .section-{{ section.id }}-padding .gs-feature--reverse .gs-feature__text p {
      max-width: none;
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-{{ section.id }}-padding .gs-feature__tags span {
      transition: none;
    }

    .section-{{ section.id }}-padding .gs-feature__tags span:hover {
      transform: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Feature blocks",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built around the details that matter" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Each block pairs a clear benefit with supporting media, so customers see exactly what makes your product worth it." },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 60 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Designed for everyday use" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Describe the standout benefit in a sentence or two. Focus on what the customer gains and why it fits naturally into their routine." },
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "image_picker", "id": "image", "label": "Image fallback" },
        { "type": "text", "id": "image_label", "label": "Placeholder label", "default": "Add feature image" },
        { "type": "text", "id": "tag_1", "label": "Tag 1", "default": "Quality" },
        { "type": "text", "id": "tag_2", "label": "Tag 2", "default": "Everyday" },
        { "type": "select", "id": "image_side", "label": "Image side", "options": [{ "value": "right", "label": "Right" }, { "value": "left", "label": "Left" }], "default": "right" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature blocks",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "image_side": "right",
            "heading": "Designed for everyday use",
            "body": "Built to slot into daily routines without fuss. Highlight the practical benefit customers notice first and the small details that make it easy to live with.",
            "image_label": "Add lifestyle image",
            "tag_1": "Practical",
            "tag_2": "Everyday"
          }
        },
        {
          "type": "feature",
          "settings": {
            "image_side": "left",
            "heading": "Made with quality materials",
            "body": "Call out the materials and construction that set your product apart. Explain how thoughtful choices translate into a better feel and longer life.",
            "image_label": "Add detail close-up",
            "tag_1": "Durable",
            "tag_2": "Premium"
          }
        },
        {
          "type": "feature",
          "settings": {
            "image_side": "right",
            "heading": "Thoughtful details throughout",
            "body": "Show the finishing touches that reward a closer look. Use this block to connect the small, considered details to the experience your customer gets.",
            "image_label": "Add feature image",
            "tag_1": "Considered",
            "tag_2": "Refined"
          }
        }
      ]
    }
  ]
}
{% endschema %}
