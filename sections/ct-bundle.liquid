{%- liquid
  assign main_product = section.settings.main_product
  assign addon_1 = section.settings.addon_1
  assign addon_2 = section.settings.addon_2
-%}
{%- if main_product != blank -%}
  {% render 'ct-section-padding', section: section %}

  {%- liquid
    assign total = 0
    assign compare_total = 0
    assign all_available = true

    if main_product != blank
      assign mv = main_product.selected_or_first_available_variant
      assign total = total | plus: main_product.price
      if main_product.compare_at_price > main_product.price
        assign compare_total = compare_total | plus: main_product.compare_at_price
      else
        assign compare_total = compare_total | plus: main_product.price
      endif
      unless mv.available
        assign all_available = false
      endunless
    endif

    if addon_1 != blank
      assign a1v = addon_1.selected_or_first_available_variant
      assign total = total | plus: addon_1.price
      if addon_1.compare_at_price > addon_1.price
        assign compare_total = compare_total | plus: addon_1.compare_at_price
      else
        assign compare_total = compare_total | plus: addon_1.price
      endif
      unless a1v.available
        assign all_available = false
      endunless
    endif

    if addon_2 != blank
      assign a2v = addon_2.selected_or_first_available_variant
      assign total = total | plus: addon_2.price
      if addon_2.compare_at_price > addon_2.price
        assign compare_total = compare_total | plus: addon_2.compare_at_price
      else
        assign compare_total = compare_total | plus: addon_2.price
      endif
      unless a2v.available
        assign all_available = false
      endunless
    endif

    assign savings = compare_total | minus: total
    assign has_savings = false
    if savings > 0
      assign has_savings = true
    endif
  -%}

  <section
    class="ct-bundle gs-scope section-{{ section.id }}-padding"
    id="ct-bundle-{{ section.id }}"
    data-section-id="{{ section.id }}"
  >
    <div class="gs-wrap">
      {%- if section.settings.heading != blank -%}
        <h2 class="gs-section-heading ct-bundle__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="ct-bundle__inner">
        <ul class="ct-bundle__cards" role="list">
          {% render 'ct-bundle-card', product: main_product %}
          {% if addon_1 != blank %}
            {% render 'ct-bundle-card', product: addon_1, show_plus: true %}
          {% endif %}
          {% if addon_2 != blank %}
            {% render 'ct-bundle-card', product: addon_2, show_plus: true %}
          {% endif %}
        </ul>

        <div class="ct-bundle__summary">
          <div class="ct-bundle__total-row">
            <span class="ct-bundle__total-label">{{ 'Bundle total' | escape }}</span>
            <span class="ct-bundle__total">
              {%- if has_savings -%}
                <s class="ct-bundle__total-was">{{ compare_total | money }}</s>
              {%- endif -%}
              <span class="ct-bundle__total-now">{{ total | money }}</span>
            </span>
          </div>

          {%- if section.settings.show_savings and has_savings -%}
            <p class="ct-bundle__savings">{{ 'You save' | escape }} {{ savings | money }}</p>
          {%- endif -%}

          <button
            type="button"
            class="ct-bundle__atc"
            data-bundle-add
            {% unless all_available %}aria-disabled="true" disabled{% endunless %}
          >
            <span class="ct-bundle__atc-label">{{ section.settings.button_label | escape }}</span>
            <span class="ct-bundle__atc-loading" data-bundle-loading hidden>
              {%- render 'loading-spinner' -%}
            </span>
          </button>

          <p class="ct-bundle__error" data-bundle-error role="alert" aria-live="assertive" hidden></p>
        </div>
      </div>
    </div>
  </section>

  {%- style -%}
    .ct-bundle {
      background: var(--ct-bg);
      color: var(--ct-text);
    }
    .ct-bundle .gs-wrap {
      max-width: 980px;
      margin: 0 auto;
    }
    .ct-bundle__heading {
      text-align: center;
      margin-bottom: var(--ct-space-5);
    }
    .ct-bundle__inner {
      background: var(--ct-card-bg);
      border: 1px solid var(--ct-card-border);
      border-radius: var(--ct-r-lg);
      box-shadow: var(--ct-shadow-sm);
      padding: var(--ct-space-6);
    }
    .ct-bundle__cards {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: stretch;
      justify-content: center;
      gap: var(--ct-space-4);
    }
    .ct-bundle__card {
      flex: 1 1 200px;
      max-width: 240px;
      display: flex;
      flex-direction: column;
      background: var(--ct-bg-raised);
      border: 1px solid var(--ct-border);
      border-radius: var(--ct-r-md);
      overflow: hidden;
    }
    .ct-bundle__card-link {
      display: block;
      text-decoration: none;
      color: inherit;
    }
    .ct-bundle__media {
      width: 100%;
    }
    .ct-bundle__card-body {
      display: flex;
      flex-direction: column;
      gap: var(--ct-space-2);
      padding: var(--ct-space-4);
    }
    .ct-bundle__card-title {
      font-size: var(--ct-text-sm);
      font-weight: var(--ct-fw-semi);
      line-height: 1.3;
      color: var(--ct-text);
      text-decoration: none;
    }
    .ct-bundle__card-title:hover {
      color: var(--ct-action);
    }
    .ct-bundle__card-price {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: var(--ct-space-2);
    }
    .ct-bundle__price-now {
      font-size: var(--ct-text-base);
      font-weight: var(--ct-fw-bold);
      color: var(--ct-price);
    }
    .ct-bundle__price-was {
      font-size: var(--ct-text-xs);
      color: var(--ct-price-compare);
    }
    .ct-bundle__plus {
      align-self: center;
      font-size: var(--ct-text-2xl);
      font-weight: var(--ct-fw-normal);
      color: var(--ct-text-3);
      list-style: none;
    }
    .ct-bundle__summary {
      margin-top: var(--ct-space-6);
      padding-top: var(--ct-space-6);
      border-top: 1px solid var(--ct-border);
      display: flex;
      flex-direction: column;
      gap: var(--ct-space-4);
    }
    .ct-bundle__total-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--ct-space-3);
    }
    .ct-bundle__total-label {
      font-size: var(--ct-text-base);
      font-weight: var(--ct-fw-medium);
      color: var(--ct-text-2);
    }
    .ct-bundle__total {
      display: inline-flex;
      align-items: baseline;
      gap: var(--ct-space-2);
    }
    .ct-bundle__total-was {
      font-size: var(--ct-text-base);
      color: var(--ct-price-compare);
    }
    .ct-bundle__total-now {
      font-size: var(--ct-text-2xl);
      font-weight: var(--ct-fw-bold);
      color: var(--ct-price);
    }
    .ct-bundle__savings {
      margin: 0;
      font-size: var(--ct-text-sm);
      font-weight: var(--ct-fw-semi);
      color: var(--ct-success);
    }
    .ct-bundle__atc {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--ct-space-2);
      width: 100%;
      min-height: 48px;
      padding: var(--ct-space-3) var(--ct-space-6);
      border: 1px solid transparent;
      border-radius: var(--ct-r-pill);
      background: var(--ct-action);
      color: var(--ct-on-accent);
      font-size: var(--ct-text-base);
      font-weight: var(--ct-fw-bold);
      cursor: pointer;
      transition: background var(--ct-dur-base) var(--ct-ease-out);
    }
    .ct-bundle__atc:hover {
      background: var(--ct-action-hover);
    }
    .ct-bundle__atc[disabled],
    .ct-bundle__atc[aria-disabled='true'] {
      opacity: 0.55;
      cursor: not-allowed;
    }
    .ct-bundle__atc[aria-busy='true'] .ct-bundle__atc-label {
      visibility: hidden;
    }
    .ct-bundle__atc-loading {
      display: inline-flex;
      align-items: center;
    }
    .ct-bundle__atc-loading[hidden] {
      display: none;
    }
    .ct-bundle__atc .loading-spinner {
      position: static;
    }
    .ct-bundle__error {
      margin: 0;
      font-size: var(--ct-text-sm);
      font-weight: var(--ct-fw-medium);
      color: var(--ct-badge-sale);
    }
    .ct-bundle__error[hidden] {
      display: none;
    }
    @media screen and (max-width: 749px) {
      .ct-bundle__inner {
        padding: var(--ct-space-5);
      }
      .ct-bundle__card {
        flex: 1 1 140px;
      }
      .ct-bundle__total-now {
        font-size: var(--ct-text-xl);
      }
    }
  {%- endstyle -%}

  <script>
    (function () {
      var SECTION_ID = '{{ section.id }}';

      function init(root) {
        if (!root || root.dataset.ready === 'true') return;
        root.dataset.ready = 'true';

        var button = root.querySelector('[data-bundle-add]');
        if (!button) return;

        var loading = root.querySelector('[data-bundle-loading]');
        var errorEl = root.querySelector('[data-bundle-error]');

        function showError(message) {
          if (!errorEl) return;
          errorEl.textContent = message || 'Something went wrong. Please try again.';
          errorEl.hidden = false;
        }

        function clearError() {
          if (!errorEl) return;
          errorEl.textContent = '';
          errorEl.hidden = true;
        }

        function setBusy(isBusy) {
          button.disabled = isBusy;
          button.setAttribute('aria-busy', isBusy ? 'true' : 'false');
          if (loading) loading.hidden = !isBusy;
        }

        function getItems() {
          var nodes = root.querySelectorAll('.ct-bundle__variant-id');
          var items = [];
          for (var i = 0; i < nodes.length; i++) {
            var id = parseInt(nodes[i].value, 10);
            if (!isNaN(id)) {
              items.push({ id: id, quantity: 1 });
            }
          }
          return items;
        }

        button.addEventListener('click', function () {
          if (button.disabled) return;
          clearError();

          var items = getItems();
          if (!items.length) {
            showError('No products available to add.');
            return;
          }

          var cart =
            document.querySelector('cart-notification') || document.querySelector('cart-drawer');
          var rootUrl =
            (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
          var endpoint = rootUrl + 'cart/add.js';

          var sectionsToRender = [];
          if (cart && typeof cart.getSectionsToRender === 'function') {
            sectionsToRender = cart.getSectionsToRender().map(function (s) {
              return s.id;
            });
          } else {
            sectionsToRender = ['cart-drawer', 'cart-icon-bubble', 'cart-notification'];
          }

          var body = {
            items: items,
            sections: sectionsToRender,
            sections_url: window.location.pathname,
          };

          setBusy(true);

          fetch(endpoint, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
            },
            body: JSON.stringify(body),
          })
            .then(function (response) {
              return response.json().then(function (data) {
                if (!response.ok) {
                  throw new Error(
                    (data && (data.description || data.message)) || 'Unable to add bundle to cart.'
                  );
                }
                return data;
              });
            })
            .then(function (data) {
              if (cart && typeof cart.renderContents === 'function') {
                cart.renderContents(data);
              }
            })
            .catch(function (error) {
              showError(error && error.message ? error.message : 'Unable to add bundle to cart.');
            })
            .then(function () {
              setBusy(false);
            });
        });
      }

      init(document.getElementById('ct-bundle-' + SECTION_ID));

      document.addEventListener('shopify:section:load', function (event) {
        if (event.detail && event.detail.sectionId === SECTION_ID) {
          init(document.getElementById('ct-bundle-' + SECTION_ID));
        }
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Bundle offer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Buy it together"
    },
    {
      "type": "product",
      "id": "main_product",
      "label": "Main product"
    },
    {
      "type": "product",
      "id": "addon_1",
      "label": "Add-on product 1"
    },
    {
      "type": "product",
      "id": "addon_2",
      "label": "Add-on product 2"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add bundle to cart"
    },
    {
      "type": "checkbox",
      "id": "show_savings",
      "label": "Show savings line",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Bundle offer"
    }
  ]
}
{% endschema %}
