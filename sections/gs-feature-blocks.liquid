<section class="gs-scope gs-section">
  <div class="gs-wrap">
    <div class="gs-feature-head">
      <h2 class="gs-section-heading">{{ section.settings.heading }}</h2>
      <p class="gs-section-sub">{{ section.settings.subheading }}</p>
    </div>
    {%- for block in section.blocks -%}
      {%- assign media_ratio = '4 / 3' -%}
      {%- if block.settings.video != blank and block.settings.video.aspect_ratio != blank -%}
        {%- assign media_ratio = block.settings.video.aspect_ratio -%}
      {%- elsif block.settings.image != blank and block.settings.image.aspect_ratio != blank -%}
        {%- assign media_ratio = block.settings.image.aspect_ratio -%}
      {%- endif -%}
      <div class="gs-feature{% if block.settings.image_side == 'left' %} gs-feature--reverse{% endif %}" {{ block.shopify_attributes }}>
        <div class="gs-feature__text">
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.body }}</p>
          <div class="gs-feature__tags">
            <span>{{ block.settings.tag_1 }}</span>
            <span>{{ block.settings.tag_2 }}</span>
          </div>
        </div>
        {% render 'gs-media-slot',
          image: block.settings.image,
          video: block.settings.video,
          class: 'gs-feature__media',
          label: block.settings.image_label,
          ratio: media_ratio
        %}
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "GS feature blocks",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "&#129419; &#127969; Bring Your Garden to Life with an Everlasting Bloom! &#128161; &#128038; &#10084;&#65039;" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "&#128293;More than 28,000 likes from Facebook users, 25,000 orders in two years!" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Bring any corner of the garden to life" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "A handcrafted metal flower that turns a quiet flower bed, border or patio into a little highlight - glossy petals that catch the light and a bowl that doubles as a water station for birds and pollinators." },
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "image_picker", "id": "image", "label": "Image fallback" },
        { "type": "text", "id": "image_label", "label": "Placeholder label", "default": "Lifestyle image" },
        { "type": "text", "id": "tag_1", "label": "Tag 1", "default": "3-in-1 use" },
        { "type": "text", "id": "tag_2", "label": "Tag 2", "default": "Stake & go" },
        { "type": "select", "id": "image_side", "label": "Image side", "options": [{ "value": "right", "label": "Right" }, { "value": "left", "label": "Left" }], "default": "right" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GS feature blocks",
      "blocks": [
        { "type": "feature", "settings": { "heading": "Bring any corner of the garden to life", "body": "A handcrafted metal flower that turns a quiet flower bed, border or patio into a little highlight - glossy petals that catch the light and a bowl that doubles as a water station for birds and pollinators.", "image_label": "Lifestyle image", "tag_1": "3-in-1 use", "tag_2": "Stake & go", "image_side": "right" } },
        { "type": "feature", "settings": { "heading": "A glossy finish that catches the light", "body": "The weather-resistant coating keeps its color through sun and rain, and the curved petals reflect daylight so the piece adds a bit of movement and shine to the whole space.", "image_label": "Detail image", "tag_1": "Weather-resistant", "tag_2": "Glossy finish", "image_side": "left" } },
        { "type": "feature", "settings": { "heading": "A gift gardeners actually love", "body": "Practical and pretty in one - a thoughtful pick for birthdays, housewarmings or the holidays for anyone who likes to potter about the garden and watch the birds.", "image_label": "Gift image", "tag_1": "Gift-ready", "tag_2": "No tools", "image_side": "right" } }
      ]
    }
  ]
}
{% endschema %}
