{% render 'ct-section-padding', section: section %}

<section class="gs-scope ct-icon-cols section-{{ section.id }}-padding">
  <div class="gs-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="gs-section-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="gs-section-sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    <div class="ct-icon-cols__grid" style="--ct-cols: {{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <div class="ct-icon-cols__col" {{ block.shopify_attributes }}>
          <div class="ct-icon-cols__icon">
            {% render 'ct-icon', name: block.settings.icon, label: block.settings.title %}
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="ct-icon-cols__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <p class="ct-icon-cols__body">{{ block.settings.body | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  .ct-icon-cols {
    background: var(--ct-bg);
    color: var(--ct-text);
  }

  .ct-icon-cols .gs-section-heading,
  .ct-icon-cols .gs-section-sub {
    text-align: center;
  }

  .ct-icon-cols .gs-section-sub {
    max-width: 52ch;
    margin-inline: auto;
  }

  .ct-icon-cols__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ct-space-5);
    margin-top: var(--ct-space-8);
  }

  @media screen and (min-width: 600px) {
    .ct-icon-cols__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--ct-space-6);
    }
  }

  @media screen and (min-width: 990px) {
    .ct-icon-cols__grid {
      grid-template-columns: repeat(var(--ct-cols, 3), 1fr);
      gap: var(--ct-space-8);
    }
  }

  .ct-icon-cols__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ct-space-3);
    height: 100%;
    padding: var(--ct-space-6);
    background: var(--ct-card-bg);
    border: 1px solid var(--ct-card-border);
    border-radius: var(--ct-r-lg);
    box-shadow: var(--ct-shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  @media (hover: hover) {
    .ct-icon-cols__col:hover {
      transform: translateY(-4px);
      box-shadow: var(--ct-shadow-md);
      border-color: var(--ct-action);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ct-icon-cols__col {
      transition: none;
    }

    .ct-icon-cols__col:hover {
      transform: none;
    }
  }

  .ct-icon-cols__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--ct-r-md);
    background: var(--ct-action-tint);
    color: var(--ct-action);
    font-size: var(--ct-h3);
  }

  .ct-icon-cols__icon .ct-icon,
  .ct-icon-cols__icon svg {
    width: 1em;
    height: 1em;
  }

  .ct-icon-cols__icon svg {
    display: block;
  }

  .ct-icon-cols__title {
    margin: 0;
    font-size: var(--ct-h5);
    font-weight: var(--ct-fw-semi);
    line-height: var(--ct-leading-tight);
    color: var(--ct-text);
  }

  .ct-icon-cols__body {
    margin: 0;
    font-size: var(--ct-body-size);
    line-height: var(--ct-leading-loose);
    color: var(--ct-text-2);
  }
{% endstyle %}

{% schema %}
{
  "name": "Icon columns",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why shop with us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Thoughtful details and dependable service behind every order."
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns",
      "default": 4
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "info": "Icon key, e.g. check, truck, lock, star, leaf, bolt, recycle, info, heart.",
          "default": "verified"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Quality materials"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Chosen for durability and finish, so every piece holds up to everyday use."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon columns",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "icon": "verified",
            "title": "Quality materials",
            "body": "Chosen for durability and finish, so every piece holds up to everyday use."
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "truck",
            "title": "Fast shipping",
            "body": "Orders are packed quickly and dispatched with tracking from the moment they leave."
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "lock",
            "title": "Secure checkout",
            "body": "Pay with confidence through encrypted, trusted payment providers."
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "heart",
            "title": "Here to help",
            "body": "Friendly support is ready to answer questions before and after you buy."
          }
        }
      ]
    }
  ]
}
{% endschema %}
