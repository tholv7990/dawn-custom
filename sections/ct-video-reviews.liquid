{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-video-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ct-reviews-rail.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'ct-swipe.js' | asset_url }}" defer="defer"></script>

{% render 'ct-section-padding', section: section %}

{%- assign section_id = section.settings.anchor_id | default: section.id -%}

<section id="{{ section_id }}" class="ct-video-reviews section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="ct-video-reviews__head">
      {%- if section.settings.kicker != blank -%}<span class="ct-eyebrow">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="ct-video-reviews__grid">
      <div class="ct-video-reviews__video ct-media ct-media--contain">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: autoplay: false, loop: false, muted: false, controls: true, preload: 'metadata', image_size: '900x' }}
        {%- elsif section.settings.poster != blank -%}
          {{ section.settings.poster | image_url: width: 960 | image_tag: loading: 'lazy', widths: '480, 720, 960', sizes: '(max-width: 860px) 100vw, 58vw', alt: section.settings.poster.alt | default: section.settings.heading | escape }}
          <span class="ct-video-reviews__play" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </span>
        {%- else -%}
          <span class="ct-video-reviews__play" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </span>
        {%- endif -%}
        {%- if section.settings.video_label != blank -%}
          <span class="ct-video-reviews__label">{{ section.settings.video_label }}</span>
        {%- endif -%}
      </div>

      {%- capture action_tiles -%}
        {%- for block in section.blocks -%}
          <div class="ct-video-reviews__tile ct-media ct-media--contain" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '240, 320, 420', sizes: '(max-width: 760px) 82vw, 22vw', alt: block.settings.image.alt | default: block.settings.label | escape }}
            {%- else -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4l3 3h8l3-3v9a7 7 0 0 1-14 0z"/><path d="M9 11h.01M15 11h.01M10 15c1.2.8 2.8.8 4 0"/></svg>
            {%- endif -%}
            {%- if block.settings.loop_label != blank -%}<span class="ct-video-reviews__loop">{{ block.settings.loop_label }}</span>{%- endif -%}
            {%- if block.settings.label != blank -%}<span class="ct-video-reviews__tag">{{ block.settings.label }}</span>{%- endif -%}
          </div>
        {%- endfor -%}
      {%- endcapture -%}

      <ct-reviews-rail class="ct-video-reviews__rail">
        <div class="ct-video-reviews__tiles" data-reviews-rail-track data-swipe>{{ action_tiles }}</div>
        {%- if section.blocks.size > 1 -%}
          <div class="ct-video-reviews__dots" role="tablist" aria-label="{{ section.settings.heading | default: 'Action clips' | escape }}">
            {%- for block in section.blocks -%}
              <button type="button" class="ct-video-reviews__dot{% if forloop.first %} is-active{% endif %}" data-reviews-rail-dot data-index="{{ forloop.index0 }}" aria-label="Clip {{ forloop.index }} of {{ section.blocks.size }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </ct-reviews-rail>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CT Video reviews",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "See it in action" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for a cat who never sits still" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pounces, zoomies, the dramatic flop - watch the mat keep up with all of it." },
    { "type": "video", "id": "video", "label": "Product video" },
    { "type": "image_picker", "id": "poster", "label": "Poster / placeholder image" },
    { "type": "text", "id": "video_label", "label": "Video label", "default": "60-second product tour" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "Action tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "GIF or image" },
        { "type": "text", "id": "label", "label": "Label", "default": "The pounce" },
        { "type": "text", "id": "loop_label", "label": "Loop label", "default": "GIF" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "CT Video reviews",
      "blocks": [
        { "type": "clip", "settings": { "label": "The pounce" } },
        { "type": "clip", "settings": { "label": "Big stretch" } },
        { "type": "clip", "settings": { "label": "Zoomies" } },
        { "type": "clip", "settings": { "label": "Nap o'clock" } }
      ]
    }
  ]
}
{% endschema %}
