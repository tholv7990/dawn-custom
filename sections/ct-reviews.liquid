{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-reviews.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding{padding-top:{{ section.settings.padding_top | times: 0.75 | round: 0 }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px}
  @media screen and (min-width:750px){.section-{{ section.id }}-padding{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <div class="ct-section-head" data-reveal>
      {%- if section.settings.kicker != blank -%}<div class="ct-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
      <h2 class="ct-section-head__title">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}
  {%- if section.settings.rating_number != blank -%}
    <div class="ct-reviews-rating-row" data-reveal>
      <div class="ct-reviews-big-num">{{ section.settings.rating_number }}</div>
      <div class="ct-reviews-rating-col">
        <div class="ct-stars">★★★★★</div>
        {%- if section.settings.rating_count != blank -%}<div class="ct-rating-count">{{ section.settings.rating_count }}</div>{%- endif -%}
      </div>
    </div>
  {%- endif -%}
  <div class="ct-reviews-track" data-swipe>
    {%- for block in section.blocks -%}
      <div class="ct-review-card" data-reveal data-delay="{{ forloop.index0 | times: 80 }}" {{ block.shopify_attributes }}>
        <div class="ct-review-head">
          <span class="ct-stars" aria-label="{{ block.settings.rating }} out of 5">
            {%- assign r = block.settings.rating | at_most: 5 -%}
            {%- for s in (1..5) -%}{% if s <= r %}★{% else %}☆{% endif %}{%- endfor -%}
          </span>
          {%- if block.settings.verified -%}<span class="ct-review-verified">✓ Verified</span>{%- endif -%}
        </div>
        <p class="ct-review-text">{{ block.settings.text }}</p>
        <div class="ct-review-author">
          <div class="ct-review-avatar">{{ block.settings.author | slice: 0 | upcase }}</div>
          <div>
            <div class="ct-review-name">{{ block.settings.author }}</div>
            {%- if block.settings.meta != blank -%}<div class="ct-review-date">{{ block.settings.meta }}</div>{%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "CT Reviews",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Loved by 10,000+" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" },
    { "type": "text", "id": "rating_number", "label": "Aggregate rating number (e.g. 4.7)" },
    { "type": "text", "id": "rating_count", "label": "Aggregate rating count (e.g. 52 verified reviews)" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review text", "default": "Specific result, emotional benefit, and a detail that proves authenticity. Avoid generic praise." },
        { "type": "text", "id": "author", "label": "Author name", "default": "Marcus T." },
        { "type": "text", "id": "meta", "label": "Author meta", "default": "Verified · 2 months ago" },
        { "type": "checkbox", "id": "verified", "label": "Show verified badge", "default": true }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "CT Reviews",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "author": "Marcus T.", "meta": "Verified · 2 months ago" } },
        { "type": "review", "settings": { "rating": 5, "author": "Sarah K.", "meta": "Verified · 1 month ago" } },
        { "type": "review", "settings": { "rating": 4, "author": "James R.", "meta": "Verified · 3 weeks ago" } }
      ]
    }
  ]
}
{% endschema %}
