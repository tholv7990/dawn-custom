{% render 'ct-section-padding', section: section %}

<section class="gs-scope gs-section gs-soft section-{{ section.id }}-padding" id="reviews">
  <div class="gs-wrap">
    <span class="gs-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="gs-section-heading">{{ section.settings.heading }}</h2>
    <div class="gs-review-grid" data-gs-carousel="reviews">
      {%- for block in section.blocks -%}
        {%- liquid
          assign review_name = block.settings.name | strip
          assign review_title = block.settings.title | strip
          assign review_body = block.settings.body | strip
        -%}
        <article class="gs-review-card" data-gs-slide {{ block.shopify_attributes }}>
          {% render 'ct-media-slot', image: block.settings.photo, class: 'gs-review-card__media', label: 'Customer photo', ratio: '1 / 1' %}
          <div class="gs-review-card__body">
            <div class="gs-review-card__name">{{ review_name }}</div>
            {%- if block.settings.verified -%}<span class="gs-verified">&#9679; Verified Buyer</span>{%- endif -%}
            <div class="gs-stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..block.settings.rating) -%}&starf;{%- endfor -%}
            </div>
            <h5>{{ review_title }}</h5>
            <p>{{ review_body }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
    <div class="gs-dots" data-gs-dots="reviews"></div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From real customers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers are saying" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 60 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Name", "default": "[Customer name]" },
        { "type": "checkbox", "id": "verified", "label": "Verified", "default": false },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title", "default": "[Review title]" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "[Paste a genuine customer review here]" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
