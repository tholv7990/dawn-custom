<div class="gs-scope">
  <div class="gs-announce gs-announce--top">
    <div class="gs-announce__track">
      {%- for repeat in (1..2) -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'top_message' -%}
            <span{% if repeat == 1 %} {{ block.shopify_attributes }}{% else %} aria-hidden="true"{% endif %}>
              {%- if block.settings.icon != blank -%}<b aria-hidden="true">{{ block.settings.icon }}</b>{%- endif -%}
              {{ block.settings.text }}
            </span>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
  <div class="gs-announce gs-announce--green">
    <div class="gs-announce__track">
      {%- for repeat in (1..2) -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'bottom_message' -%}
            <span{% if repeat == 1 %} {{ block.shopify_attributes }}{% else %} aria-hidden="true"{% endif %}>
              {%- if block.settings.icon != blank -%}<b aria-hidden="true">{{ block.settings.icon }}</b>{%- endif -%}
              {{ block.settings.text }}
            </span>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "GS announcement bars",
  "settings": [
    { "type": "paragraph", "content": "Renders a continuous scrolling ticker. Keep message text short so each item remains readable on mobile." }
  ],
  "blocks": [
    {
      "type": "top_message",
      "name": "Top message",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "+1" },
        { "type": "text", "id": "text", "label": "Text", "default": "24/7 online support" }
      ]
    },
    {
      "type": "bottom_message",
      "name": "Bottom message",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "OK" },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over $40" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GS announcement bars",
      "blocks": [
        { "type": "top_message", "settings": { "icon": "Phone", "text": "(214) 555-5937" } },
        { "type": "top_message", "settings": { "icon": "Care", "text": "24/7 online support" } },
        { "type": "top_message", "settings": { "icon": "Email", "text": "support@gardenstudio.site" } },
        { "type": "bottom_message", "settings": { "icon": "Ships", "text": "from trusted warehouses" } },
        { "type": "bottom_message", "settings": { "icon": "Returns", "text": "30-day returns" } },
        { "type": "bottom_message", "settings": { "icon": "Free", "text": "shipping over $40" } },
        { "type": "bottom_message", "settings": { "icon": "Warranty", "text": "12-month warranty" } }
      ]
    }
  ]
}{% endschema %}

