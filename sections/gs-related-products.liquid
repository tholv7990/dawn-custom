{%- liquid
  assign related_count = 0
  for item in section.settings.products limit: 4
    if item != blank
      if product == blank or item.id != product.id
        assign related_count = related_count | plus: 1
      endif
    endif
  endfor
-%}
{%- if related_count > 0 -%}
  <section class="gs-scope gs-section">
    <div class="gs-wrap">
      <h2 class="gs-related__heading">{{ section.settings.heading }}</h2>
      <div class="gs-related-grid" data-gs-carousel="related">
        {%- for item in section.settings.products limit: 4 -%}
          {%- if item != blank -%}
            {%- assign show_item = true -%}
            {%- if product != blank and item.id == product.id -%}
              {%- assign show_item = false -%}
            {%- endif -%}
            {%- if show_item -%}
              <article class="gs-product-card" data-gs-slide>
                <a class="gs-product-card__media gs-media-slot" href="{{ item.url }}">
                  {%- if item.featured_image != blank -%}
                    {{ item.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: item.featured_image.alt | default: item.title | escape }}
                  {%- endif -%}
                  {%- if item.compare_at_price > item.price -%}<span class="gs-product-card__save">SAVE</span>{%- endif -%}
                </a>
                <div class="gs-product-card__body">
                  <a class="gs-product-card__title" href="{{ item.url }}">{{ item.title }}</a>
                  <div class="gs-product-card__price">
                    {{ item.price | money }}
                    {%- if item.compare_at_price > item.price -%}<s>{{ item.compare_at_price | money }}</s>{%- endif -%}
                  </div>
                  <a class="gs-card-btn" href="{{ item.url }}">Choose options</a>
                </div>
              </article>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="gs-dots" data-gs-dots="related"></div>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "GS related products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 4 }
  ],
  "presets": [{ "name": "GS related products" }]
}
{% endschema %}
