{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-use-cases.css' | asset_url | stylesheet_tag }}
{%- if section.settings.layout == 'feature-gifs' -%}
  <script src="{{ 'ct-reviews-rail.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'ct-swipe.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% render 'ct-section-padding', section: section %}

{%- assign section_id = section.settings.anchor_id | default: section.id -%}

<div id="{{ section_id }}" class="page-width section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  {% render 'ct-section-head', kicker: section.settings.kicker, heading: section.settings.heading %}
  {%- capture use_case_cards -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign use_case_text = block.settings.title | append: ' ' | append: block.settings.tag | append: ' ' | append: block.settings.desc | downcase
        assign fa_icon = 'paw'
        assign icon_tone = 'coffee'
        if use_case_text contains 'processing'
          assign fa_icon = 'box-open'
          assign icon_tone = 'gold'
        elsif use_case_text contains 'international' or use_case_text contains 'worldwide'
          assign fa_icon = 'globe'
          assign icon_tone = 'coffee'
        elsif use_case_text contains 'domestic' or use_case_text contains 'shipping' or use_case_text contains 'delivery'
          assign fa_icon = 'truck-fast'
          assign icon_tone = 'coffee'
        elsif use_case_text contains 'supportive' or use_case_text contains 'pillow' or use_case_text contains 'bolster'
          assign fa_icon = 'bed'
          assign icon_tone = 'coffee'
        elsif use_case_text contains 'sofa' or use_case_text contains 'hair' or use_case_text contains 'non-slip'
          assign fa_icon = 'couch'
          assign icon_tone = 'green'
        elsif use_case_text contains 'clean' or use_case_text contains 'wash'
          assign fa_icon = 'soap'
          assign icon_tone = 'green'
        elsif use_case_text contains 'durable'
          assign fa_icon = 'shield-halved'
          assign icon_tone = 'green-dark'
        endif
      -%}
      <div class="ct-card ct-use-case-card" data-reveal data-delay="{{ forloop.index0 | times: 80 }}" {{ block.shopify_attributes }}>
        <div class="ct-use-case-img ct-media{% if section.settings.layout == 'feature-gifs' %} ct-media--contain{% else %} ct-media--cover{% endif %}">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240, 360, 480', sizes: '(max-width: 760px) 82vw, 25vw', class: 'ct-use-case-img__media', alt: block.settings.title | escape }}
          {%- else -%}
            <span class="ct-use-case-img__fa ct-use-case-img__fa--{{ icon_tone }}">
              {%- render 'ct-fa-icon', icon: fa_icon -%}
            </span>
          {%- endif -%}
          {%- if block.settings.tag != blank -%}<span class="ct-use-case-tag">{{ block.settings.tag }}</span>{%- endif -%}
        </div>
        <div class="ct-use-case-body">
          {%- if block.settings.number != blank -%}<div class="ct-use-case-num">{{ block.settings.number }}</div>{%- endif -%}
          <div class="ct-use-case-title">{{ block.settings.title }}</div>
          <div class="ct-use-case-desc">{{ block.settings.desc }}</div>
          {%- if block.settings.cta != blank -%}<div class="ct-use-case-cta">{{ block.settings.cta }}</div>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  {%- endcapture -%}

  {%- if section.settings.layout == 'feature-gifs' -%}
    <ct-reviews-rail class="ct-use-case-rail">
      <div class="ct-use-case-grid" data-layout="{{ section.settings.layout }}" data-reviews-rail-track data-swipe>{{ use_case_cards }}</div>
      {%- if section.blocks.size > 1 -%}
        <div class="ct-use-case-rail-dots" role="tablist" aria-label="{{ section.settings.heading | default: 'Features' | escape }}">
          {%- for block in section.blocks -%}
            <button type="button" class="ct-use-case-rail-dot{% if forloop.first %} is-active{% endif %}" data-reviews-rail-dot data-index="{{ forloop.index0 }}" aria-label="Feature {{ forloop.index }} of {{ section.blocks.size }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </ct-reviews-rail>
  {%- else -%}
    <div class="ct-use-case-grid" data-layout="{{ section.settings.layout | default: 'grid' }}">{{ use_case_cards }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "CT Use cases",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id (e.g. \"why\")" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Who it's for" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One product, every context" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "grid", "label": "Grid (image cards)" }, { "value": "pillars", "label": "Pillars (icon + horizontal card)" }, { "value": "feature-gifs", "label": "Feature cards (text + GIF)" } ], "default": "grid" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Use case",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image / GIF" },
        { "type": "text", "id": "emoji", "label": "Fallback emoji", "default": "Home" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Context" },
        { "type": "text", "id": "title", "label": "Title", "default": "Use case headline" },
        { "type": "textarea", "id": "desc", "label": "Description", "default": "1-2 sentence description of this buyer's context and how the product fits their life." },
        { "type": "text", "id": "number", "label": "Number label (e.g. No. 01 - Morning)" },
        { "type": "text", "id": "cta", "label": "CTA line" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "CT Use cases",
      "blocks": [
        { "type": "card", "settings": { "emoji": "Home", "tag": "Home", "title": "Use case headline 1" } },
        { "type": "card", "settings": { "emoji": "Work", "tag": "Work", "title": "Use case headline 2" } },
        { "type": "card", "settings": { "emoji": "Travel", "tag": "Travel", "title": "Use case headline 3" } }
      ]
    }
  ]
}
{% endschema %}
