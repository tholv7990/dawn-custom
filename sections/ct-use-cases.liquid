{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-use-cases.css' | asset_url | stylesheet_tag }}

{% render 'ct-section-padding', section: section %}

<div class="page-width section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  {% render 'ct-section-head', kicker: section.settings.kicker, heading: section.settings.heading %}
  <div class="ct-use-case-grid">
    {%- for block in section.blocks -%}
      <div class="ct-use-case-card" data-reveal data-delay="{{ forloop.index0 | times: 80 }}" {{ block.shopify_attributes }}>
        <div class="ct-use-case-img">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'ct-use-case-img__media', alt: block.settings.title | escape }}
          {%- else -%}
            <span>{{ block.settings.emoji | default: '🏠' }}</span>
          {%- endif -%}
          {%- if block.settings.tag != blank -%}<span class="ct-use-case-tag">{{ block.settings.tag }}</span>{%- endif -%}
        </div>
        <div class="ct-use-case-body">
          {%- if block.settings.number != blank -%}<div class="ct-use-case-num">{{ block.settings.number }}</div>{%- endif -%}
          <div class="ct-use-case-title">{{ block.settings.title }}</div>
          <div class="ct-use-case-desc">{{ block.settings.desc }}</div>
          {%- if block.settings.cta != blank -%}<div class="ct-use-case-cta">{{ block.settings.cta }}</div>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "CT Use cases",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Who it's for" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One product, every context" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Use case",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "emoji", "label": "Fallback emoji", "default": "🏠" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Context" },
        { "type": "text", "id": "title", "label": "Title", "default": "Use case headline" },
        { "type": "textarea", "id": "desc", "label": "Description", "default": "1–2 sentence description of this buyer's context and how the product fits their life." },
        { "type": "text", "id": "number", "label": "Number label (e.g. No. 01 · Morning)" },
        { "type": "text", "id": "cta", "label": "CTA line" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "CT Use cases",
      "blocks": [
        { "type": "card", "settings": { "emoji": "🏠", "tag": "Home", "title": "Use case headline 1" } },
        { "type": "card", "settings": { "emoji": "💼", "tag": "Work", "title": "Use case headline 2" } },
        { "type": "card", "settings": { "emoji": "✈️", "tag": "Travel", "title": "Use case headline 3" } }
      ]
    }
  ]
}
{% endschema %}
