{%- comment -%}
  sections/ct-cart-upsells.liquid - cart-page upsell rail.

  Renders a short "complete your order" product rail on the cart page. Each card
  goes through the reusable ct-upsell-card snippet, which renders a Dawn
  <product-form> for AJAX add-to-cart; we load Dawn's product-form.js via a
  deferred (non-blocking) script tag when there is at least one product to show.

  Products already in the cart are skipped (matched by product id) so the rail
  only surfaces things the shopper has not added yet. The whole section is
  server-rendered and renders nothing when no eligible products remain.
{%- endcomment -%}
{%- liquid
  assign show_variant = section.settings.show_variant

  comment
    Collect the product ids already in the cart so we can exclude them.
  endcomment
  assign cart_product_ids = ''
  for line_item in cart.items
    assign cart_product_ids = cart_product_ids | append: ',' | append: line_item.product_id | append: ','
  endfor

  assign upsell_count = 0
  for item in section.settings.products limit: 4
    if item == blank
      continue
    endif
    assign id_token = ',' | append: item.id | append: ','
    if cart_product_ids contains id_token
      continue
    endif
    assign upsell_count = upsell_count | plus: 1
  endfor
-%}

{%- if upsell_count > 0 -%}
  {% render 'ct-section-padding', section: section %}

  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

  <section class="gs-scope ct-cart-upsells section-{{ section.id }}-padding">
    <div class="gs-wrap">
      {%- if section.settings.heading != blank -%}
        <h2 class="gs-section-heading ct-cart-upsells__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <ul
        class="ct-cart-upsells__grid"
        role="list"
        style="--ct-cols: {{ upsell_count }};"
      >
        {%- for item in section.settings.products limit: 4 -%}
          {%- if item == blank -%}{% continue %}{%- endif -%}
          {%- assign id_token = ',' | append: item.id | append: ',' -%}
          {%- if cart_product_ids contains id_token -%}{% continue %}{%- endif -%}
          <li class="ct-cart-upsells__item">
            {% render 'ct-upsell-card',
              product: item,
              section_id: section.id,
              show_variant: show_variant
            %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>

  {%- style -%}
    .ct-cart-upsells__heading {
      margin-top: 0;
      margin-bottom: var(--ct-space-6);
    }

    .ct-cart-upsells__grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(var(--ct-cols, 4), minmax(0, 1fr));
      gap: var(--ct-space-4);
    }

    .ct-cart-upsells__item {
      margin: 0;
      min-width: 0;
    }

    @media screen and (max-width: 989px) {
      .ct-cart-upsells__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 599px) {
      .ct-cart-upsells__grid {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "Cart upsells",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Leave blank to hide.",
      "default": "Complete your order"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 4
    },
    {
      "type": "checkbox",
      "id": "show_variant",
      "label": "Show variant selector",
      "default": false
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Cart upsells"
    }
  ]
}
{% endschema %}
