{%- liquid
  assign main_product = section.settings.main_product
-%}

<section class="cth-hero" id="top">
  <div class="page-width cth-hero__grid">
    <div>
      <span class="cth-eyebrow">Coral-fleece pet sofa &middot; cats &amp; dogs</span>
      <h1>The cozy spot they <em>pick over your couch</em>.</h1>
      <p class="cth-lede">A cleaner sofa, a cozier pet, a home that still looks like yours - the plush pet sofa they choose over the couch.</p>
      <div class="cth-rate">
        {% render 'ct-stars' %}
        <span>4.9</span><span class="cth-muted">&middot; 13 reviews</span>
      </div>
      <div class="cth-actions">
        <a class="cth-btn cth-btn--primary" href="#product">Shop the Cozy Sofa</a>
        <a class="cth-btn cth-btn--ghost" href="#video">See it in action</a>
      </div>
      <div class="cth-swatches">
        <span>3 colorways</span>
        <i style="--swatch: var(--ct-swatch-coffee)" title="Coffee"></i>
        <i style="--swatch: var(--ct-swatch-grey)" title="Grey"></i>
        <i style="--swatch: var(--ct-swatch-black)" title="Black"></i>
      </div>
      <div class="cth-micro">
        <span>{% render 'ct-checkmark' %}Free US shipping over $50</span>
        <span>{% render 'ct-checkmark' %}30-night cozy trial</span>
        <span>{% render 'ct-checkmark' %}Machine washable</span>
      </div>
    </div>
    <div class="cth-imgslot cth-hero__img">
      <span class="cth-badge">Bestseller</span>
      {%- if section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 1000', sizes: '(max-width: 860px) 100vw, 48vw', class: 'cth-imgslot__img', alt: section.settings.hero_image.alt | default: main_product.title | escape }}
      {%- elsif main_product.featured_image != blank -%}
        {{ main_product.featured_image | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 1000', sizes: '(max-width: 860px) 100vw, 48vw', class: 'cth-imgslot__img', alt: main_product.featured_image.alt | default: main_product.title | escape }}
      {%- else -%}
        <span class="cth-ph">{% render 'ct-fa-icon', icon: 'paw' %}</span>
      {%- endif -%}
    </div>
  </div>

  <div class="cth-trust">
    <div class="page-width cth-trust__grid">
      <div class="cth-trust__item">
        {% render 'ct-icon-badge', icon: 'heart', tone: 'sage' %}
        <div><h3>Calming comfort</h3><p>Soft walls pets nuzzle into</p></div>
      </div>
      <div class="cth-trust__item">
        {% render 'ct-icon-badge', icon: 'clock', tone: 'clay' %}
        <div><h3>Joint support</h3><p>Cushioned base for old &amp; young</p></div>
      </div>
      <div class="cth-trust__item">
        {% render 'ct-icon-badge', icon: 'database', tone: 'teal' %}
        <div><h3>Machine washable</h3><p>The whole bed washes clean</p></div>
      </div>
      <div class="cth-trust__item">
        {% render 'ct-icon-badge', icon: 'house', tone: 'coffee' %}
        <div><h3>Non-slip base</h3><p>Helps it stay put</p></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CT home hero",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "product", "id": "main_product", "label": "Main product" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" }
  ],
  "presets": [{ "name": "CT home hero" }]
}
{% endschema %}
