{%- liquid
  assign addon_one = section.settings.addon_one
-%}

<section class="cth-bundle-wrap" id="bundle">
  <div class="page-width">
    <div class="cth-bundle">
      <div class="cth-bundle__copy">
        <span class="cth-eyebrow">Cleaner Couch Kit</span>
        <h2>Protect the whole couch.</h2>
        <p>Pair the sofa with the deshedding glove and ChompClean toy - everything to help keep loose fur and playtime off your furniture. Orders ship free at $50+, and any active discount is shown at checkout.</p>
        <a class="cth-btn cth-btn--primary" href="#shop-range">Build my Cleaner Couch Kit</a>
      </div>
      <div class="cth-bundle__media">
        {%- if section.settings.bundle_image != blank -%}
          {{ section.settings.bundle_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '480, 720, 900', sizes: '(max-width: 760px) 100vw, 42vw', class: 'cth-imgslot__img', alt: section.settings.bundle_image.alt | default: 'Cleaner Couch Kit' | escape }}
        {%- elsif addon_one.featured_image != blank -%}
          {{ addon_one.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '480, 720, 900', sizes: '(max-width: 760px) 100vw, 42vw', class: 'cth-imgslot__img', alt: addon_one.title | escape }}
        {%- else -%}
          <span class="cth-ph">{% render 'ct-fa-icon', icon: 'paw' %}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CT home bundle",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "product", "id": "addon_one", "label": "Fallback product" },
    { "type": "image_picker", "id": "bundle_image", "label": "Cleaner kit image" }
  ],
  "presets": [{ "name": "CT home bundle" }]
}
{% endschema %}
