{{ 'section-ct-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<footer class="ct-footer section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="ct-footer__grid">
      <div class="ct-footer__brand-col">
        <a href="{{ routes.root_url }}" class="ct-footer__logo" aria-label="CozyClaw home">
          {% render 'ct-logo',
            image: section.settings.footer_logo,
            class: 'ct-footer__logo-img',
            width: 180,
            sizes: '180px',
            fallback: 'cozyclaw-logo-reversed.svg'
          %}
        </a>
        <p>Founded to help pet parents make their dogs' and cats' everyday lives a little cozier &mdash; one well-made product at a time.</p>
        <address class="ct-footer__contact">
          <span>509 Byrum Rd, Chaparral, NM 88081, United States</span>
          <a href="mailto:support@cozyclaw.com">support@cozyclaw.com</a>
        </address>
      </div>

      <nav class="ct-footer__col" aria-label="Shop">
        <h5>Shop</h5>
        <ul>
          <li><a href="/products/cozy-plush-pet-sofa">Cozy Plush Pet Sofa</a></li>
          <li><a href="{{ routes.root_url }}#bundle">Bundle &amp; Save</a></li>
          <li><a href="{{ routes.root_url }}#reviews">Reviews</a></li>
          <li><a href="{{ routes.root_url }}#video">Why It Works</a></li>
          <li><a href="{{ blogs.news.url | default: '/blogs/news' }}">Blog</a></li>
        </ul>
      </nav>

      <nav class="ct-footer__col" aria-label="Help">
        <h5>Help</h5>
        <ul>
          <li>{% render 'ct-policy-link', policy: shop.shipping_policy, label: 'Shipping Policy', fallback_url: '/policies/shipping-policy' %}</li>
          <li>{% render 'ct-policy-link', policy: shop.refund_policy, label: 'Returns & 30-Night Guarantee', fallback_url: '/policies/refund-policy' %}</li>
          <li><a href="/pages/contact">Contact Us</a></li>
        </ul>
      </nav>

      <nav class="ct-footer__col" aria-label="Legal">
        <h5>Legal</h5>
        <ul>
          <li>{% render 'ct-policy-link', policy: shop.privacy_policy, label: 'Privacy Policy', fallback_url: '/policies/privacy-policy' %}</li>
          <li>{% render 'ct-policy-link', policy: shop.terms_of_service, label: 'Terms of Service', fallback_url: '/policies/terms-of-service' %}</li>
          <li>{% render 'ct-policy-link', policy: shop.refund_policy, label: 'Refund & Return Policy', fallback_url: '/policies/refund-policy' %}</li>
        </ul>
      </nav>
    </div>

    <div class="ct-footer__bottom">
      <span class="ct-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} CozyClaw<span class="ct-footer__tm">&#8482;</span>. All rights reserved.
      </span>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="ct-footer__pays list list-payment" role="list" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li class="list-payment__item">
              {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "CT footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer logo"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 54
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 30
    }
  ]
}
{% endschema %}
