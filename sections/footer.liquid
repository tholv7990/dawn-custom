{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}

{%- assign footer_email = section.settings.contact_email | strip -%}
{%- assign footer_phone = section.settings.contact_phone | strip -%}
{%- assign footer_address = section.settings.contact_address | strip -%}
{%- assign footer_address_link = section.settings.contact_address_link | default: '/pages/contact' -%}
{%- assign footer_logo = section.settings.logo | default: settings.logo -%}
{%- assign footer_logo_width = section.settings.logo_width | default: settings.logo_width | default: 170 -%}
{%- assign footer_logo_sizes = footer_logo_width | append: 'px' -%}
{%- assign footer_logo_style = 'width: ' | append: footer_logo_width | append: 'px' -%}
{%- assign footer_logo_alt = shop.name | default: 'Pollinook' | escape -%}

<footer class="gs-scope gs-foot" role="contentinfo">
  <div class="gs-wrap">
    <div class="gs-foot__cols">
      <div>
        <a class="gs-logo" href="{{ routes.root_url }}" aria-label="{{ footer_logo_alt }} home">
          {%- if footer_logo != blank -%}
            {{
              footer_logo
              | image_url: width: 340
              | image_tag:
                loading: 'lazy',
                widths: '120, 170, 220, 280, 340',
                sizes: footer_logo_sizes,
                alt: footer_logo_alt,
                style: footer_logo_style
            }}
          {%- else -%}
            <span class="gs-logo__text">Pollinook<sup>&trade;</sup></span>
          {%- endif -%}
        </a>
        <p class="gs-foot__blurb">Pollinator + nook, garden accents that bring color, birds and life to any outdoor space.</p>
      </div>
      <nav aria-label="Info">
        <h5>Info</h5>
        <ul>
          <li><a href="/blogs/news">Blog</a></li>
          <li><a href="/pages/contact">Contact</a></li>
          <li><a href="{{ routes.root_url }}#faq">FAQ</a></li>
          <li>{% render 'gs-policy-link', policy: shop.terms_of_service, label: 'Terms of service', fallback_url: '/policies/terms-of-service' %}</li>
        </ul>
      </nav>
      <nav aria-label="Customer service">
        <h5>Customer service</h5>
        <ul>
          <li>{% render 'gs-policy-link', policy: shop.privacy_policy, label: 'Privacy policy', fallback_url: '/policies/privacy-policy' %}</li>
          <li>{% render 'gs-policy-link', policy: shop.refund_policy, label: 'Returns & refunds', fallback_url: '/policies/refund-policy' %}</li>
          <li>{% render 'gs-policy-link', policy: shop.shipping_policy, label: 'Shipping & delivery', fallback_url: '/policies/shipping-policy' %}</li>
          <li><a href="/pages/order-tracking">Order tracking</a></li>
        </ul>
      </nav>
      <nav aria-label="Contact us">
        <h5>Contact us</h5>
        <ul>
          {%- if footer_email != blank -%}
            <li><a href="mailto:{{ footer_email | escape }}">{{ footer_email | escape }}</a></li>
          {%- endif -%}
          {%- if footer_phone != blank -%}
            <li><a href="tel:{{ footer_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | escape }}">{{ footer_phone | escape }}</a></li>
          {%- endif -%}
          {%- if footer_address != blank -%}
            <li><a href="{{ footer_address_link }}">{{ footer_address | escape }}</a></li>
          {%- endif -%}
        </ul>
      </nav>
    </div>

    <div class="gs-foot__region">
      <span>{{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})</span>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="list list-payment" role="list" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <span class="gs-pay">VISA</span><span class="gs-pay">MC</span><span class="gs-pay">AMEX</span><span class="gs-pay">PAYPAL</span><span class="gs-pay">SHOP PAY</span>
      {%- endif -%}
    </div>
    <p class="gs-foot__copy">&copy; {{ 'now' | date: '%Y' }} Pollinook&trade;. All rights reserved.</p>
  </div>
</footer>

{% schema %}
{
  "name": "GS footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 170
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "support@pollinook.site"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Contact phone",
      "default": "(214) 555-5937"
    },
    {
      "type": "textarea",
      "id": "contact_address",
      "label": "Contact address",
      "default": "7450 Hunnicut Rd, Dallas, TX 75227, United States"
    },
    {
      "type": "url",
      "id": "contact_address_link",
      "label": "Address link"
    }
  ]
}
{% endschema %}
