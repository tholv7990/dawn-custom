{%- liquid
  capture simple_free_shipping_threshold_raw
    render 'ct-reward-threshold', key: 'free_shipping'
  endcapture
  capture simple_discount_threshold_raw
    render 'ct-reward-threshold', key: 'discount'
  endcapture
  capture simple_reward_thresholds_configured_raw
    render 'ct-reward-threshold', key: 'configured'
  endcapture
  assign simple_free_shipping_threshold = simple_free_shipping_threshold_raw | strip | plus: 0
  assign simple_discount_threshold = simple_discount_threshold_raw | strip | plus: 0
  assign simple_reward_thresholds_configured = simple_reward_thresholds_configured_raw | strip
  assign reward_currency = cart.currency.iso_code | default: localization.country.currency.iso_code | default: shop.currency
  if settings.currency_code_enabled
    assign simple_free_shipping_threshold_money = simple_free_shipping_threshold | money_with_currency
    assign simple_discount_threshold_money = simple_discount_threshold | money_with_currency
  else
    assign simple_free_shipping_threshold_money = simple_free_shipping_threshold | money
    assign simple_discount_threshold_money = simple_discount_threshold | money
  endif
-%}

<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
>
  {{ 'ct-sections.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'section-ct-bundle-tiers.css' | asset_url | stylesheet_tag }}
  {{ 'section-ct-non-bundle-pdp.css' | asset_url | stylesheet_tag }}
  {%- unless product.has_only_default_variant -%}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {%- endunless -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'ct-bundle-tiers.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'ct-product-gallery.js' | asset_url }}" defer="defer"></script>

  {% render 'ct-section-padding', section: section %}

  {%- assign product_form_id = 'product-form-' | append: section.id -%}
  {%- assign short_description = product.metafields.custom.short_description -%}

  <div class="page-width">
    <div class="ct-non-bundle-pdp">
      <div class="ct-non-bundle-pdp__body" id="ProductInfo-{{ section.id }}">
        {%- if section.settings.eyebrow != blank -%}
          <div class="ct-non-bundle-pdp__eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        <h1 class="ct-non-bundle-pdp__title">{{ product.title }}</h1>

        {%- if short_description != blank and section.settings.show_short_description -%}
          <section class="ct-non-bundle-pdp__benefits" id="{{ section.settings.benefits_anchor | default: 'benefits' }}">
            <div class="ct-non-bundle-pdp__benefits-body rte">
              {{ short_description | metafield_tag }}
            </div>
          </section>
        {%- endif -%}

        {% render 'ct-product-gallery',
          product: product,
          wrapper_class: 'ct-non-bundle-pdp__media ct-non-bundle-pdp__media--mobile',
          carousel_class: 'ct-non-bundle-pdp__carousel',
          track_class: 'ct-non-bundle-pdp__track',
          slide_class: 'ct-non-bundle-pdp__slide',
          image_class: 'ct-non-bundle-pdp__img',
          dots_class: 'ct-non-bundle-pdp__dots',
          dot_class: 'ct-non-bundle-pdp__dot',
          arrow_class: 'ct-non-bundle-pdp__arrow',
          prev_class: 'ct-non-bundle-pdp__arrow--prev',
          next_class: 'ct-non-bundle-pdp__arrow--next',
          badge: section.settings.gallery_badge,
          badge_class: 'ct-non-bundle-pdp__gallery-badge',
          show_heart: true,
          heart_class: 'ct-non-bundle-pdp__heart'
        %}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when "@app" -%}
              <div class="ct-non-bundle-pdp__app" {{ block.shopify_attributes }}>
                {% render block %}
              </div>
            {%- when "price" -%}
              <div class="ct-non-bundle-pdp__price" id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                {%- render 'price', product: product, use_variant: true, show_badges: true, price_class: 'price--large' -%}
              </div>
            {%- when "variant_picker" -%}
              {%- comment -%}Variant selection is handled by the flexible order builder below.{%- endcomment -%}
            {%- when "quantity_selector" -%}
              {%- comment -%}Quantity is handled by the flexible order builder below.{%- endcomment -%}
            {%- when "buy_buttons" -%}
              <div
                class="ct-bundle-tiers ct-non-bundle-pdp__builder"
                data-ct-bundle-tiers
                data-discount-percent="{{ section.settings.automatic_discount_percent | default: 15 }}"
                data-free-shipping-threshold="{{ simple_free_shipping_threshold }}"
                data-discount-threshold="{{ simple_discount_threshold }}"
                data-rewards-configured="{{ simple_reward_thresholds_configured }}"
                data-reward-currency="{{ reward_currency }}"
                data-product-title="{{ product.title | escape }}"
              >
                {%- if simple_reward_thresholds_configured == 'true' -%}
                  <div class="ct-unlock-reward is-locked" data-bundle-unlock>
                    <p class="ct-unlock-reward__eyebrow">
                      <span class="ct-unlock-reward__check" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                          <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                      Cart rewards
                    </p>
                    <div class="ct-unlock-reward__bar-wrap">
                      <div class="ct-unlock-reward__track" aria-label="Reward progress">
                        <span class="ct-unlock-reward__fill" data-bundle-unlock-fill></span>
                      </div>
                      <div class="ct-unlock-reward__node" data-bundle-unlock-node="shipping" style="--ct-unlock-left:50%">
                        <span class="ct-unlock-reward__dot" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none">
                            <path d="M1 4h14v11H1z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                            <path d="M15 8h4l3 3v4h-7z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                            <circle cx="5.5" cy="18" r="1.7" stroke="currentColor" stroke-width="2"/>
                            <circle cx="17.5" cy="18" r="1.7" stroke="currentColor" stroke-width="2"/>
                          </svg>
                        </span>
                      </div>
                      <div class="ct-unlock-reward__node" data-bundle-unlock-node="discount" style="--ct-unlock-left:100%">
                        <span class="ct-unlock-reward__dot" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none">
                            <path d="M19 5 5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <circle cx="7.5" cy="7.5" r="2.3" stroke="currentColor" stroke-width="2"/>
                            <circle cx="16.5" cy="16.5" r="2.3" stroke="currentColor" stroke-width="2"/>
                          </svg>
                        </span>
                      </div>
                    </div>
                    <div class="ct-unlock-reward__milestones">
                      <span data-bundle-unlock-label="shipping" style="--ct-unlock-left:50%">
                        <b data-reward-money="{{ simple_free_shipping_threshold }}">{{ simple_free_shipping_threshold_money }}</b>
                        <small>Free shipping</small>
                      </span>
                      <span data-bundle-unlock-label="discount" style="--ct-unlock-left:100%">
                        <b data-reward-money="{{ simple_discount_threshold }}">{{ simple_discount_threshold_money }}</b>
                        <small>{{ section.settings.automatic_discount_percent | default: 15 }}% off</small>
                      </span>
                    </div>
                  </div>
                {%- else -%}
                  <div class="ct-unlock-reward ct-unlock-reward--pending">
                    <p class="ct-unlock-reward__eyebrow">
                      <span class="ct-unlock-reward__check" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                          <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                      Cart rewards
                    </p>
                    <p class="ct-unlock-reward__pending-text">Rewards are calculated at checkout for your market.</p>
                  </div>
                {%- endif -%}

                <div
                  class="ct-bundle-builder"
                  data-ct-bundle-builder
                  data-default-qty="{{ section.settings.default_quantity | default: 1 }}"
                  data-option-label="Option"
                  data-option-emoji=""
                >
                  <div class="ct-bundle-builder__head">
                    <div class="ct-bundle-builder__copy">
                      <h3 class="ct-bundle-builder__title">Build your order</h3>
                      <p class="ct-bundle-builder__meta" data-bundle-unit-price>
                        {%- if settings.currency_code_enabled -%}
                          {{ product.selected_or_first_available_variant.price | money_with_currency }} each
                        {%- else -%}
                          {{ product.selected_or_first_available_variant.price | money }} each
                        {%- endif -%}
                        {%- if simple_reward_thresholds_configured == 'true' -%}
                          - free shipping at {{ simple_free_shipping_threshold_money }}+
                        {%- else -%}
                          - rewards calculated at checkout
                        {%- endif -%}
                      </p>
                    </div>
                  </div>

                  <div class="ct-bundle-builder__add-row">
                    <span class="ct-bundle-builder__select-wrap">
                      <select class="ct-bundle-builder__select" data-bundle-picker aria-label="Choose product option">
                        {%- for variant in product.variants -%}
                          {%- assign variant_label = variant.title | replace: '60x80cm', '24 x 31 in' | replace: '80x90cm', '31 x 35 in' -%}
                          <option
                            value="{{ variant.id }}"
                            data-price="{{ variant.price }}"
                            data-compare="{{ variant.compare_at_price | default: 0 }}"
                            {% unless variant.available %}disabled{% endunless %}
                            {% if variant.id == product.selected_or_first_available_variant.id %}selected{% endif %}
                          >
                            {{- variant_label -}}
                            {%- unless variant.available %} - {{ 'products.product.sold_out' | t }}{% endunless -%}
                          </option>
                        {%- endfor -%}
                      </select>
                    </span>
                    <button type="button" class="ct-bundle-builder__add" data-bundle-add-variant>+ Add</button>
                  </div>

                  <div class="ct-bundle-builder__rows" data-bundle-bed-rows></div>

                  <select class="ct-bundle-builder__options-source" data-bundle-options-source hidden>
                    {%- for variant in product.variants -%}
                      {%- assign variant_label = variant.title | replace: '60x80cm', '24 x 31 in' | replace: '80x90cm', '31 x 35 in' -%}
                      <option
                        value="{{ variant.id }}"
                        data-price="{{ variant.price }}"
                        data-compare="{{ variant.compare_at_price | default: 0 }}"
                        {% unless variant.available %}disabled{% endunless %}
                        {% if variant.id == product.selected_or_first_available_variant.id %}selected{% endif %}
                      >
                        {{- variant_label -}}
                        {%- unless variant.available %} - {{ 'products.product.sold_out' | t }}{% endunless -%}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>

                <div class="ct-running-total" data-bundle-total-wrap>
                  <div class="ct-running-total__rows" data-bundle-total-rows></div>
                  <div class="ct-running-total__final">
                    <div class="ct-running-total__copy">
                      <span class="ct-running-total__label">Total today</span>
                      <span class="ct-running-total__discount" data-bundle-discount-note></span>
                    </div>
                    <div class="ct-running-total__amount">
                      <span class="ct-running-total__was" data-bundle-total-was hidden></span>
                      <strong class="ct-running-total__val" data-bundle-total>-</strong>
                    </div>
                  </div>
                </div>
              </div>
              <div class="ct-non-bundle-pdp__buy">
                {%- render 'buy-buttons',
                  block: block,
                  product: product,
                  product_form_id: product_form_id,
                  section_id: section.id,
                  show_pickup_availability: true
                -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      {% render 'ct-product-gallery',
        product: product,
        wrapper_class: 'ct-non-bundle-pdp__media ct-non-bundle-pdp__media--desktop',
        carousel_class: 'ct-non-bundle-pdp__carousel',
        track_class: 'ct-non-bundle-pdp__track',
        slide_class: 'ct-non-bundle-pdp__slide',
        image_class: 'ct-non-bundle-pdp__img',
        dots_class: 'ct-non-bundle-pdp__dots',
        dot_class: 'ct-non-bundle-pdp__dot',
        arrow_class: 'ct-non-bundle-pdp__arrow',
        prev_class: 'ct-non-bundle-pdp__arrow--prev',
        next_class: 'ct-non-bundle-pdp__arrow--next',
        badge: section.settings.gallery_badge,
        badge_class: 'ct-non-bundle-pdp__gallery-badge',
        show_heart: true,
        heart_class: 'ct-non-bundle-pdp__heart'
      %}
    </div>

    {%- if product.description != blank and section.settings.show_description -%}
      <section class="ct-non-bundle-pdp__details" id="{{ section.settings.details_anchor | default: 'description' }}">
        {%- if section.settings.description_heading != blank -%}
          <h2 class="ct-non-bundle-pdp__details-title">{{ section.settings.description_heading }}</h2>
        {%- endif -%}
        <div class="ct-non-bundle-pdp__details-body rte">{{ product.description }}</div>
      </section>
    {%- endif -%}
  </div>
</product-info>

{% schema %}
{
  "name": "CT Non-bundle PDP",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Grooming - for cats & dogs" },
    { "type": "text", "id": "gallery_badge", "label": "Gallery badge" },
    { "type": "checkbox", "id": "show_short_description", "label": "Show Short Description metafield", "default": true },
    { "type": "text", "id": "benefits_anchor", "label": "Benefits anchor ID", "default": "benefits" },
    { "type": "checkbox", "id": "show_description", "label": "Show product description", "default": true },
    { "type": "text", "id": "details_anchor", "label": "Details anchor ID", "default": "description" },
    { "type": "text", "id": "description_heading", "label": "Description heading", "default": "Product details" },
    { "type": "range", "id": "default_quantity", "label": "Default order quantity", "min": 1, "max": 12, "step": 1, "default": 1 },
    { "type": "range", "id": "automatic_discount_percent", "label": "Automatic discount percent", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 15 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "options": [
            { "value": "dropdown", "label": "Dropdown" },
            { "value": "button", "label": "Pills" }
          ],
          "default": "button",
          "label": "Picker type"
        },
        {
          "id": "swatch_shape",
          "label": "Swatch shape",
          "type": "select",
          "options": [
            { "value": "circle", "label": "Circle" },
            { "value": "square", "label": "Square" },
            { "value": "none", "label": "None" }
          ],
          "default": "circle"
        }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "Quantity selector",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true },
        { "type": "checkbox", "id": "show_gift_card_recipient", "label": "Show recipient information form for gift cards", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "CT Non-bundle PDP",
      "blocks": [
        { "type": "price" },
        { "type": "buy_buttons" }
      ]
    }
  ]
}
{% endschema %}
