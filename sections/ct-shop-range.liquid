{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-shop-range.css' | asset_url | stylesheet_tag }}

{% render 'ct-section-padding', section: section %}

{%- assign section_id = section.settings.anchor_id | default: section.id -%}

<section id="{{ section_id }}" class="ct-shop-range color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="ct-section-head ct-section-head--center">
      {%- if section.settings.kicker != blank -%}<span class="ct-eyebrow">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
    </div>

    <div class="ct-shop-range__grid">
      {%- for block in section.blocks -%}
        {%- assign card_product = block.settings.product -%}
        {%- assign card_image = block.settings.image -%}
        {%- if card_image == blank and card_product != blank -%}
          {%- assign card_image = card_product.featured_image -%}
        {%- endif -%}
        {%- assign card_url = block.settings.link -%}
        {%- if card_url == blank and card_product != blank -%}
          {%- assign card_url = card_product.url -%}
        {%- endif -%}
        {%- assign card_title = block.settings.title -%}
        {%- if card_title == blank and card_product != blank -%}
          {%- assign card_title = card_product.title -%}
        {%- endif -%}
        {%- assign card_price = block.settings.price_fallback -%}
        {%- if card_product != blank -%}
          {%- if settings.currency_code_enabled -%}
            {%- assign card_price = card_product.price_min | money_with_currency -%}
          {%- else -%}
            {%- assign card_price = card_product.price_min | money -%}
          {%- endif -%}
        {%- endif -%}

        <a class="ct-shop-range__card" href="{{ card_url | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="ct-shop-range__media">
            {%- if block.settings.badge != blank -%}<span class="ct-shop-range__badge">{{ block.settings.badge }}</span>{%- endif -%}
            {%- if card_image != blank -%}
              {{
                card_image
                | image_url: width: 700
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 480, 700',
                  sizes: '(max-width: 760px) 100vw, 31vw',
                  class: 'ct-shop-range__img',
                  alt: card_image.alt | default: card_title | escape
              }}
            {%- else -%}
              <span class="ct-shop-range__placeholder" aria-hidden="true">{%- render 'ct-fa-icon', icon: 'paw' -%}</span>
            {%- endif -%}
          </div>
          <div class="ct-shop-range__body">
            {%- if card_title != blank -%}<h3>{{ card_title }}</h3>{%- endif -%}
            {%- if block.settings.description != blank -%}<p>{{ block.settings.description }}</p>{%- endif -%}
            <div class="ct-shop-range__foot">
              {%- if card_price != blank -%}<span class="ct-shop-range__price">{{ card_price }}</span>{%- endif -%}
              {%- if block.settings.rating_text != blank -%}
                <span class="ct-shop-range__rating">{%- render 'ct-fa-icon', icon: 'star' -%} {{ block.settings.rating_text }}</span>
              {%- endif -%}
            </div>
            <span class="ct-shop-range__shop">{{ block.settings.cta_label }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CT shop range",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "range" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Shop the range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cozy on its own. Better together." },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "The sofa they curl up in, plus the everyday extras — grab any of them on their own, or pair them up."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "price_fallback", "label": "Price fallback" },
        { "type": "text", "id": "rating_text", "label": "Rating text" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop →" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CT shop range",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
