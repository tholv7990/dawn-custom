{% render 'ct-section-padding', section: section %}

<section class="gs-scope ct-size-chart section-{{ section.id }}-padding">
  <div class="gs-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="gs-section-heading">
        {% render 'ct-icon', name: 'ruler', class: 'ct-size-chart__icon' %}
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="ct-size-chart__intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}

    <div class="ct-size-chart__scroll" tabindex="0" role="region" aria-label="{{ section.settings.heading | escape }}">
      <table class="ct-size-chart__table">
        <thead>
          <tr>
            <th scope="col">{{ section.settings.row_head | escape }}</th>
            <th scope="col">{{ section.settings.col1_head | escape }}</th>
            <th scope="col">{{ section.settings.col2_head | escape }}</th>
            <th scope="col">{{ section.settings.col3_head | escape }}</th>
            <th scope="col">{{ section.settings.col4_head | escape }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label | escape }}</th>
              <td>{{ block.settings.col1 | escape }}</td>
              <td>{{ block.settings.col2 | escape }}</td>
              <td>{{ block.settings.col3 | escape }}</td>
              <td>{{ block.settings.col4 | escape }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if section.settings.note != blank -%}
      <p class="ct-size-chart__note">
        {% render 'ct-icon', name: 'info', class: 'ct-size-chart__note-icon' %}
        <span>{{ section.settings.note | escape }}</span>
      </p>
    {%- endif -%}
  </div>
</section>

{% style %}
  .ct-size-chart .gs-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--ct-space-5);
  }

  .ct-size-chart .gs-section-heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--ct-space-3);
  }

  .ct-size-chart__icon {
    display: inline-flex;
    width: 28px;
    height: 28px;
    color: var(--ct-action);
  }

  .ct-size-chart__icon svg {
    width: 100%;
    height: 100%;
  }

  .ct-size-chart__intro {
    margin: 0;
    max-width: 60ch;
    color: var(--ct-text-2);
    font-size: var(--ct-body-size);
    line-height: var(--ct-leading-loose);
  }

  .ct-size-chart__scroll {
    overflow-x: auto;
    border: 1px solid var(--ct-card-border);
    border-radius: var(--ct-r-lg);
    background-color: var(--ct-card-bg);
    box-shadow: var(--ct-shadow-sm);
    -webkit-overflow-scrolling: touch;
  }

  .ct-size-chart__scroll:focus-visible {
    outline: 2px solid var(--ct-action);
    outline-offset: 2px;
  }

  .ct-size-chart__table {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    font-size: var(--ct-text-sm);
  }

  .ct-size-chart__table th,
  .ct-size-chart__table td {
    padding: var(--ct-space-3) var(--ct-space-4);
    text-align: center;
    border-bottom: 1px solid var(--ct-border);
    white-space: nowrap;
  }

  .ct-size-chart__table thead th {
    color: var(--ct-on-accent);
    background-color: var(--ct-action);
    font-weight: var(--ct-fw-semi);
    font-size: var(--ct-text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ct-size-chart__table tbody th[scope='row'] {
    text-align: left;
    color: var(--ct-text);
    background-color: var(--ct-action-tint);
    font-weight: var(--ct-fw-semi);
  }

  .ct-size-chart__table tbody td {
    color: var(--ct-text-2);
    font-weight: var(--ct-fw-normal);
  }

  .ct-size-chart__table tbody tr:last-child th,
  .ct-size-chart__table tbody tr:last-child td {
    border-bottom: 0;
  }

  .ct-size-chart__table tbody tr:nth-child(even) td {
    background-color: var(--ct-bg-surface);
  }

  .ct-size-chart__note {
    display: flex;
    align-items: flex-start;
    gap: var(--ct-space-2);
    margin: 0;
    color: var(--ct-text-3);
    font-size: var(--ct-text-sm);
    line-height: var(--ct-leading-base);
  }

  .ct-size-chart__note-icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    color: var(--ct-text-3);
  }

  .ct-size-chart__note-icon svg {
    width: 100%;
    height: 100%;
  }
{% endstyle %}

{% schema %}
{
  "name": "Size guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Size guide"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Use the measurements below to find your best fit. Sizes are approximate and may vary slightly between styles."
    },
    {
      "type": "header",
      "content": "Column headers"
    },
    {
      "type": "text",
      "id": "row_head",
      "label": "Row label header",
      "default": "Size"
    },
    {
      "type": "text",
      "id": "col1_head",
      "label": "Column 1 header",
      "default": "Chest"
    },
    {
      "type": "text",
      "id": "col2_head",
      "label": "Column 2 header",
      "default": "Waist"
    },
    {
      "type": "text",
      "id": "col3_head",
      "label": "Column 3 header",
      "default": "Hips"
    },
    {
      "type": "text",
      "id": "col4_head",
      "label": "Column 4 header",
      "default": "Length"
    },
    {
      "type": "header",
      "content": "Footnote"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": "Measurements are listed in inches. When between sizes, we recommend sizing up."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "Size"
        },
        {
          "type": "text",
          "id": "col1",
          "label": "Column 1",
          "default": "S"
        },
        {
          "type": "text",
          "id": "col2",
          "label": "Column 2",
          "default": "M"
        },
        {
          "type": "text",
          "id": "col3",
          "label": "Column 3",
          "default": "L"
        },
        {
          "type": "text",
          "id": "col4",
          "label": "Column 4",
          "default": "XL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Size guide",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "label": "Small",
            "col1": "34\"",
            "col2": "28\"",
            "col3": "36\"",
            "col4": "27\""
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Medium",
            "col1": "38\"",
            "col2": "32\"",
            "col3": "40\"",
            "col4": "28\""
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Large",
            "col1": "42\"",
            "col2": "36\"",
            "col3": "44\"",
            "col4": "29\""
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "X-Large",
            "col1": "46\"",
            "col2": "40\"",
            "col3": "48\"",
            "col4": "30\""
          }
        }
      ]
    }
  ]
}
{% endschema %}
