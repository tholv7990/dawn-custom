{% render 'ct-section-padding', section: section %}

{%- liquid
  assign heading = section.settings.heading
  assign placeholder = section.settings.placeholder
  assign button_label = section.settings.button_label
  assign saved_text = section.settings.saved_text
  assign note_id = 'ct-cart-note-input-' | append: section.id
  assign status_id = 'ct-cart-note-status-' | append: section.id
-%}

<section
  class="ct-cart-note gs-scope section-{{ section.id }}-padding"
  id="ct-cart-note-{{ section.id }}"
  data-saved-text="{{ saved_text | escape }}"
>
  <div class="gs-wrap">
    <div class="ct-cart-note__card">
      {%- if heading != blank -%}
        <label class="ct-cart-note__heading" for="{{ note_id }}">
          {% render 'ct-icon', name: 'chat' %}
          <span>{{ heading | escape }}</span>
        </label>
      {%- endif -%}

      <textarea
        class="ct-cart-note__field"
        id="{{ note_id }}"
        name="note"
        rows="4"
        placeholder="{{ placeholder | escape }}"
        data-cart-note-input
      >{{ cart.note }}</textarea>

      <div class="ct-cart-note__actions">
        <button type="button" class="ct-cart-note__button" data-cart-note-save>
          {{ button_label | escape }}
        </button>
        <p class="ct-cart-note__status" id="{{ status_id }}" role="status" aria-live="polite" data-cart-note-status></p>
      </div>
    </div>
  </div>
</section>

{% style %}
  .ct-cart-note .ct-cart-note__card {
    display: flex;
    flex-direction: column;
    gap: var(--ct-space-3);
    padding: var(--ct-pad-tight);
    background: var(--ct-card-bg);
    border: 1px solid var(--ct-card-border);
    border-radius: var(--ct-r-lg);
    box-shadow: var(--ct-shadow-sm);
  }

  .ct-cart-note .ct-cart-note__heading {
    display: flex;
    align-items: center;
    gap: var(--ct-space-2);
    margin: 0;
    color: var(--ct-text);
    font-size: var(--ct-text-base);
    font-weight: var(--ct-fw-semi);
    line-height: 1.3;
  }

  .ct-cart-note .ct-cart-note__heading .ct-icon {
    display: inline-flex;
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--ct-action);
  }

  .ct-cart-note .ct-cart-note__heading .ct-icon svg {
    width: 100%;
    height: 100%;
  }

  .ct-cart-note .ct-cart-note__field {
    display: block;
    width: 100%;
    min-height: 96px;
    margin: 0;
    padding: var(--ct-space-3);
    color: var(--ct-text);
    font-family: inherit;
    font-size: var(--ct-text-sm);
    font-weight: var(--ct-fw-normal);
    line-height: 1.5;
    background: var(--ct-bg-control);
    border: 1px solid var(--ct-border);
    border-radius: var(--ct-r-md);
    resize: vertical;
    transition: border-color var(--ct-dur-base) var(--ct-ease-out);
  }

  .ct-cart-note .ct-cart-note__field::placeholder {
    color: var(--ct-text-3);
  }

  .ct-cart-note .ct-cart-note__field:focus {
    outline: none;
    border-color: var(--ct-action-border);
    box-shadow: var(--ct-ring);
  }

  .ct-cart-note .ct-cart-note__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ct-space-3);
  }

  .ct-cart-note .ct-cart-note__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--ct-space-2) var(--ct-space-5);
    color: var(--ct-on-accent);
    font-family: inherit;
    font-size: var(--ct-text-sm);
    font-weight: var(--ct-fw-semi);
    line-height: 1.2;
    background: var(--ct-action);
    border: 1px solid var(--ct-action-border);
    border-radius: var(--ct-r-pill);
    cursor: pointer;
    transition: background var(--ct-dur-base) var(--ct-ease-out);
  }

  .ct-cart-note .ct-cart-note__button:hover {
    background: var(--ct-action-hover);
  }

  .ct-cart-note .ct-cart-note__button:focus-visible {
    outline: none;
    box-shadow: var(--ct-ring);
  }

  .ct-cart-note .ct-cart-note__button[disabled] {
    opacity: 0.65;
    cursor: default;
  }

  .ct-cart-note .ct-cart-note__status {
    margin: 0;
    color: var(--ct-success);
    font-size: var(--ct-text-sm);
    font-weight: var(--ct-fw-medium);
    line-height: 1.4;
  }

  .ct-cart-note .ct-cart-note__status[data-state='error'] {
    color: var(--ct-text-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .ct-cart-note .ct-cart-note__field,
    .ct-cart-note .ct-cart-note__button {
      transition: none;
    }
  }
{% endstyle %}

<script>
  (function () {
    var root = document.getElementById('ct-cart-note-{{ section.id }}');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    var input = root.querySelector('[data-cart-note-input]');
    var button = root.querySelector('[data-cart-note-save]');
    var status = root.querySelector('[data-cart-note-status]');
    if (!input || !button) return;

    var savedText = root.getAttribute('data-saved-text') || '';
    var reduceMotion = false;
    try {
      reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch (e) {
      reduceMotion = false;
    }

    function updateUrl() {
      var routes = window.Shopify && window.Shopify.routes;
      var rootPath = (routes && routes.root) || '/';
      return rootPath + 'cart/update.js';
    }

    function setStatus(message, state) {
      if (!status) return;
      if (state === 'error') {
        status.setAttribute('data-state', 'error');
      } else {
        status.removeAttribute('data-state');
      }
      status.textContent = message;
    }

    function save() {
      if (button.disabled) return;
      button.disabled = true;
      setStatus('', 'busy');

      try {
        fetch(updateUrl(), {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          },
          body: JSON.stringify({ note: input.value })
        })
          .then(function (res) {
            if (!res.ok) throw new Error('Request failed');
            return res.json();
          })
          .then(function () {
            setStatus(savedText, 'ok');
            if (window.publish && window.PUB_SUB_EVENTS && window.PUB_SUB_EVENTS.cartUpdate) {
              try {
                window.publish(window.PUB_SUB_EVENTS.cartUpdate, { source: 'ct-cart-note' });
              } catch (e) {
                /* no-op */
              }
            }
          })
          .catch(function () {
            setStatus("Couldn't save your note. Please try again.", 'error');
          })
          .then(function () {
            button.disabled = false;
          });
      } catch (e) {
        button.disabled = false;
        setStatus("Couldn't save your note. Please try again.", 'error');
      }
    }

    button.addEventListener('click', save);
  })();
</script>

{% schema %}
{
  "name": "Cart note",
  "settings": [
    {
      "type": "paragraph",
      "content": "Lets shoppers leave order instructions. Saves to the cart note on click."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Order note"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "Add a note to your order"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Save note"
    },
    {
      "type": "text",
      "id": "saved_text",
      "label": "Saved confirmation",
      "default": "Note saved."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Cart note"
    }
  ]
}
{% endschema %}
