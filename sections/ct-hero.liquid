{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-hero.css' | asset_url | stylesheet_tag }}

{% render 'ct-section-padding', section: section %}

{%- assign section_id = section.settings.anchor_id | default: section.id -%}

{%- comment -%}
  Live product binding: when section.settings.product is picked, the price
  row and availability auto-bind to Shopify product data (price, compare_at,
  computed save %, in-stock from variant.available). Hardcoded text settings
  fall back through when no product is picked. heading also defaults to
  product.title when a product is picked and the editor has not overridden
  the heading.
{%- endcomment -%}
{%- assign hero_product = section.settings.product -%}
{%- assign hero_heading = section.settings.heading -%}
{%- assign hero_price_now = section.settings.price_now -%}
{%- assign hero_price_was = section.settings.price_was -%}
{%- assign hero_price_save = section.settings.price_save_label -%}
{%- assign hero_avail = section.settings.availability_text -%}
{%- assign hero_btn_link = section.settings.button_link -%}
{%- if hero_product != blank -%}
  {%- if hero_heading == blank -%}{%- assign hero_heading = hero_product.title -%}{%- endif -%}
  {%- if settings.currency_code_enabled -%}
    {%- assign hero_price_now = hero_product.price | money_with_currency -%}
  {%- else -%}
    {%- assign hero_price_now = hero_product.price | money -%}
  {%- endif -%}
  {%- if hero_product.compare_at_price > hero_product.price -%}
    {%- if settings.currency_code_enabled -%}
      {%- assign hero_price_was = hero_product.compare_at_price | money_with_currency -%}
    {%- else -%}
      {%- assign hero_price_was = hero_product.compare_at_price | money -%}
    {%- endif -%}
    {%- assign save_pct = hero_product.compare_at_price | minus: hero_product.price | times: 100 | divided_by: hero_product.compare_at_price -%}
    {%- assign hero_price_save = save_pct | append: '%' | prepend: 'Save ' -%}
  {%- else -%}
    {%- assign hero_price_was = blank -%}
    {%- assign hero_price_save = blank -%}
  {%- endif -%}
  {%- if hero_product.available == false -%}{%- assign hero_avail = 'Sold out' -%}{%- endif -%}
  {%- if hero_btn_link == blank -%}{%- assign hero_btn_link = hero_product.url -%}{%- endif -%}
{%- endif -%}

{%- if section.settings.layout == 'image-card' -%}
  {%- assign hero_img = section.settings.hero_image -%}
  {%- if hero_img == blank and hero_product != blank -%}
    {%- assign hero_img = hero_product.featured_image -%}
  {%- endif -%}
  <section class="ct-hero-card color-{{ section.settings.color_scheme }}" id="{{ section_id }}">
    <div class="page-width ct-hero-card__grid">
      <div class="ct-hero-card__copy">
        {%- if section.settings.eyebrow != blank -%}<span class="ct-hero-card__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h1 class="ct-hero-card__h1">
          {{ hero_heading }}{% if section.settings.h1_em != blank %} <em>{{ section.settings.h1_em }}</em>{% endif %}
        </h1>
        {%- if section.settings.subheading != blank -%}<p class="ct-hero-card__sub">{{ section.settings.subheading }}</p>{%- endif -%}
        {%- if section.settings.rating_text != blank -%}
          <div class="ct-rating-row ct-hero-card__rating">
            <span class="ct-stars" aria-hidden="true">★★★★★</span>
            <span class="ct-rating-count">{{ section.settings.rating_text }}</span>
          </div>
        {%- endif -%}
        <div class="ct-hero-card__cta">
          {%- if section.settings.button_label != blank -%}<a href="{{ hero_btn_link | default: '#' }}" class="ct-btn ct-btn--primary">{{ section.settings.button_label }}</a>{%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}<a href="{{ section.settings.button_link_2 | default: '#' }}" class="ct-btn ct-btn--outlined">{{ section.settings.button_label_2 }}</a>{%- endif -%}
        </div>
        <div class="ct-hero-card__swatches" aria-label="Available colors">
          <span class="ct-hero-card__swatch-label">Coffee · Grey · Black</span>
          <span class="ct-hero-card__swatch" style="--swatch: var(--ct-swatch-coffee)" title="Coffee"></span>
          <span class="ct-hero-card__swatch" style="--swatch: var(--ct-swatch-grey)" title="Grey"></span>
          <span class="ct-hero-card__swatch" style="--swatch: var(--ct-swatch-black)" title="Black"></span>
        </div>
        {%- if section.settings.trust_line != blank -%}
          <div class="ct-hero-card__micro">
            {%- assign trust_parts = section.settings.trust_line | split: '|' -%}
            {%- for part in trust_parts -%}
              {%- assign trust_text = part | strip -%}
              {%- if trust_text != blank -%}
                <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>{{ trust_text }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <div class="ct-hero-card__media">
        <span class="ct-hero-card__badge">Bestseller</span>
        {%- if hero_img != blank -%}
          {{
            hero_img
            | image_url: width: 1000
            | image_tag:
              class: 'ct-hero-card__img',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '480, 720, 1000',
              sizes: '(max-width: 860px) 100vw, 48vw',
              alt: hero_img.alt | default: hero_product.title | default: 'CozyClaw pet sofa' | escape
          }}
        {%- else -%}
          <span class="ct-hero-card__placeholder" aria-hidden="true">{%- render 'ct-fa-icon', icon: 'paw' -%}</span>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- elsif section.settings.layout == 'split-photo' -%}
  {%- assign hero_img = section.settings.hero_image -%}
  {%- if hero_img == blank and hero_product != blank -%}
    {%- assign hero_img = hero_product.featured_image -%}
  {%- endif -%}
  <section class="ct-hero-split color-{{ section.settings.color_scheme }}" id="{{ section_id }}">
    {%- if hero_img != blank -%}
      {%- assign hero_img_alt = hero_img.alt | default: hero_product.title | default: 'CozyClaw™' | escape -%}
      {{
        hero_img
        | image_url: width: 1600
        | image_tag:
          class: 'ct-hero-split__photo',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '640, 900, 1200, 1600',
          sizes: '(max-width: 749px) 100vw, 56vw',
          alt: hero_img_alt
      }}
    {%- endif -%}
    <div class="ct-hero-split__text">
      {%- if section.settings.eyebrow != blank -%}<span class="ct-hero-split__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 class="ct-hero-split__h1">{{ hero_heading }}{% if section.settings.h1_em != blank %}<br><em>{{ section.settings.h1_em }}</em>{% endif %}</h1>
      {%- if section.settings.subheading != blank -%}<p class="ct-hero-split__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      <div class="ct-hero-split__cta">
        {%- if section.settings.button_label != blank -%}<a href="{{ hero_btn_link | default: '#' }}" class="ct-btn ct-btn--primary">{{ section.settings.button_label }}</a>{%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}<a href="{{ section.settings.button_link_2 | default: '#' }}" class="ct-btn ct-btn--outlined">{{ section.settings.button_label_2 }}</a>{%- endif -%}
      </div>
      {%- if section.settings.trust_line != blank -%}
        <div class="ct-hero-split__trust">
          {%- assign trust_parts = section.settings.trust_line | split: '|' -%}
          {%- for part in trust_parts -%}
            {%- assign trust_text = part | strip -%}
            <span class="ct-hero-split__trust-item">
              {%- if trust_text contains '★★★★★' -%}
                <span class="ct-stars" aria-hidden="true">★★★★★</span>{{ trust_text | remove_first: '★★★★★' | strip }}
              {%- else -%}
                {{ trust_text }}
              {%- endif -%}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- else -%}
  <div id="{{ section_id }}" class="page-width section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
    <div class="ct-hero" data-reveal>
      <div class="ct-hero-inner">
        <div class="ct-hero-text">
          {%- if section.settings.sale_badge != blank -%}
            <span class="ct-hero-sale-badge">{{ section.settings.sale_badge }}</span>
          {%- endif -%}
          {%- if section.settings.eyebrow != blank -%}
            <div class="ct-eyebrow"><span class="ct-eyebrow__dot"></span>{{ section.settings.eyebrow }}</div>
          {%- endif -%}
          {%- if hero_heading != blank -%}
            <h1 class="ct-hero-h1">{{ hero_heading }}</h1>
          {%- endif -%}
          {%- if section.settings.h1_subtitle != blank -%}
            <div class="ct-hero-h1-sub">{{ section.settings.h1_subtitle }}</div>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="ct-hero-sub">{{ section.settings.subheading }}</p>
          {%- endif -%}
          {%- if section.settings.show_rating -%}
            <div class="ct-rating-row ct-hero-rating">
              <span class="ct-stars">★★★★★</span>
              <span class="ct-rating-count">{{ section.settings.rating_text }}</span>
            </div>
          {%- endif -%}
          {%- if hero_price_now != blank -%}
            <div class="ct-hero-price-row">
              <span class="ct-hero-price-now">{{ hero_price_now }}</span>
              {%- if hero_price_was != blank -%}<span class="ct-hero-price-was">{{ hero_price_was }}</span>{%- endif -%}
              {%- if hero_price_save != blank -%}<span class="ct-hero-price-save">{{ hero_price_save }}</span>{%- endif -%}
            </div>
          {%- endif -%}
          {%- if hero_avail != blank -%}
            <div class="ct-hero-avail"><span class="ct-hero-avail__dot" aria-hidden="true"></span>{{ hero_avail }}</div>
          {%- endif -%}
          <div class="ct-hero-btns">
            {%- if section.settings.button_label != blank -%}
              <a class="ct-btn ct-btn--primary ct-btn--lg" href="{{ hero_btn_link | default: '#' }}">{{ section.settings.button_label }}</a>
            {%- endif -%}
            {%- if section.settings.button_label_2 != blank -%}
              <a class="ct-btn ct-btn--outlined" href="{{ section.settings.button_link_2 | default: '#' }}">{{ section.settings.button_label_2 }}</a>
            {%- endif -%}
          </div>
          {%- assign pill_blocks = section.blocks | where: 'type', 'pill' -%}
          {%- if pill_blocks.size > 0 -%}
            <div class="ct-hero-pills">
              {%- for block in pill_blocks -%}
                <span class="ct-hero-pill" {{ block.shopify_attributes }}><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>{{ block.settings.text }}</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
        {%- assign hero_alt = section.settings.heading | default: '' | strip_html -%}
        <div class="ct-hero-visual">
          {%- if section.settings.image != blank -%}
            <div class="ct-hero-product-card">
              {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 900', sizes: '(max-width: 749px) 100vw, 45vw', class: 'ct-hero-product-card__img', alt: hero_alt }}
            </div>
          {%- elsif section.settings.card_emoji != blank -%}
            <div class="ct-hero-product-card">
              <div class="ct-hero-product-card__emoji" aria-hidden="true">{{ section.settings.card_emoji }}</div>
            </div>
          {%- endif -%}
          {%- assign thumb_blocks = section.blocks | where: 'type', 'thumb' -%}
          {%- if thumb_blocks.size > 0 -%}
            <div class="ct-hero-gallery">
              {%- for block in thumb_blocks -%}
                <div class="ct-hero-thumb{% if block.settings.is_primary %} ct-hero-thumb--primary{% endif %}" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'ct-hero-thumb__img', alt: '' }}
                  {%- else -%}
                    <span aria-hidden="true">{{ block.settings.emoji | default: '🐈' }}</span>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if section.settings.float_value != blank -%}
            <div class="ct-hero-float">
              {%- if section.settings.float_icon != blank -%}<div class="ct-hero-float__icon">{{ section.settings.float_icon }}</div>{%- endif -%}
              <div>
                {%- if section.settings.float_label != blank -%}<div class="ct-hero-float__label">{{ section.settings.float_label }}</div>{%- endif -%}
                <div class="ct-hero-float__val">{{ section.settings.float_value }}</div>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "CT Hero",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "sale_badge", "label": "Sale badge (urgency-red pill)", "info": "e.g. 🔥 2,175 sold. Renders above h1. Leave blank to hide." },
    { "type": "text", "id": "anchor_id", "label": "Anchor id (e.g. \"buy\")" },
    { "type": "product", "id": "product", "label": "Product (for dynamic source binding)", "info": "Pick the hero product so price / availability fields can be connected to live Shopify data via the chain-link 'Connect dynamic source' icon next to each field." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New for 2025 — Pro Series" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Hero headline — emotional hook", "info": "Wrap a word in <em> for the green accent." },
    { "type": "text", "id": "h1_subtitle", "label": "Heading subtitle (second line)" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "One sentence that explains what the product does and who it's for. 17–20 words max." },
    { "type": "header", "content": "Rating" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating row", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.9 · 10,000+ customers" },
    { "type": "header", "content": "Price + availability" },
    { "type": "text", "id": "price_now", "label": "Current price" },
    { "type": "text", "id": "price_was", "label": "Compare-at price (struck)" },
    { "type": "text", "id": "price_save_label", "label": "Save chip (e.g. Save 20%)" },
    { "type": "text", "id": "availability_text", "label": "Availability line", "info": "e.g. In stock — ships in 3–7 business days. Leave blank to hide." },
    { "type": "header", "content": "Floating badge" },
    { "type": "text", "id": "float_icon", "label": "Badge icon (emoji)", "default": "⚖️" },
    { "type": "text", "id": "float_label", "label": "Badge label" },
    { "type": "text", "id": "float_value", "label": "Badge value", "info": "Leave blank to hide the floating badge." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop now →" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "See how it works" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    { "type": "header", "content": "Visual" },
    { "type": "image_picker", "id": "image", "label": "Hero image", "info": "If set, replaces the floating card." },
    { "type": "text", "id": "card_emoji", "label": "Card emoji", "default": "💪" },
    { "type": "text", "id": "card_title", "label": "Card product name", "default": "Product name" },
    { "type": "text", "id": "card_price", "label": "Card price" },
    { "type": "text", "id": "card_tag_1", "label": "Card tag 1", "default": "★ 4.9" },
    { "type": "text", "id": "card_tag_2", "label": "Card tag 2", "default": "Ships today" },
    { "type": "header", "content": "Section" },
    { "type": "select", "id": "layout", "label": "Layout",
      "options": [
        { "value": "buy-box",     "label": "Buy box (PDP-style — default)" },
        { "value": "image-card",  "label": "Image card (homepage HTML)" },
        { "value": "split-photo", "label": "Split text + masked photo (homepage)" }
      ],
      "default": "buy-box" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero photo (homepage layouts)",
      "info": "Falls back to product.featured_image when blank and a product is picked." },
    { "type": "text", "id": "h1_em", "label": "H1 italic span (homepage layouts)",
      "info": "Rendered as <em> inside the H1 heading." },
    { "type": "text", "id": "trust_line", "label": "Trust line (homepage layouts)",
      "info": "Use '|' as a separator between items, e.g. '★★★★★ 4.9/5 · 13 reviews | ✓ 30-night trial | ✓ Free shipping at $50+'." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    { "type": "pill", "name": "Feature pill", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Feature" } ] },
    { "type": "thumb", "name": "Hero gallery thumb", "settings": [
      { "type": "text", "id": "emoji", "label": "Emoji (fallback)", "default": "🐈" },
      { "type": "image_picker", "id": "image", "label": "Thumb image (optional)" },
      { "type": "checkbox", "id": "is_primary", "label": "Primary thumb (accent border)", "default": false }
    ] }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "CT Hero",
      "blocks": [
        { "type": "pill", "settings": { "text": "Feature 1" } },
        { "type": "pill", "settings": { "text": "Feature 2" } },
        { "type": "pill", "settings": { "text": "Free shipping" } }
      ]
    }
  ]
}
{% endschema %}
