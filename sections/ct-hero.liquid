{% render 'ct-section-padding', section: section %}

{%- liquid
  assign align = section.settings.content_alignment | default: 'center'
  assign height = section.settings.min_height | default: 'medium'
  assign overlay = section.settings.overlay_opacity | default: 30
  assign overlay_alpha = overlay | times: 0.01
  assign has_media = false
  if section.settings.image != blank or section.settings.video != blank
    assign has_media = true
  endif
-%}

<section
  class="gs-scope ct-hero ct-hero--{{ height }} ct-hero--align-{{ align }} section-{{ section.id }}-padding{% unless has_media %} ct-hero--no-media{% endunless %}"
  style="--ct-hero-overlay: {{ overlay_alpha }};"
>
  {%- if has_media -%}
    <div class="ct-hero__media" aria-hidden="true">
      {% render 'ct-media-slot',
        image: section.settings.image,
        video: section.settings.video,
        class: 'ct-hero__slot',
        label: section.settings.heading
      %}
      <div class="ct-hero__overlay"></div>
    </div>
  {%- endif -%}

  <div class="ct-hero__inner">
    <div class="ct-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ct-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="gs-section-heading ct-hero__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="ct-hero__sub">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
        <div class="ct-hero__actions">
          {%- if section.settings.button_label != blank -%}
            <a
              class="ct-hero__btn ct-hero__btn--primary"
              {% if section.settings.button_url != blank %}href="{{ section.settings.button_url }}"{% else %}role="link" aria-disabled="true"{% endif %}
            >{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.button2_label != blank -%}
            <a
              class="ct-hero__btn ct-hero__btn--secondary"
              {% if section.settings.button2_url != blank %}href="{{ section.settings.button2_url }}"{% else %}role="link" aria-disabled="true"{% endif %}
            >{{ section.settings.button2_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .ct-hero {
    position: relative;
    display: grid;
    isolation: isolate;
    overflow: hidden;
    background: var(--ct-bg-surface);
    color: var(--ct-on-accent);
  }

  /* No background media: render copy directly on the surface with readable dark text. */
  .ct-hero--no-media {
    color: var(--ct-text);
  }

  .ct-hero--no-media .ct-hero__eyebrow {
    color: var(--ct-text-2);
  }

  .ct-hero--no-media .ct-hero__heading,
  .ct-hero--no-media .ct-hero__sub {
    color: var(--ct-text);
  }

  .ct-hero--no-media .ct-hero__btn--secondary {
    color: var(--ct-text);
    border-color: var(--ct-text);
  }

  .ct-hero--no-media .ct-hero__btn--secondary:hover {
    background: var(--ct-bg-raised);
  }

  .ct-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .ct-hero__slot {
    width: 100%;
    height: 100%;
    border-radius: 0;
  }

  .ct-hero__slot img,
  .ct-hero__slot video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ct-hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--ct-overlay-bg);
    opacity: var(--ct-hero-overlay, 0.3);
  }

  .ct-hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--ct-mw);
    margin-inline: auto;
    padding-inline: var(--ct-space-6);
    display: flex;
    align-items: center;
  }

  .ct-hero--small .ct-hero__inner {
    min-height: 320px;
  }

  .ct-hero--medium .ct-hero__inner {
    min-height: 480px;
  }

  .ct-hero--large .ct-hero__inner {
    min-height: 640px;
  }

  .ct-hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--ct-space-4);
    max-width: 640px;
  }

  .ct-hero--align-left .ct-hero__inner {
    justify-content: flex-start;
  }

  .ct-hero--align-center .ct-hero__inner {
    justify-content: center;
  }

  .ct-hero--align-center .ct-hero__content {
    text-align: center;
    align-items: center;
    margin-inline: auto;
  }

  .ct-hero--align-right .ct-hero__inner {
    justify-content: flex-end;
  }

  .ct-hero--align-right .ct-hero__content {
    text-align: right;
    align-items: flex-end;
  }

  .ct-hero__eyebrow {
    margin: 0;
    font-size: var(--ct-text-sm);
    font-weight: var(--ct-fw-semi);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ct-on-accent);
  }

  .ct-hero__heading {
    margin: 0;
    color: var(--ct-on-accent);
    font-size: var(--ct-h1);
    line-height: var(--ct-leading-tight);
  }

  .ct-hero__sub {
    margin: 0;
    font-size: var(--ct-text-lg);
    line-height: var(--ct-leading-base);
    color: var(--ct-on-accent);
    max-width: 52ch;
  }

  .ct-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ct-space-3);
    margin-top: var(--ct-space-2);
  }

  .ct-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--ct-space-3) var(--ct-space-6);
    border-radius: var(--ct-r-pill);
    font-size: var(--ct-body-size);
    font-weight: var(--ct-fw-semi);
    line-height: var(--ct-leading-tight);
    text-decoration: none;
    border: 1px solid transparent;
    transition: background var(--ct-dur-base) var(--ct-ease-out), color var(--ct-dur-base) var(--ct-ease-out);
  }

  .ct-hero__btn--primary {
    background: var(--ct-action);
    color: var(--ct-on-accent);
    border-color: var(--ct-action-border);
  }

  .ct-hero__btn--primary:hover {
    background: var(--ct-action-hover);
  }

  .ct-hero__btn--secondary {
    background: transparent;
    color: var(--ct-on-accent);
    border-color: var(--ct-on-accent);
  }

  .ct-hero__btn--secondary:hover {
    background: var(--ct-overlay-strong);
  }

  .ct-hero__btn[aria-disabled="true"] {
    cursor: default;
  }

  @media screen and (max-width: 749px) {
    .ct-hero__inner {
      padding-inline: var(--ct-space-4);
    }

    .ct-hero--small .ct-hero__inner {
      min-height: 260px;
    }

    .ct-hero--medium .ct-hero__inner {
      min-height: 360px;
    }

    .ct-hero--large .ct-hero__inner {
      min-height: 460px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Media hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make a statement"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Add a short supporting line that introduces this hero and sets the tone for the page."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Secondary button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button2_url",
      "label": "Secondary button link"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 30
    },
    {
      "type": "select",
      "id": "min_height",
      "label": "Section height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Media hero"
    }
  ]
}
{% endschema %}
