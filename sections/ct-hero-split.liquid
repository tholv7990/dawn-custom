{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-hero-split.css' | asset_url | stylesheet_tag }}

{% render 'ct-section-padding', section: section %}

{%- comment -%} Live product binding: when section.settings.product is picked and button_link is blank, link auto-resolves to product.url. {%- endcomment -%}
{%- assign split_product = section.settings.product -%}
{%- assign split_btn_link = section.settings.button_link -%}
{%- if split_product != blank and split_btn_link == blank -%}
  {%- assign split_btn_link = split_product.url -%}
{%- endif -%}

<div class="page-width section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="ct-split{% if section.settings.image_position == 'right' %} ct-split--reverse{% endif %}" data-reveal>
    <div class="ct-split__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', class: 'ct-split__img', alt: section.settings.heading | escape }}
      {%- else -%}
        <span class="ct-split__emoji">{{ section.settings.emoji | default: '🏋️' }}</span>
      {%- endif -%}
    </div>
    <div class="ct-split__body">
      {%- if section.settings.kicker != blank -%}<div class="ct-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="ct-split__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<div class="ct-split__text rte">{{ section.settings.body }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="ct-btn ct-btn--primary ct-split__btn" href="{{ split_btn_link | default: '#' }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CT Hero split",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "product", "id": "product", "label": "Product (for dynamic source binding)", "info": "Pick the product so button link can be auto-bound to its PDP URL when the link field is left blank." },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Section label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Split hero headline — benefit-led" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>One paragraph describing the mechanism, benefit, or differentiator. 2–3 sentences.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn more →" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "emoji", "label": "Fallback emoji", "default": "🏋️" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "header", "content": "Section" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "presets": [ { "name": "CT Hero split" } ]
}
{% endschema %}
