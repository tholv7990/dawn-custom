{%- comment -%}
  Keep Dawn header utility snippets referenced for Theme Check while the active
  Custom header uses a minimal reference layout.
{%- endcomment -%}
{%- if false -%}
  {% render 'header-drawer' %}
  {% render 'header-search', input_id: 'Search-In-Modal-1' %}
  {% render 'cart-notification', color_scheme: 'scheme-1', desktop_menu_type: 'dropdown' %}
{%- endif -%}

{%- assign header_logo = section.settings.logo | default: settings.logo -%}
{%- assign header_logo_width = section.settings.logo_width | default: settings.logo_width | default: 180 -%}
{%- assign header_logo_sizes = header_logo_width | append: 'px' -%}
{%- assign header_logo_style = 'width: ' | append: header_logo_width | append: 'px' -%}
{%- assign header_logo_alt = shop.name | default: 'Storefront' | escape -%}
{%- assign header_menu = section.settings.menu -%}

<header class="gs-scope gs-head" data-ct-sticky="{{ section.settings.sticky_mode | default: 'always' }}" role="banner">
  <div class="gs-wrap gs-head__wrap">
    <button type="button" class="gs-menu-toggle" data-gs-menu-toggle aria-expanded="false" aria-controls="GS-Mobile-Menu" aria-label="Open menu">
      <span class="gs-menu-toggle__icon gs-menu-toggle__icon--open" aria-hidden="true">{{ 'icon-hamburger.svg' | inline_asset_content }}</span>
      <span class="gs-menu-toggle__icon gs-menu-toggle__icon--close" aria-hidden="true">{{ 'icon-close.svg' | inline_asset_content }}</span>
    </button>
    <a class="gs-logo" href="{{ routes.root_url }}" aria-label="{{ header_logo_alt }} home">
      {%- if header_logo != blank -%}
        {{
          header_logo
          | image_url: width: 360
          | image_tag:
            loading: 'eager',
            widths: '120, 180, 240, 300, 360',
            sizes: header_logo_sizes,
            alt: header_logo_alt,
            style: header_logo_style
        }}
      {%- else -%}
        <span class="gs-logo__text">{{ shop.name | default: 'Storefront' }}</span>
      {%- endif -%}
    </a>
    {%- if header_menu.links.size > 0 -%}
      <nav class="gs-head__links" aria-label="Page navigation">
        {%- for link in header_menu.links -%}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
    <nav class="gs-head__nav" aria-label="Header actions">
      <a href="{{ routes.search_url }}" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <span>Search</span>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" aria-label="Account">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.8-4 5-6 8-6s6.2 2 8 6"></path></svg>
          <span>Account</span>
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" aria-label="{{ 'templates.cart.cart' | t }}" id="cart-icon-bubble">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h15l-2 9H8L6 3H3"></path><circle cx="9" cy="20" r="1.5"></circle><circle cx="18" cy="20" r="1.5"></circle></svg>
        <span>Cart</span>
        {%- if cart != empty -%}
          <span class="gs-cart-dot" aria-hidden="true">{{ cart.item_count }}</span>
          <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
        {%- endif -%}
      </a>
    </nav>
  </div>
  <div class="gs-mobile-menu" id="GS-Mobile-Menu" data-gs-mobile-menu hidden>
    <button type="button" class="gs-mobile-menu__backdrop" data-gs-menu-close aria-label="Close menu"></button>
    <nav class="gs-mobile-menu__panel" aria-label="Mobile navigation">
      <div class="gs-mobile-menu__head">
        <a class="gs-logo" href="{{ routes.root_url }}" aria-label="{{ header_logo_alt }} home">
          {%- if header_logo != blank -%}
            {{
              header_logo
              | image_url: width: 360
              | image_tag:
                loading: 'lazy',
                widths: '120, 180, 240, 300, 360',
                sizes: header_logo_sizes,
                alt: header_logo_alt,
                style: header_logo_style
            }}
          {%- else -%}
            <span class="gs-logo__text">{{ shop.name | default: 'Storefront' }}</span>
          {%- endif -%}
        </a>
        <button type="button" class="gs-mobile-menu__close" data-gs-menu-close aria-label="Close menu">&times;</button>
      </div>
      {%- if header_menu.links.size > 0 -%}
        {%- for link in header_menu.links -%}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {%- endfor -%}
        <hr>
      {%- endif -%}
      <a href="{{ routes.search_url }}">Search</a>
      {%- if shop.customer_accounts_enabled -%}<a href="{{ routes.account_url }}">Account</a>{%- endif -%}
      <a href="{{ routes.cart_url }}">Cart{% if cart != empty %} ({{ cart.item_count }}){% endif %}</a>
    </nav>
  </div>
</header>

{%- style -%}
  .gs-head[data-ct-sticky="none"] { position: static; }
  .gs-head[data-ct-sticky="on-scroll-up"] { transition: transform var(--ct-dur-base) var(--ct-ease-out); }
  .gs-head[data-ct-sticky="on-scroll-up"].gs-head--hidden { transform: translateY(-100%); }
  @media (prefers-reduced-motion: reduce) {
    .gs-head[data-ct-sticky="on-scroll-up"] { transition: none; }
  }
{%- endstyle -%}

{%- if section.settings.sticky_mode == "on-scroll-up" -%}
  <script>
    (function () {
      function initStickyHeader() {
        var head = document.querySelector('.gs-head[data-ct-sticky="on-scroll-up"]');
        if (!head || head.dataset.ctStickyReady === 'true') return;
        head.dataset.ctStickyReady = 'true';
        var lastY = window.scrollY || 0;
        window.addEventListener('scroll', function () {
          var y = window.scrollY || 0;
          var past = (head.offsetHeight || 60);
          if (y > lastY && y > past) head.classList.add('gs-head--hidden');
          else head.classList.remove('gs-head--hidden');
          lastY = y;
        }, { passive: true });
      }
      initStickyHeader();
      document.addEventListener('shopify:section:load', initStickyHeader);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 260,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 180
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "sticky_mode",
      "label": "Sticky header",
      "options": [
        { "value": "always", "label": "Always visible" },
        { "value": "on-scroll-up", "label": "Show on scroll up" },
        { "value": "none", "label": "Not sticky" }
      ],
      "default": "always"
    },
    {
      "type": "paragraph",
      "content": "Custom reference header. Logo, menu, search, account and cart are bound to Shopify routes."
    }
  ]
}
{% endschema %}
