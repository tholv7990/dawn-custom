{%- comment -%}
  CozyClaw™ 15%-off email signup + thank-you popup. Two states share one backdrop:

    Signup state (default)  →  the 2-col card from CozyClaw™-signup-popup.html
    Thankyou state (.is-thankyou)  →  the centered card from CozyClaw™-thankyou-popup.html

  Opens after `delay_seconds` once per tab session (sessionStorage flag), unless
  the visitor clicks a link with href="#signup-popup" anywhere on the site
  (announcement bar, footer, etc.) — that always re-opens it. Submits via
  Shopify's customer form so the email lands in admin → Customers tagged
  'newsletter'; on success the JS swaps the modal to the thank-you card and
  fires the background fireworks canvas.
{%- endcomment -%}

{%- if section.settings.enable -%}
  {{ 'section-ct-signup-popup.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ct-signup-popup.js' | asset_url }}" defer></script>

  <ct-signup-popup
    class="ct-signup-popup"
    data-delay="{{ section.settings.delay_seconds | times: 1000 }}"
    data-session-key="ct-signup-popup-{{ section.id }}"
    data-frequency-days="{{ section.settings.frequency_days }}"
    aria-hidden="true"
  >
    <div class="ct-signup-popup__backdrop" data-popup-backdrop role="dialog" aria-modal="true" aria-labelledby="ct-signup-popup-title-{{ section.id }}">
      <canvas class="ct-signup-popup__fx" data-popup-fx aria-hidden="true"></canvas>

      {%- comment -%} SIGNUP MODAL {%- endcomment -%}
      <div class="ct-signup-popup__modal" data-popup-signup-modal>
        <button type="button" class="ct-signup-popup__x" aria-label="Close" data-popup-close>&times;</button>

        <div class="ct-signup-popup__visual" aria-hidden="true"{% if section.settings.image != blank %} style="background-image:linear-gradient(180deg,rgba(85,44,158,.05),rgba(85,44,158,.55)),url('{{ section.settings.image | image_url: width: 800 }}')"{% endif %}>
          {%- if section.settings.discount_tag_value != blank -%}
            <span class="ct-signup-popup__disc">
              {{ section.settings.discount_tag_value }}
              {%- if section.settings.discount_tag_label != blank -%}
                <small>{{ section.settings.discount_tag_label }}</small>
              {%- endif -%}
            </span>
          {%- endif -%}
        </div>

        <div class="ct-signup-popup__form">
          {%- if section.settings.eyebrow != blank -%}
            <span class="ct-signup-popup__eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2 class="ct-signup-popup__h2" id="ct-signup-popup-title-{{ section.id }}">{{ section.settings.heading }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="ct-signup-popup__sub">{{ section.settings.subheading }}</p>
          {%- endif -%}

          {%- form 'customer', class: 'ct-signup-popup__field', data-popup-form: '' -%}
            <input type="hidden" name="contact[tags]" value="{{ section.settings.customer_tag | default: 'newsletter' }}">
            <input type="hidden" name="contact[accepts_marketing]" value="true">
            {%- if form.posted_successfully? -%}
              <span hidden data-ct-newsletter-success></span>
            {%- endif -%}
            <label class="visually-hidden" for="ct-signup-popup-email-{{ section.id }}">Email address</label>
            <input
              type="email"
              id="ct-signup-popup-email-{{ section.id }}"
              name="contact[email]"
              placeholder="{{ section.settings.email_placeholder | default: 'Enter your email' }}"
              autocomplete="email"
              required
              data-popup-email
            >
            <span class="ct-signup-popup__err" data-popup-err>Please enter a valid email address.</span>
            <button type="submit" class="ct-signup-popup__cta" disabled aria-disabled="true">{{ section.settings.cta_label | default: 'Send my 15% code' }}</button>
          {%- endform -%}

          {%- if section.settings.consent != blank -%}
            <p class="ct-signup-popup__consent">{{ section.settings.consent }}</p>
          {%- endif -%}
          {%- if section.settings.dismiss_label != blank -%}
            <button type="button" class="ct-signup-popup__nothanks" data-popup-close>{{ section.settings.dismiss_label }}</button>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} THANK-YOU MODAL {%- endcomment -%}
      <div class="ct-signup-popup__thankyou" data-popup-thankyou>
        <button type="button" class="ct-signup-popup__x" aria-label="Close" data-popup-close>&times;</button>
        <div class="ct-signup-popup__badge" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M20.8 8.6a4 4 0 00-6.4-1L12 9.9 9.6 7.6A4 4 0 103.9 13l8.1 7.6 8.1-7.6a4 4 0 00.7-4.4z"/></svg>
        </div>
        {%- if section.settings.thankyou_eyebrow != blank -%}
          <span class="ct-signup-popup__eyebrow">{{ section.settings.thankyou_eyebrow }}</span>
        {%- endif -%}
        <h2 class="ct-signup-popup__h2">{{ section.settings.thankyou_heading | default: 'Thank you for signing up! 🎉' }}</h2>
        {%- if section.settings.thankyou_body != blank -%}
          <p class="ct-signup-popup__sub">{{ section.settings.thankyou_body }}</p>
        {%- endif -%}
        {%- if section.settings.thankyou_mailbox != blank -%}
          <div class="ct-signup-popup__mailbox">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            <span>{{ section.settings.thankyou_mailbox }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.thankyou_note != blank -%}
          <p class="ct-signup-popup__note">{{ section.settings.thankyou_note }}</p>
        {%- endif -%}
        <button type="button" class="ct-signup-popup__cta" data-popup-close>{{ section.settings.thankyou_cta_label | default: 'Start shopping' }}</button>
      </div>
    </div>
  </ct-signup-popup>
{%- endif -%}

{% schema %}
{
  "name": "CT Signup popup",
  "tag": "section",
  "class": "ct-signup-popup-section",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Enable popup", "default": true },
    { "type": "range", "id": "delay_seconds", "label": "Open after (seconds)", "min": 0, "max": 30, "step": 1, "unit": "s", "default": 5 },
    { "type": "range", "id": "frequency_days", "label": "Show again after close", "min": 1, "max": 30, "step": 1, "unit": "d", "default": 1 },
    { "type": "header", "content": "Signup — visual side" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "discount_tag_value", "label": "Discount tag (large)", "default": "15% OFF" },
    { "type": "text", "id": "discount_tag_label", "label": "Discount tag (small caps)", "default": "your first order" },
    { "type": "header", "content": "Signup — copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Welcome to the cozy club" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Get <em>15% off</em> your first order", "info": "Wrap the discount amount in <em> for the accent color." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Drop your email and we'll send your code straight to your inbox — plus first dibs on new colors and cozy deals for your dog or cat." },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Enter your email" },
    { "type": "text", "id": "cta_label", "label": "Primary CTA label", "default": "Send my 15% code" },
    { "type": "richtext", "id": "consent", "label": "Consent text", "default": "<p>By signing up you agree to receive marketing emails from CozyClaw™. Unsubscribe anytime.</p>" },
    { "type": "text", "id": "dismiss_label", "label": "Dismiss link label", "default": "No thanks, I'll pay full price" },
    { "type": "text", "id": "customer_tag", "label": "Customer tag applied on signup", "default": "newsletter" },
    { "type": "header", "content": "Thank-you state" },
    { "type": "text", "id": "thankyou_eyebrow", "label": "Eyebrow", "default": "You're on the list" },
    { "type": "text", "id": "thankyou_heading", "label": "Heading", "default": "Thank you for signing up! 🎉" },
    { "type": "textarea", "id": "thankyou_body", "label": "Body", "default": "You just made our day. Welcome to the cozy club — we're so glad you and your furry friend are here." },
    { "type": "inline_richtext", "id": "thankyou_mailbox", "label": "Mailbox line", "default": "Your <b>15% off</b> code is on its way — check your inbox to claim it." },
    { "type": "text", "id": "thankyou_note", "label": "Small note under mailbox", "default": "Don't see it in a minute? Peek in your spam or promotions folder." },
    { "type": "text", "id": "thankyou_cta_label", "label": "CTA label", "default": "Start shopping" },
    { "type": "checkbox", "id": "fireworks", "label": "Play fireworks effect", "default": true }
  ],
  "presets": [ { "name": "CT Signup popup" } ]
}
{% endschema %}
