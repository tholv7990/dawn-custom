{%- liquid
  assign main_product = section.settings.main_product
-%}

<section class="cth-psol">
  <div class="page-width">
    <div class="cth-head"><span class="cth-eyebrow">The real problem</span><h2>They love your couch. Give them their own.</h2></div>
    <div class="cth-psol__grid">
      <article class="cth-problem">
        <div class="cth-imgslot cth-psol__media ct-media ct-media--natural">
          {%- if section.settings.problem_image != blank -%}
            {{ section.settings.problem_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'cth-imgslot__img', alt: section.settings.problem_image.alt | default: 'Pet on couch before CozyClaw' | escape }}
          {%- elsif main_product.featured_image != blank -%}
            {{ main_product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'cth-imgslot__img', alt: main_product.title | escape }}
          {%- else -%}
            <span class="cth-ph">{% render 'ct-fa-icon', icon: 'paw' %}</span>
          {%- endif -%}
        </div>
        <div class="cth-psol__body">
          <h3>Right now</h3>
          <ul>
            <li>Your sofa collects fur, dander, and claw marks</li>
            <li>They sleep on the couch no matter what bed you buy</li>
            <li>Flat mats and blankets slide around and flatten fast</li>
            <li>Nothing in the room actually looks good</li>
          </ul>
        </div>
      </article>
      <article class="cth-solution">
        <div class="cth-imgslot cth-psol__media ct-media ct-media--natural">
          {%- if section.settings.solution_image != blank -%}
            {{ section.settings.solution_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'cth-imgslot__img', alt: section.settings.solution_image.alt | default: 'Pet using CozyClaw sofa' | escape }}
          {%- elsif main_product.featured_image != blank -%}
            {{ main_product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'cth-imgslot__img', alt: main_product.title | escape }}
          {%- else -%}
            <span class="cth-ph">{% render 'ct-fa-icon', icon: 'paw' %}</span>
          {%- endif -%}
        </div>
        <div class="cth-psol__body">
          <h3>With CozyClaw</h3>
          <ul>
            <li>A spot so cozy they choose it over your couch</li>
            <li>Helps keep fur and everyday mess off your furniture</li>
            <li>Raised walls and a supportive base that holds its shape</li>
            <li>Warm neutral tones made to suit your room</li>
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CT home problem",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "product", "id": "main_product", "label": "Main product" },
    { "type": "image_picker", "id": "problem_image", "label": "Problem card image" },
    { "type": "image_picker", "id": "solution_image", "label": "Solution card image" }
  ],
  "presets": [{ "name": "CT home problem" }]
}
{% endschema %}
