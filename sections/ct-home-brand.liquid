{%- liquid
  assign main_product = section.settings.main_product
-%}

<section class="cth-brand" id="about">
  <div class="page-width cth-brand__grid">
    <div>
      <span class="cth-eyebrow">Why we made it</span>
      <h2>For pets who claim the couch - and people who still want a clean home.</h2>
      <p>CozyClaw started with a slightly annoying truth: pets pick the sofa over every bed you buy them. So we built the one they would actually choose - plush, raised walls that make them feel safe, on a base that holds its shape, in tones that suit your room instead of fighting it.</p>
      <p>The result is a spot they love and a couch that finally gets a break. Cozy for them, cleaner for you.</p>
      <small>By pet people, for pet people.</small>
    </div>
    <div class="cth-imgslot">
      {%- if section.settings.brand_image != blank -%}
        {{ section.settings.brand_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'cth-imgslot__img', alt: section.settings.brand_image.alt | escape }}
      {%- elsif main_product.featured_image != blank -%}
        {{ main_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'cth-imgslot__img', alt: main_product.title | escape }}
      {%- else -%}
        <span class="cth-ph">{% render 'ct-fa-icon', icon: 'paw' %}</span>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CT home brand",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "product", "id": "main_product", "label": "Fallback product" },
    { "type": "image_picker", "id": "brand_image", "label": "Brand story image" }
  ],
  "presets": [{ "name": "CT home brand" }]
}
{% endschema %}
