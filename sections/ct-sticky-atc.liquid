{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-sticky-atc.css' | asset_url | stylesheet_tag }}

{%- comment -%} Live product binding: product name + button label suffix auto-bind when section.settings.product is picked. {%- endcomment -%}
{%- assign atc_product = section.settings.product -%}
{%- assign atc_name = section.settings.product_name -%}
{%- assign atc_btn_label = section.settings.button_label -%}
{%- assign atc_btn_link = section.settings.button_link -%}
{%- if atc_product != blank -%}
  {%- if atc_product.title != blank -%}{%- assign atc_name = atc_product.title -%}{%- endif -%}
  {%- assign atc_btn_label = atc_product.price_min | money | prepend: 'Add to Cart — ' -%}
  {%- if atc_btn_link == blank -%}{%- assign atc_btn_link = atc_product.url -%}{%- endif -%}
{%- endif -%}

<div class="ct-sticky-atc color-{{ section.settings.color_scheme }}" id="ct-sticky-atc-{{ section.id }}" role="region" aria-label="Quick add to cart">
  <div class="ct-sticky-atc__info">
    {%- assign sticky_img = section.settings.image -%}
    {%- if sticky_img == blank and atc_product != blank -%}
      {%- assign sticky_img = atc_product.featured_image -%}
    {%- endif -%}
    {%- if sticky_img != blank -%}
      <img class="ct-sticky-atc__img" src="{{ sticky_img | image_url: width: 96 }}" alt="{{ sticky_img.alt | escape | default: atc_name }}" loading="lazy" width="48" height="48">
    {%- elsif section.settings.emoji != blank -%}
      <span class="ct-sticky-atc__emoji" aria-hidden="true">{{ section.settings.emoji }}</span>
    {%- endif -%}
    <div class="ct-sticky-atc__text">
      <div class="ct-sticky-atc__name">{{ atc_name }}</div>
      {%- if section.settings.rating_text != blank -%}
        <div class="ct-sticky-atc__rating">
          <span class="ct-stars" aria-hidden="true">★★★★★</span>
          <span>{{ section.settings.rating_text }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- if atc_btn_label != blank -%}
    <a class="ct-btn ct-btn--primary ct-sticky-atc__btn" href="{{ atc_btn_link | default: '#' }}">{{ atc_btn_label }}</a>
  {%- endif -%}
</div>

<script>
  (function () {
    var bar = document.getElementById('ct-sticky-atc-{{ section.id }}');
    if (!bar) return;
    var hero = document.querySelector('.ct-hero');
    function show(visible) { bar.classList.toggle('is-visible', visible); }
    if ('IntersectionObserver' in window && hero) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { show(!e.isIntersecting); });
      }, { threshold: 0.1 });
      io.observe(hero);
    } else {
      window.addEventListener('scroll', function () { show(window.scrollY > 500); }, { passive: true });
    }
  })();
</script>

{% schema %}
{
  "name": "CT Sticky add-to-cart",
  "tag": "section",
  "class": "ct-sticky-atc-section",
  "enabled_on": { "templates": ["index", "page", "product"] },
  "settings": [
    { "type": "product", "id": "product", "label": "Product (for dynamic source binding)", "info": "Pick the product so product name / button label can be connected to live Shopify data via the chain-link 'Connect dynamic source' icon next to each field." },
    { "type": "image_picker", "id": "image", "label": "Thumbnail image", "info": "Falls back to product.featured_image when blank and a product is picked. Replaces the emoji when set." },
    { "type": "text", "id": "emoji", "label": "Emoji / icon (only used if no image and no product)", "default": "" },
    { "type": "text", "id": "product_name", "label": "Product name override (otherwise uses product.title)", "default": "" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "★★★★★ 4.7 · 52 reviews" },
    { "type": "text", "id": "button_label", "label": "Button label override (otherwise uses 'Add to Cart — $X.XX' from product.price_min)", "default": "" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [ { "name": "CT Sticky add-to-cart" } ]
}
{% endschema %}
