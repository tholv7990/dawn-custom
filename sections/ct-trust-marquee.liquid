{% render 'ct-section-padding', section: section %}

{%- style -%}
  #shopify-section-{{ section.id }} .gs-trust-marquee {
    position: relative;
  }
  #shopify-section-{{ section.id }} .gs-trust-marquee .gs-marquee-track {
    letter-spacing: 0.04em;
  }
  #shopify-section-{{ section.id }} .gs-trust-marquee .gs-marquee-set span {
    line-height: 1;
  }
  /* Soft edge fades so the scrolling copy reads cleanly at the container edges */
  #shopify-section-{{ section.id }} .gs-trust-marquee::before,
  #shopify-section-{{ section.id }} .gs-trust-marquee::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(24px, 6vw, 64px);
    z-index: 1;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .gs-trust-marquee::before {
    left: 0;
    background: linear-gradient(to right, var(--ct-accent), transparent);
  }
  #shopify-section-{{ section.id }} .gs-trust-marquee::after {
    right: 0;
    background: linear-gradient(to left, var(--ct-accent), transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .gs-trust-marquee .gs-marquee-track {
      animation: none;
      transform: none;
      will-change: auto;
    }
  }
{%- endstyle -%}

<div class="gs-scope gs-trust-marquee section-{{ section.id }}-padding">
  <div class="gs-marquee-track" style="--ct-marquee-duration: {{ section.settings.speed }}s;">
    {%- for repeat in (1..6) -%}
      <div class="gs-marquee-set"{% if repeat > 1 %} aria-hidden="true"{% endif %}>
      {%- for block in section.blocks -%}
        <span{% if repeat == 1 %} {{ block.shopify_attributes }}{% endif %}>
          {%- if block.settings.icon != blank -%}
            <b aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when '&#10003;', '✓', 'check' -%}
                  {{ 'icon-checkmark.svg' | inline_asset_content }}
                {%- when '&#128666;', 'truck' -%}
                  {{ 'icon-truck.svg' | inline_asset_content }}
                {%- when '&#128737;', 'shield', 'lock' -%}
                  {{ 'icon-padlock.svg' | inline_asset_content }}
                {%- when '&#8634;', 'return' -%}
                  {{ 'icon-return.svg' | inline_asset_content }}
                {%- else -%}
                  {{ block.settings.icon }}
              {%- endcase -%}
            </b>
          {%- endif -%}
          {{ block.settings.text }}
        </span>
      {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Trust marquee",
  "settings": [
    { "type": "range", "id": "speed", "label": "Speed", "min": 30, "max": 90, "step": 5, "default": 30 },
    { "type": "header", "content": "Section padding" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "&#10003;" },
        { "type": "text", "id": "text", "label": "Text", "default": "Quality you can trust" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust marquee",
      "blocks": [
        { "type": "message", "settings": { "icon": "&#128666;", "text": "Free shipping on qualifying orders" } },
        { "type": "message", "settings": { "icon": "&#10003;", "text": "Quality you can trust" } },
        { "type": "message", "settings": { "icon": "&#8634;", "text": "Easy returns" } },
        { "type": "message", "settings": { "icon": "&#128737;", "text": "Secure checkout" } }
      ]
    }
  ]
}{% endschema %}

