{% render 'ct-section-padding', section: section %}

<div class="gs-scope gs-trust-marquee gs-trust-marquee--{{ section.settings.skin }} section-{{ section.id }}-padding">
  <div class="gs-marquee-track" style="--ct-marquee-duration: {{ section.settings.speed }}s;">
    {%- for repeat in (1..6) -%}
      <div class="gs-marquee-set"{% if repeat > 1 %} aria-hidden="true"{% endif %}>
      {%- for block in section.blocks -%}
        <span{% if repeat == 1 %} {{ block.shopify_attributes }}{% endif %}>
          {%- if block.settings.icon != blank -%}
            <b aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when '&#10003;', '✓', 'check' -%}
                  {{ 'icon-checkmark.svg' | inline_asset_content }}
                {%- when '&#128666;', 'truck' -%}
                  {{ 'icon-truck.svg' | inline_asset_content }}
                {%- when '&#128737;', 'shield', 'lock' -%}
                  {{ 'icon-padlock.svg' | inline_asset_content }}
                {%- when '&#8634;', 'return' -%}
                  {{ 'icon-return.svg' | inline_asset_content }}
                {%- else -%}
                  {{ block.settings.icon }}
              {%- endcase -%}
            </b>
          {%- endif -%}
          {{ block.settings.text }}
        </span>
      {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Trust marquee",
  "settings": [
    {
      "type": "select",
      "id": "skin",
      "label": "Band color",
      "options": [
        { "value": "accent", "label": "Accent" },
        { "value": "ink", "label": "Ink (dark)" }
      ],
      "default": "accent"
    },
    { "type": "range", "id": "speed", "label": "Speed", "min": 30, "max": 90, "step": 5, "default": 30 },
    { "type": "header", "content": "Section padding" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "&#10003;" },
        { "type": "text", "id": "text", "label": "Text", "default": "Add trust message" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust marquee",
      "blocks": [
        { "type": "message", "settings": { "icon": "&#10003;", "text": "Add trust message" } },
        { "type": "message", "settings": { "icon": "&#128666;", "text": "Add shipping message" } },
        { "type": "message", "settings": { "icon": "&#128737;", "text": "Add payment message" } },
        { "type": "message", "settings": { "icon": "&#8634;", "text": "Add policy message" } }
      ]
    }
  ]
}{% endschema %}

