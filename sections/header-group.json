{
  "name": "t:sections.header.name",
  "type": "header",
  "sections": {
    "ct_announce": {
      "type": "ct-announce",
      "settings": {
        "display": "rotate",
        "dismissible": false,
        "rotate_seconds": 4,
        "color_scheme": "scheme-1"
      },
      "blocks": {
        "m1": { "type": "message", "settings": { "text": "🎁 Claim your 15% off — sign up inside", "link": "#signup-popup" } },
        "m2": { "type": "message", "settings": { "text": "🚚 Free shipping on orders $75+" } },
        "m3": { "type": "message", "settings": { "text": "🌙 30-night risk-free trial" } },
        "m4": { "type": "message", "settings": { "text": "🐾 A cozy spot for dogs & cats" } }
      },
      "block_order": ["m1","m2","m3","m4"]
    },
    "header": {
      "type": "header",
      "settings": {
        "color_scheme": "scheme-1",
        "logo_position": "middle-left",
        "menu": "main-menu",
        "menu_type_desktop": "dropdown",
        "sticky_header_type": "on-scroll-up",
        "show_line_separator": true,
        "enable_country_selector": true,
        "enable_language_selector": true,
        "mobile_logo_position": "center",
        "margin_bottom": 0,
        "padding_top": 20,
        "padding_bottom": 20
      }
    }
  },
  "order": ["ct_announce", "header"]
}
