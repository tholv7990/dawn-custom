{
  "name": "t:sections.header.name",
  "type": "header",
  "sections": {
    "ct_announce": {
      "type": "ct-announce",
      "settings": {
        "display": "static-row",
        "dismissible": false,
        "rotate_seconds": 4,
        "color_scheme": "scheme-1"
      },
      "blocks": {
        "m1": {
          "type": "message",
          "settings": {
            "text": "15% off your first order when you join the litter",
            "link": "#signup-popup"
          }
        },
        "m2": {
          "type": "message",
          "settings": {
            "text": "Free shipping over $50"
          }
        },
        "m3": {
          "type": "message",
          "settings": {
            "text": "30-night cozy trial"
          }
        }
      },
      "block_order": ["m1", "m2", "m3"]
    },
    "header": {
      "type": "header",
      "settings": {
        "color_scheme": "scheme-1",
        "logo_position": "middle-left",
        "menu": "main-menu",
        "menu_type_desktop": "dropdown",
        "sticky_header_type": "always",
        "show_line_separator": true,
        "enable_country_selector": false,
        "enable_language_selector": false,
        "mobile_logo_position": "center",
        "margin_bottom": 0,
        "padding_top": 12,
        "padding_bottom": 12
      }
    }
  },
  "order": ["ct_announce", "header"]
}
