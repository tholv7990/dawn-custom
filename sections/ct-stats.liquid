{% render 'ct-section-padding', section: section %}

<section class="gs-scope ct-stats section-{{ section.id }}-padding">
  <div class="gs-wrap">
    {%- unless section.settings.heading == blank -%}
      <h2 class="gs-section-heading">{{ section.settings.heading | escape }}</h2>
    {%- endunless -%}
    {%- unless section.settings.subheading == blank -%}
      <p class="gs-section-sub">{{ section.settings.subheading | escape }}</p>
    {%- endunless -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="ct-stats__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="ct-stats__item" {{ block.shopify_attributes }}>
            <p class="ct-stats__value">
              <span class="ct-stats__number">{{ block.settings.value | escape }}</span>
              {%- unless block.settings.suffix == blank -%}
                <span class="ct-stats__suffix">{{ block.settings.suffix | escape }}</span>
              {%- endunless -%}
            </p>
            <p class="ct-stats__label">{{ block.settings.label | escape }}</p>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% style %}
  .ct-stats {
    background: var(--ct-bg);
    color: var(--ct-text);
  }

  .ct-stats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ct-space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ct-stats__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: var(--ct-space-2);
    text-align: center;
    padding: var(--ct-space-6);
    background: var(--ct-bg-surface);
    border: 1px solid var(--ct-border);
    border-radius: var(--ct-r-lg);
  }

  .ct-stats__value {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--ct-space-1);
    margin: 0;
    color: var(--ct-action);
    font-size: var(--ct-h2);
    font-weight: var(--ct-fw-bold);
    line-height: var(--ct-leading-tight);
  }

  .ct-stats__suffix {
    font-size: var(--ct-h2);
    font-weight: var(--ct-fw-bold);
    line-height: var(--ct-leading-tight);
  }

  .ct-stats__label {
    margin: 0;
    color: var(--ct-text-2);
    font-size: var(--ct-text-base);
    font-weight: var(--ct-fw-medium);
    line-height: var(--ct-leading-base);
  }

  @media screen and (min-width: 750px) {
    .ct-stats__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--ct-space-8);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Stats band",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "By the numbers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "A quick snapshot of the metrics that matter."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "0"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix",
          "default": "+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Stat label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats band",
      "blocks": [
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
