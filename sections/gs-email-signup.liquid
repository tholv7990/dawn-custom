<section class="gs-scope gs-email-signup" data-gs-email-signup>
  <div class="gs-wrap gs-email-signup__inner">
    <p class="gs-email-signup__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2>{{ section.settings.heading | escape }}</h2>
    <p class="gs-email-signup__body">{{ section.settings.body | escape }}</p>

    {%- assign gs_email_form_id = 'GS-Email-Signup-' | append: section.id -%}
    {%- assign gs_email_success = false -%}
    {%- form 'customer', id: gs_email_form_id, class: 'gs-email-signup__form' -%}
      {%- if form.posted_successfully? -%}
        {%- assign gs_email_success = true -%}
      {%- endif -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="gs-email-signup__field">
        <label class="visually-hidden" for="GS-Email-{{ section.id }}">Email address</label>
        <input
          id="GS-Email-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          placeholder="{{ section.settings.placeholder | escape }}"
          required
          data-gs-email-input
        >
        <button type="submit" data-gs-email-submit disabled>{{ section.settings.button_label | escape }}</button>
      </div>
      <p class="gs-email-signup__error" data-gs-email-error hidden>Please enter a valid email address.</p>
      {%- if form.errors -%}
        <p class="gs-email-signup__error">
          {{ form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email }}
        </p>
      {%- endif -%}
    {%- endform -%}

    <small>{{ section.settings.disclaimer | escape }}</small>
  </div>

  <div
    class="gs-email-modal{% if gs_email_success %} is-open{% endif %}"
    data-gs-email-modal
    {% unless gs_email_success %}
      hidden
    {% endunless %}
  >
    <button type="button" class="gs-email-modal__backdrop" data-gs-email-close aria-label="Close thank you popup"></button>
    <div class="gs-email-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="GS-Email-Thanks-{{ section.id }}">
      <button type="button" class="gs-email-modal__close" data-gs-email-close aria-label="Close thank you popup">&times;</button>
      <div class="gs-email-modal__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M20.8 8.6a4 4 0 0 0-6.4-1L12 9.9 9.6 7.6A4 4 0 1 0 3.9 13l8.1 7.6 8.1-7.6a4 4 0 0 0 .7-4.4Z" />
        </svg>
      </div>
      <p class="gs-email-modal__eyebrow">{{ section.settings.thanks_eyebrow | escape }}</p>
      <h3 id="GS-Email-Thanks-{{ section.id }}">{{ section.settings.thanks_heading | escape }}</h3>
      <p class="gs-email-modal__body">{{ section.settings.thanks_body | escape }}</p>
      <div class="gs-email-modal__message">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
        <span>{{ section.settings.thanks_message | escape }}</span>
      </div>
      <p class="gs-email-modal__note">{{ section.settings.thanks_note | escape }}</p>
      <button type="button" class="gs-email-modal__cta" data-gs-email-close>
        {{ section.settings.thanks_button_label | escape }}
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GS email signup",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "JOIN THE LIST" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "15% off your first order" },
    {
      "type": "text",
      "id": "body",
      "label": "Body",
      "default": "Join the list and we'll email your 15% code, plus first dibs on new colors & designs. No spam - unsubscribe anytime."
    },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "you@email.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send my code" },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "We'll email your code - 15% off your first order, any size - one discount per order - offers don't combine"
    },
    { "type": "text", "id": "thanks_eyebrow", "label": "Thank you eyebrow", "default": "YOU'RE ON THE LIST" },
    { "type": "text", "id": "thanks_heading", "label": "Thank you heading", "default": "Thank you for signing up!" },
    {
      "type": "text",
      "id": "thanks_body",
      "label": "Thank you body",
      "default": "You just made our day. Welcome to the garden club - we're so glad you and your garden are here."
    },
    {
      "type": "text",
      "id": "thanks_message",
      "label": "Thank you message",
      "default": "Your 15% off code is on its way - check your inbox to claim it."
    },
    {
      "type": "text",
      "id": "thanks_note",
      "label": "Thank you note",
      "default": "Don't see it in a minute? Peek in your spam or promotions folder."
    },
    { "type": "text", "id": "thanks_button_label", "label": "Thank you button label", "default": "Start shopping" }
  ],
  "presets": [{ "name": "GS email signup" }]
}
{% endschema %}
