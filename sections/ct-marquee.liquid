{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-marquee.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <div class="ct-marquee color-{{ section.settings.color_scheme }}" style="--ct-marquee-speed:{{ section.settings.speed }}s">
    <div class="ct-marquee-track">
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          <span class="ct-marquee-item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "CT Marquee",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "range", "id": "speed", "label": "Scroll duration", "min": 12, "max": 60, "step": 2, "unit": "s", "default": 28, "info": "Lower = faster. Pauses on hover; disabled when reduced-motion is on." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    { "type": "message", "name": "Message", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders $100+" } ] }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "CT Marquee",
      "blocks": [
        { "type": "message", "settings": { "text": "Free shipping on orders $100+" } },
        { "type": "message", "settings": { "text": "30-day money-back guarantee" } },
        { "type": "message", "settings": { "text": "Over 10,000 customers trained" } },
        { "type": "message", "settings": { "text": "Lifetime warranty on all products" } },
        { "type": "message", "settings": { "text": "Ships within 24 hours" } }
      ]
    }
  ]
}
{% endschema %}
