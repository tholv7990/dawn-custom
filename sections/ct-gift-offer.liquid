{%- liquid
  assign gift_product = section.settings.gift_product
-%}
{%- if gift_product != blank -%}
  {% render 'ct-section-padding', section: section %}

  {%- liquid
    assign gift_variant = gift_product.selected_or_first_available_variant

    assign threshold = section.settings.threshold_cents | times: 1
    assign current = cart.total_price

    assign unlocked = false
    if threshold == 0
      assign unlocked = true
    elsif current >= threshold
      assign unlocked = true
    endif

    assign remaining = threshold | minus: current
    if remaining < 0
      assign remaining = 0
    endif
    assign remaining_money = remaining | money

    assign locked_message = section.settings.locked_text | replace: '[amount]', remaining_money

    assign can_add = false
    if unlocked and gift_variant != blank and gift_variant.available
      assign can_add = true
    endif
  -%}

  <section
    class="ct-gift gs-scope section-{{ section.id }}-padding{% if unlocked %} ct-gift--unlocked{% endif %}"
    id="ct-gift-{{ section.id }}"
    data-section-id="{{ section.id }}"
    data-threshold="{{ threshold }}"
    data-current="{{ current }}"
    data-locked-template="{{ section.settings.locked_text | escape }}"
    data-unlocked-text="{{ section.settings.unlocked_text | escape }}"
    data-money-format="{{ shop.money_format | escape }}"
  >
    <div class="gs-wrap">
      {%- if section.settings.heading != blank -%}
        <h2 class="gs-section-heading ct-gift__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="ct-gift__inner">
        <div class="ct-gift__card">
          {% render 'ct-media-slot',
            image: gift_variant.featured_media.preview_image | default: gift_product.featured_image,
            class: 'ct-gift__media',
            label: gift_product.title,
            alt: gift_product.title
          %}
          <div class="ct-gift__card-body">
            <p class="ct-gift__product-title">{{ gift_product.title | escape }}</p>
          </div>
        </div>

        <div class="ct-gift__detail">
          <p
            class="ct-gift__status{% if unlocked %} ct-gift__status--unlocked{% endif %}"
            data-gift-status
            aria-live="polite"
          >
            <span data-gift-status-text>
              {%- if unlocked -%}
                {{ section.settings.unlocked_text | escape }}
              {%- else -%}
                {{ locked_message | escape }}
              {%- endif -%}
            </span>
          </p>

          <button
            type="button"
            class="ct-gift__add"
            data-gift-add
            data-variant-id="{{ gift_variant.id }}"
            {% unless can_add %}aria-disabled="true" disabled{% endunless %}
          >
            <span class="ct-gift__add-label" data-gift-add-label>{{ section.settings.button_label | escape }}</span>
            <span class="ct-gift__add-loading" data-gift-loading hidden>
              {%- render 'loading-spinner' -%}
            </span>
          </button>

          <p class="ct-gift__error" data-gift-error role="alert" aria-live="assertive" hidden></p>

          {%- if section.settings.note != blank -%}
            <p class="ct-gift__note">{{ section.settings.note | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  {%- style -%}
    .ct-gift {
      background: var(--ct-bg);
      color: var(--ct-text);
    }
    .ct-gift .gs-wrap {
      max-width: 900px;
      margin: 0 auto;
    }
    .ct-gift__heading {
      text-align: center;
      margin-bottom: var(--ct-space-5);
    }
    .ct-gift__inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--ct-space-6);
      padding: var(--ct-space-6);
      background: var(--ct-card-bg);
      border: 1px solid var(--ct-card-border);
      border-radius: var(--ct-r-lg);
      box-shadow: var(--ct-shadow-sm);
    }
    .ct-gift__card {
      flex: 0 0 auto;
      width: 160px;
      display: flex;
      flex-direction: column;
      gap: var(--ct-space-3);
      background: var(--ct-bg-raised);
      border: 1px solid var(--ct-border);
      border-radius: var(--ct-r-md);
      overflow: hidden;
    }
    .ct-gift__media {
      width: 100%;
    }
    .ct-gift__card-body {
      padding: var(--ct-space-3) var(--ct-space-4) var(--ct-space-4);
    }
    .ct-gift__product-title {
      margin: 0;
      font-size: var(--ct-text-sm);
      font-weight: var(--ct-fw-semi);
      line-height: 1.3;
      color: var(--ct-text);
    }
    .ct-gift__detail {
      flex: 1 1 280px;
      display: flex;
      flex-direction: column;
      gap: var(--ct-space-4);
    }
    .ct-gift__status {
      margin: 0;
      font-size: var(--ct-text-base);
      font-weight: var(--ct-fw-medium);
      line-height: 1.45;
      color: var(--ct-text-2);
    }
    .ct-gift__status--unlocked {
      color: var(--ct-success);
      font-weight: var(--ct-fw-semi);
    }
    .ct-gift__add {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--ct-space-2);
      width: 100%;
      min-height: 48px;
      padding: var(--ct-space-3) var(--ct-space-6);
      border: 1px solid transparent;
      border-radius: var(--ct-r-pill);
      background: var(--ct-action);
      color: var(--ct-on-accent);
      font-size: var(--ct-text-base);
      font-weight: var(--ct-fw-bold);
      cursor: pointer;
      transition: background var(--ct-dur-base) var(--ct-ease-out);
    }
    .ct-gift__add:hover {
      background: var(--ct-action-hover);
    }
    .ct-gift__add[disabled],
    .ct-gift__add[aria-disabled='true'] {
      opacity: 0.55;
      cursor: not-allowed;
    }
    .ct-gift__add[aria-busy='true'] .ct-gift__add-label {
      visibility: hidden;
    }
    .ct-gift__add-loading {
      display: inline-flex;
      align-items: center;
    }
    .ct-gift__add-loading[hidden] {
      display: none;
    }
    .ct-gift__add .loading-spinner {
      position: static;
    }
    .ct-gift__error {
      margin: 0;
      font-size: var(--ct-text-sm);
      font-weight: var(--ct-fw-medium);
      color: var(--ct-badge-sale);
    }
    .ct-gift__error[hidden] {
      display: none;
    }
    .ct-gift__note {
      margin: 0;
      font-size: var(--ct-text-xs);
      line-height: 1.5;
      color: var(--ct-text-3);
    }
    @media screen and (max-width: 749px) {
      .ct-gift__inner {
        padding: var(--ct-space-5);
      }
      .ct-gift__card {
        width: 120px;
      }
    }
  {%- endstyle -%}

  <script>
    (function () {
      var SECTION_ID = '{{ section.id }}';

      function init(root) {
        if (!root || root.dataset.ready === 'true') return;
        root.dataset.ready = 'true';

        var button = root.querySelector('[data-gift-add]');
        var statusText = root.querySelector('[data-gift-status-text]');
        var statusEl = root.querySelector('[data-gift-status]');
        var loading = root.querySelector('[data-gift-loading]');
        var errorEl = root.querySelector('[data-gift-error]');

        var threshold = parseInt(root.getAttribute('data-threshold'), 10);
        if (isNaN(threshold)) threshold = 0;
        var lockedTemplate = root.getAttribute('data-locked-template') || '';
        var unlockedText = root.getAttribute('data-unlocked-text') || '';
        var moneyFormat = root.getAttribute('data-money-format') || '';

        var reduceMotion =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function formatMoney(cents) {
          if (moneyFormat && window.Shopify && typeof window.Shopify.formatMoney === 'function') {
            try {
              return window.Shopify.formatMoney(cents, moneyFormat);
            } catch (e) {
              /* fall through */
            }
          }
          return (cents / 100).toFixed(2);
        }

        function showError(message) {
          if (!errorEl) return;
          errorEl.textContent = message || 'Something went wrong. Please try again.';
          errorEl.hidden = false;
        }

        function clearError() {
          if (!errorEl) return;
          errorEl.textContent = '';
          errorEl.hidden = true;
        }

        function setBusy(isBusy) {
          if (!button) return;
          button.disabled = isBusy;
          button.setAttribute('aria-busy', isBusy ? 'true' : 'false');
          if (loading) loading.hidden = !isBusy;
        }

        function setUnlocked(unlocked) {
          root.classList.toggle('ct-gift--unlocked', unlocked);
          if (statusEl) statusEl.classList.toggle('ct-gift__status--unlocked', unlocked);
          if (button) {
            if (unlocked) {
              button.removeAttribute('disabled');
              button.removeAttribute('aria-disabled');
            } else {
              button.setAttribute('disabled', '');
              button.setAttribute('aria-disabled', 'true');
            }
          }
          if (!statusText) return;
          if (unlocked) {
            statusText.textContent = unlockedText;
          } else {
            var remaining = threshold - current;
            if (remaining < 0) remaining = 0;
            statusText.textContent = lockedTemplate.replace('[amount]', formatMoney(remaining));
          }
        }

        var current = parseInt(root.getAttribute('data-current'), 10);
        if (isNaN(current)) current = 0;

        function evaluate(total) {
          if (typeof total === 'number' && !isNaN(total)) current = total;
          var unlocked = threshold === 0 || current >= threshold;
          setUnlocked(unlocked);
          return unlocked;
        }

        function cartUrl() {
          var routes = window.Shopify && window.Shopify.routes;
          var rootPath = (routes && routes.root) || '/';
          return rootPath + 'cart.js';
        }

        function refresh() {
          try {
            fetch(cartUrl(), { headers: { Accept: 'application/json' } })
              .then(function (res) {
                return res.json();
              })
              .then(function (cart) {
                if (cart && typeof cart.total_price === 'number') {
                  evaluate(cart.total_price);
                }
              })
              .catch(function () {
                /* keep server-rendered state */
              });
          } catch (e) {
            /* no-op */
          }
        }

        if (button) {
          button.addEventListener('click', function () {
            if (button.disabled) return;
            clearError();

            var variantId = parseInt(button.getAttribute('data-variant-id'), 10);
            if (isNaN(variantId)) {
              showError('This gift is unavailable.');
              return;
            }

            var cart =
              document.querySelector('cart-notification') || document.querySelector('cart-drawer');
            var rootUrl =
              (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
            var endpoint = rootUrl + 'cart/add.js';

            var sectionsToRender = [];
            if (cart && typeof cart.getSectionsToRender === 'function') {
              sectionsToRender = cart.getSectionsToRender().map(function (s) {
                return s.id;
              });
            } else {
              sectionsToRender = ['cart-drawer', 'cart-icon-bubble', 'cart-notification'];
            }

            var body = {
              id: variantId,
              quantity: 1,
              sections: sectionsToRender,
              sections_url: window.location.pathname,
            };

            setBusy(true);

            fetch(endpoint, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              body: JSON.stringify(body),
            })
              .then(function (response) {
                return response.json().then(function (data) {
                  if (!response.ok) {
                    throw new Error(
                      (data && (data.description || data.message)) || 'Unable to add the gift to cart.'
                    );
                  }
                  return data;
                });
              })
              .then(function (data) {
                if (cart && typeof cart.renderContents === 'function') {
                  cart.renderContents(data);
                }
                refresh();
              })
              .catch(function (error) {
                showError(error && error.message ? error.message : 'Unable to add the gift to cart.');
              })
              .then(function () {
                setBusy(false);
              });
          });
        }

        // Re-check the threshold against the live cart on load.
        refresh();

        if (window.subscribe && window.PUB_SUB_EVENTS && window.PUB_SUB_EVENTS.cartUpdate) {
          window.subscribe(window.PUB_SUB_EVENTS.cartUpdate, function (event) {
            if (event && event.cartData && typeof event.cartData.total_price === 'number') {
              evaluate(event.cartData.total_price);
            } else {
              refresh();
            }
          });
        }

        void reduceMotion;
      }

      init(document.getElementById('ct-gift-' + SECTION_ID));

      document.addEventListener('shopify:section:load', function (event) {
        if (event.detail && event.detail.sectionId === SECTION_ID) {
          init(document.getElementById('ct-gift-' + SECTION_ID));
        }
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Free gift offer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Free gift"
    },
    {
      "type": "product",
      "id": "gift_product",
      "label": "Gift product"
    },
    {
      "type": "text",
      "id": "threshold_cents",
      "label": "Unlock threshold",
      "info": "Spend amount in the shop currency subunits (for example, cents) required to unlock the gift. Use 0 to make it always available.",
      "default": "0"
    },
    {
      "type": "text",
      "id": "locked_text",
      "label": "Locked message",
      "info": "Use [amount] where the remaining total should appear.",
      "default": "Spend [amount] more to unlock your free gift"
    },
    {
      "type": "text",
      "id": "unlocked_text",
      "label": "Unlocked message",
      "default": "You have unlocked a free gift!"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add free gift"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": "Your free gift is applied as a discount at checkout - configure an automatic discount in admin."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Free gift offer"
    }
  ]
}
{% endschema %}
