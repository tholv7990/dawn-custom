{%- liquid
  assign main_product = section.settings.main_product
  assign main_url = main_product.url | default: routes.all_products_collection_url
  assign main_price = section.settings.main_price_fallback

  if main_product != blank
    if settings.currency_code_enabled
      assign main_price = main_product.price_min | money_with_currency
    else
      assign main_price = main_product.price_min | money
    endif
  endif
-%}

<script src="{{ 'ct-product-gallery.js' | asset_url }}" defer="defer"></script>

<section class="cth-showcase" id="product">
  <div class="page-width cth-showcase__grid">
    <div>
      {% render 'ct-product-gallery',
        product: main_product,
        image: section.settings.product_image,
        wrapper_class: 'cth-showcase-gallery',
        carousel_class: 'cth-imgslot cth-showcase__main cth-showcase-gallery__carousel',
        track_class: 'cth-showcase-gallery__track',
        slide_class: 'cth-showcase-gallery__slide',
        image_class: 'cth-imgslot__img',
        dots_class: 'cth-dots',
        dot_class: 'cth-dot',
        arrow_class: 'cth-gallery-arrow',
        prev_class: 'cth-gallery-arrow--prev',
        next_class: 'cth-gallery-arrow--next'
      %}
    </div>
    <div class="cth-buy">
      <span class="cth-eyebrow">The CozyClaw&trade; Plush Pet Sofa</span>
      <h2>One little sofa. A whole lot of calm.</h2>
      <div class="cth-rate">{% render 'ct-stars' %}<span>4.9/5</span><span class="cth-muted">&middot; 13 reviews</span></div>
      <div class="cth-price"><span>From</span><b>{{ main_price }}</b></div>
      <p class="cth-muted">Plus free shipping over $50 - most single orders ship free.</p>
      <div class="cth-opt">
        <b>Available in <span>Coffee &middot; Grey &middot; Black</span></b>
        <div class="cth-swatches cth-swatches--lg">
          <i style="--swatch: var(--ct-swatch-coffee)" title="Coffee"></i>
          <i style="--swatch: var(--ct-swatch-grey)" title="Grey"></i>
          <i style="--swatch: var(--ct-swatch-black)" title="Black"></i>
        </div>
      </div>
      <p class="cth-muted">Two roomy sizes: 60 x 80 cm and 80 x 90 cm. Pick your color and size on the product page.</p>
      <div class="cth-buy__actions">
        <a class="cth-btn cth-btn--coral cth-btn--block" href="{{ main_url }}">Shop the Cozy Sofa &rarr;</a>
        <a class="cth-btn cth-btn--ghost cth-btn--block" href="#bundle">See the Cleaner Couch Kit</a>
      </div>
      <div class="cth-assure">
        <span>{% render 'ct-checkmark' %}30-night cozy trial</span>
        <span>{% render 'ct-checkmark' %}Easy returns</span>
        <span>{% render 'ct-checkmark' %}Secure checkout</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CT home product",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "product", "id": "main_product", "label": "Main product" },
    { "type": "text", "id": "main_price_fallback", "label": "Price fallback", "default": "$59.99" },
    { "type": "image_picker", "id": "product_image", "label": "Product image" }
  ],
  "presets": [{ "name": "CT home product" }]
}
{% endschema %}
