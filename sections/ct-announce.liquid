{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-announce.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  {%- if section.settings.display == 'static-row' -%}
    <div class="ct-announce ct-announce--static-row color-{{ section.settings.color_scheme }}" role="region" aria-label="Announcement">
      <div class="page-width">
        {%- for block in section.blocks -%}
          <span class="ct-announce--static-row__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}{{ block.settings.text }}
            {%- endif -%}
          </span>
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <div class="ct-announce color-{{ section.settings.color_scheme }}" id="ct-announce-{{ section.id }}" role="region" aria-label="Announcement">
      <span class="ct-announce__spacer" aria-hidden="true"></span>
      <div class="ct-announce__viewport">
        {%- for block in section.blocks -%}
          <div class="ct-announce__msg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            <span class="ct-announce__dot" aria-hidden="true"></span>
            {%- if block.settings.link != blank -%}
              <a class="ct-announce__link" href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
            <span class="ct-announce__dot" aria-hidden="true"></span>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.settings.dismissible -%}
        <button class="ct-announce__dismiss" type="button" aria-label="Dismiss announcement">
          <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      {%- else -%}
        <span class="ct-announce__spacer" aria-hidden="true"></span>
      {%- endif -%}
    </div>

    <script>
      (function () {
        var bar = document.getElementById('ct-announce-{{ section.id }}');
        if (!bar) return;
        // Clear any interval left by a prior render of this section (Theme Editor re-injects the same id) so timers don't accumulate.
        var key = 'ctAnnounceTimer{{ section.id }}';
        if (window[key]) { clearInterval(window[key]); window[key] = null; }
        try { if (sessionStorage.getItem('ct-announce-dismissed') === '1') { bar.style.display = 'none'; return; } } catch (e) {}
        var msgs = bar.querySelectorAll('.ct-announce__msg'), i = 0;
        var rotateMs = {{ section.settings.rotate_seconds | default: 4 | times: 1000 }};
        var reduced = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
        function show(next) {
          msgs[i].classList.remove('is-active');
          i = (next + msgs.length) % msgs.length;
          msgs[i].classList.add('is-active');
        }
        function startAuto() {
          if (msgs.length <= 1 || reduced) return;
          if (window[key]) clearInterval(window[key]);
          window[key] = setInterval(function () { show(i + 1); }, rotateMs);
        }
        startAuto();
        // Manual swipe (touch + mouse via pointer events)
        if (msgs.length > 1) {
          var startX = null, moved = false;
          bar.addEventListener('pointerdown', function (e) { startX = e.clientX; moved = false; });
          bar.addEventListener('pointermove', function (e) {
            if (startX === null) return;
            if (Math.abs(e.clientX - startX) > 8) moved = true;
          });
          bar.addEventListener('pointerup', function (e) {
            if (startX === null) return;
            var dx = e.clientX - startX;
            startX = null;
            if (Math.abs(dx) > 40) { show(i + (dx < 0 ? 1 : -1)); startAuto(); }
          });
          bar.addEventListener('pointercancel', function () { startX = null; moved = false; });
          // Suppress link click if user actually swiped
          bar.addEventListener('click', function (e) {
            if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; }
          }, true);
        }
        var x = bar.querySelector('.ct-announce__dismiss');
        if (x) x.addEventListener('click', function (e) {
          e.stopPropagation();
          try { sessionStorage.setItem('ct-announce-dismissed', '1'); } catch (err) {}
          bar.style.display = 'none';
          if (window[key]) { clearInterval(window[key]); window[key] = null; }
        });
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "CT Announce bar",
  "tag": "section",
  "class": "ct-announce-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "select", "id": "display", "label": "Display mode", "options": [{ "value": "rotate", "label": "Rotate messages (default)" }, { "value": "static-row", "label": "Show all in one row (homepage)" }], "default": "rotate" },
    { "type": "checkbox", "id": "dismissible", "label": "Show dismiss button", "default": true },
    { "type": "range", "id": "rotate_seconds", "label": "Rotation interval", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 4, "info": "Only rotates when 2+ messages are added." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "🚚 Free shipping on orders over $50" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "CT Announce bar",
      "blocks": [
        { "type": "message", "settings": { "text": "🚚 Free shipping on orders over $50" } },
        { "type": "message", "settings": { "text": "★★★★★ 92% 5-star · Loved by 15,000+ cat parents" } }
      ]
    }
  ]
}
{% endschema %}
