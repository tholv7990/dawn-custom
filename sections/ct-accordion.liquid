{% render 'ct-section-padding', section: section %}

<section class="gs-scope ct-accordion section-{{ section.id }}-padding">
  <div class="gs-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="gs-section-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="gs-section-sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <div class="ct-accordion__list">
      {%- for block in section.blocks -%}
        <details
          class="ct-accordion__item"
          {% if forloop.first %}open{% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="ct-accordion__summary">
            <span class="ct-accordion__title">{{ block.settings.title | escape }}</span>
            <span class="ct-accordion__icon" aria-hidden="true"></span>
          </summary>
          <div class="ct-accordion__panel">
            <div class="ct-accordion__content rte">{{ block.settings.content }}</div>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  .ct-accordion {
    background: var(--ct-bg);
    color: var(--ct-text);
  }

  .ct-accordion .gs-section-sub {
    color: var(--ct-text-2);
    font-size: var(--ct-text-md);
    line-height: var(--ct-leading-base);
  }

  .ct-accordion__list {
    display: flex;
    flex-direction: column;
    gap: var(--ct-space-3);
    margin-top: var(--ct-space-6);
  }

  .ct-accordion__item {
    border: 1px solid var(--ct-border);
    border-radius: var(--ct-r-lg);
    background: var(--ct-bg-surface);
    overflow: hidden;
  }

  .ct-accordion__item[open] {
    border-color: var(--ct-border-strong);
    box-shadow: var(--ct-shadow-sm);
  }

  .ct-accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ct-space-4);
    padding: var(--ct-space-5) var(--ct-space-5);
    cursor: pointer;
    list-style: none;
    font-size: var(--ct-text-lg);
    font-weight: var(--ct-fw-semi);
    line-height: var(--ct-leading-tight);
    color: var(--ct-text);
  }

  .ct-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .ct-accordion__summary:focus-visible {
    outline: 2px solid var(--ct-action);
    outline-offset: -2px;
  }

  .ct-accordion__title {
    flex: 1 1 auto;
  }

  .ct-accordion__icon {
    position: relative;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    color: var(--ct-text-3);
    transition: transform var(--ct-dur-base) var(--ct-ease-out);
  }

  .ct-accordion__icon::before,
  .ct-accordion__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 2px;
    border-radius: var(--ct-r-pill);
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform var(--ct-dur-base) var(--ct-ease-out), opacity var(--ct-dur-base) var(--ct-ease-out);
  }

  .ct-accordion__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .ct-accordion__item[open] .ct-accordion__icon {
    color: var(--ct-action);
    transform: rotate(180deg);
  }

  .ct-accordion__item[open] .ct-accordion__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
    opacity: 0;
  }

  .ct-accordion__panel {
    padding: 0 var(--ct-space-5) var(--ct-space-5);
  }

  .ct-accordion__content {
    color: var(--ct-text-2);
    font-size: var(--ct-body-size);
    line-height: var(--ct-leading-loose);
  }

  .ct-accordion__content > :first-child {
    margin-top: 0;
  }

  .ct-accordion__content > :last-child {
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .ct-accordion__icon,
    .ct-accordion__icon::before,
    .ct-accordion__icon::after {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Accordion",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Details"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Expand each section to learn more."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Section title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add the supporting details for this section here. Describe what shoppers can expect in clear, plain language.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Accordion",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
