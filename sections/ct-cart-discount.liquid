{% render 'ct-section-padding', section: section %}

<section class="ct-cart-discount gs-scope section-{{ section.id }}-padding" id="ct-cart-discount-{{ section.id }}">
  <div class="gs-wrap">
    <div class="ct-cart-discount__card">
      {%- if section.settings.heading != blank -%}
        <h2 class="ct-cart-discount__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <form
        class="ct-cart-discount__form"
        method="get"
        action="{{ routes.root }}discount/"
        data-ct-cart-discount-form
      >
        <div class="ct-cart-discount__field">
          <label class="ct-cart-discount__label" for="ct-cart-discount-input-{{ section.id }}">
            {{ section.settings.placeholder | escape }}
          </label>
          <input
            class="ct-cart-discount__input"
            type="text"
            id="ct-cart-discount-input-{{ section.id }}"
            name="ct-discount-code"
            placeholder="{{ section.settings.placeholder | escape }}"
            aria-label="{{ section.settings.placeholder | escape }}"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            data-ct-cart-discount-input
          >
          <button class="ct-cart-discount__button" type="submit">
            {{ section.settings.button_label | escape }}
          </button>
        </div>
        <p class="ct-cart-discount__status" role="status" aria-live="polite" data-ct-cart-discount-status></p>
      </form>

      {%- if section.settings.note != blank -%}
        <p class="ct-cart-discount__note">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .ct-cart-discount .ct-cart-discount__card {
    padding: var(--ct-pad-tight);
    background: var(--ct-card-bg);
    border: 1px solid var(--ct-card-border);
    border-radius: var(--ct-r-lg);
    box-shadow: var(--ct-shadow-sm);
  }

  .ct-cart-discount .ct-cart-discount__heading {
    margin: 0 0 var(--ct-space-3);
    color: var(--ct-text);
    font-size: var(--ct-h5);
    font-weight: var(--ct-fw-semi);
    line-height: 1.3;
  }

  .ct-cart-discount .ct-cart-discount__form {
    margin: 0;
  }

  .ct-cart-discount .ct-cart-discount__field {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ct-space-2);
    align-items: stretch;
  }

  .ct-cart-discount .ct-cart-discount__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .ct-cart-discount .ct-cart-discount__input {
    flex: 1 1 220px;
    min-width: 0;
    padding: var(--ct-space-3) var(--ct-space-4);
    color: var(--ct-text);
    font-size: var(--ct-body-size);
    font-weight: var(--ct-fw-normal);
    background: var(--ct-bg-control);
    border: 1px solid var(--ct-border);
    border-radius: var(--ct-r-md);
    transition: border-color var(--ct-dur-base) var(--ct-ease-out);
  }

  .ct-cart-discount .ct-cart-discount__input::placeholder {
    color: var(--ct-text-3);
  }

  .ct-cart-discount .ct-cart-discount__input:focus {
    outline: none;
    border-color: var(--ct-action-border);
    box-shadow: var(--ct-ring);
  }

  .ct-cart-discount .ct-cart-discount__button {
    flex: 0 0 auto;
    padding: var(--ct-space-3) var(--ct-space-5);
    color: var(--ct-on-accent);
    font-size: var(--ct-text-sm);
    font-weight: var(--ct-fw-semi);
    background: var(--ct-action);
    border: 1px solid var(--ct-action-border);
    border-radius: var(--ct-r-md);
    cursor: pointer;
    transition: background-color var(--ct-dur-base) var(--ct-ease-out);
  }

  .ct-cart-discount .ct-cart-discount__button:hover {
    background: var(--ct-action-hover);
  }

  .ct-cart-discount .ct-cart-discount__button:focus-visible {
    outline: none;
    box-shadow: var(--ct-ring);
  }

  .ct-cart-discount .ct-cart-discount__status {
    margin: var(--ct-space-2) 0 0;
    color: var(--ct-text-2);
    font-size: var(--ct-text-sm);
    line-height: 1.4;
  }

  .ct-cart-discount .ct-cart-discount__status:empty {
    margin: 0;
  }

  .ct-cart-discount .ct-cart-discount__note {
    margin: var(--ct-space-3) 0 0;
    color: var(--ct-text-3);
    font-size: var(--ct-text-xs);
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .ct-cart-discount .ct-cart-discount__input,
    .ct-cart-discount .ct-cart-discount__button {
      transition: none;
    }
  }
{% endstyle %}

<script>
  (function () {
    var root = document.getElementById('ct-cart-discount-{{ section.id }}');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    var form = root.querySelector('[data-ct-cart-discount-form]');
    var input = root.querySelector('[data-ct-cart-discount-input]');
    var status = root.querySelector('[data-ct-cart-discount-status]');
    if (!form || !input) return;

    function rootPath() {
      var routes = window.Shopify && window.Shopify.routes;
      return (routes && routes.root) || '/';
    }

    function setStatus(message) {
      if (status) status.textContent = message || '';
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();

      var code = (input.value || '').trim();
      if (!code) {
        setStatus('Please enter a discount code.');
        input.focus();
        return;
      }

      setStatus('Applying your code…');

      try {
        var target = rootPath() + 'discount/' + encodeURIComponent(code) + '?redirect=/cart';
        window.location.assign(target);
      } catch (e) {
        // Progressive enhancement: fall back to a native form navigation.
        try {
          form.action = rootPath() + 'discount/' + encodeURIComponent(code);
          form.submit();
        } catch (err) {
          /* no-op: keep page usable if navigation APIs are unavailable */
        }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Cart discount code",
  "settings": [
    {
      "type": "paragraph",
      "content": "Applies discount codes through Shopify's native discount link, then returns the shopper to the cart."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Have a code?"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Discount code"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Apply"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Helper note",
      "default": "Codes apply at checkout."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Cart discount code"
    }
  ]
}
{% endschema %}
