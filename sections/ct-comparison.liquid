{% render 'ct-section-padding', section: section %}

<section class="gs-scope gs-section gs-soft section-{{ section.id }}-padding">
  <div class="gs-wrap">
    <h2 class="gs-section-heading">
      {{ section.settings.heading }}
      {% render 'ct-brandmark' %}
    </h2>
    <div class="gs-compare">
      <table>
        <thead>
          <tr>
            <th></th>
            <th class="gs-us">
              {% render 'ct-brandmark', inverse: true %}
            </th>
            <th>{{ section.settings.alt_1_label }}</th>
            <th>{{ section.settings.alt_2_label }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.feature }}</td>
              <td class="gs-us gs-yes">{{ block.settings.us }}</td>
              <td class="{% if block.settings.alt_1_good %}gs-yes{% else %}gs-no{% endif %}">
                {{ block.settings.alt_1 }}
              </td>
              <td class="{% if block.settings.alt_2_good %}gs-yes{% else %}gs-no{% endif %}">
                {{ block.settings.alt_2 }}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Comparison",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading prefix", "default": "Why choose" },
    { "type": "text", "id": "alt_1_label", "label": "Alternative 1 label", "default": "Alternative 1" },
    { "type": "text", "id": "alt_2_label", "label": "Alternative 2 label", "default": "Alternative 2" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 60 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Feature" },
        { "type": "text", "id": "us", "label": "Us", "default": "Your product" },
        { "type": "text", "id": "alt_1", "label": "Alternative 1", "default": "Alternative" },
        { "type": "checkbox", "id": "alt_1_good", "label": "Alternative 1 positive", "default": false },
        { "type": "text", "id": "alt_2", "label": "Alternative 2", "default": "Alternative" },
        { "type": "checkbox", "id": "alt_2_good", "label": "Alternative 2 positive", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison",
      "blocks": []
    }
  ]
}
{% endschema %}
