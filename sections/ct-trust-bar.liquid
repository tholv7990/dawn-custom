{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-trust-bar.css' | asset_url | stylesheet_tag }}

{% render 'ct-section-padding', section: section %}

<div class="page-width section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="ct-trust-grid" data-reveal>
    {%- for block in section.blocks -%}
      <div class="ct-trust-chip" {{ block.shopify_attributes }}>
        <div class="ct-trust-icon ct-trust-icon--{{ block.settings.icon_color }}">
          {%- case block.settings.icon -%}
            {%- when 'check' -%}<svg viewBox="0 0 24 24"><path d="M5 12l5 5L20 7"/></svg>
            {%- when 'truck' -%}<svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            {%- when 'shield' -%}<svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            {%- else -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {%- endcase -%}
        </div>
        <div>
          <div class="ct-trust-label">{{ block.settings.label }}</div>
          {%- if block.settings.sublabel != blank -%}<div class="ct-trust-sub">{{ block.settings.sublabel }}</div>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "CT Trust bar",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 20 }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Trust chip",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "check", "label": "Check" }, { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "clock", "label": "Clock" } ], "default": "check" },
        { "type": "select", "id": "icon_color", "label": "Icon color", "options": [ { "value": "green", "label": "Green" }, { "value": "blue", "label": "Blue" }, { "value": "purple", "label": "Purple" }, { "value": "amber", "label": "Amber" } ], "default": "green" },
        { "type": "text", "id": "label", "label": "Label", "default": "30-Day Returns" },
        { "type": "text", "id": "sublabel", "label": "Sub-label", "default": "No questions" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "CT Trust bar",
      "blocks": [
        { "type": "chip", "settings": { "icon": "check", "icon_color": "green", "label": "30-Day Returns", "sublabel": "No questions" } },
        { "type": "chip", "settings": { "icon": "truck", "icon_color": "blue", "label": "Free Shipping", "sublabel": "Orders $100+" } },
        { "type": "chip", "settings": { "icon": "shield", "icon_color": "purple", "label": "Lifetime Warranty", "sublabel": "Full coverage" } },
        { "type": "chip", "settings": { "icon": "clock", "icon_color": "amber", "label": "Ships in 24h", "sublabel": "Express available" } }
      ]
    }
  ]
}
{% endschema %}
