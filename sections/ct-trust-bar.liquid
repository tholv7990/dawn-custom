{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-trust-bar.css' | asset_url | stylesheet_tag }}

{%- if section.settings.layout == 'icon-strip' -%}
  <div class="ct-trust-strip ct-trust-strip--icons color-{{ section.settings.color_scheme }}" data-reveal>
    <div class="page-width">
      {%- for block in section.blocks -%}
        {%- liquid
          assign label_text = block.settings.title | append: ' ' | append: block.settings.subtitle | append: ' ' | append: block.settings.label | downcase
          assign icon_key = 'check'
          assign icon_tone = 'sage'
          if label_text contains 'calming' or label_text contains 'comfort' or label_text contains 'soft walls'
            assign icon_key = 'heart'
            assign icon_tone = 'sage'
          elsif label_text contains 'joint' or label_text contains 'support'
            assign icon_key = 'clock'
            assign icon_tone = 'clay'
          elsif label_text contains 'wash'
            assign icon_key = 'database'
            assign icon_tone = 'teal'
          elsif label_text contains 'non-slip' or label_text contains 'base' or label_text contains 'stay'
            assign icon_key = 'home'
            assign icon_tone = 'coffee'
          endif
        -%}
        <div class="ct-trust-strip__item" {{ block.shopify_attributes }}>
          <span class="ct-trust-strip__ic ct-trust-strip__ic--{{ icon_tone }}">
            {%- case icon_key -%}
              {%- when 'heart' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/></svg>
              {%- when 'clock' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0z"/><path d="M12 7v5l3 2"/></svg>
              {%- when 'database' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8a9 4 0 0 0 18 0M3 8a9 4 0 0 1 18 0v8a9 4 0 0 1-18 0z"/></svg>
              {%- when 'home' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18V9l8-5 8 5v9"/><path d="M4 18h16"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            {%- endcase -%}
          </span>
          <div>
            {%- if block.settings.title != blank -%}<b class="ct-trust-strip__title">{{ block.settings.title }}</b>{%- endif -%}
            {%- if block.settings.subtitle != blank -%}<small class="ct-trust-strip__sub">{{ block.settings.subtitle }}</small>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- else -%}
  <div class="ct-trust-strip color-{{ section.settings.color_scheme }}" data-reveal>
    <div class="page-width ct-trust-strip__inner">
      {%- for block in section.blocks -%}
        {%- liquid
          assign label_text = block.settings.label | downcase
          assign fa_icon = 'circle-check'
          assign icon_tone = 'green'
          case block.settings.icon
            when 'paw'
              assign fa_icon = 'paw'
              assign icon_tone = 'coffee'
            when 'bed'
              assign fa_icon = 'bed'
              assign icon_tone = 'coffee'
            when 'couch'
              assign fa_icon = 'couch'
              assign icon_tone = 'green'
            when 'soap'
              assign fa_icon = 'soap'
              assign icon_tone = 'green'
            when 'truck'
              assign fa_icon = 'truck-fast'
              assign icon_tone = 'coffee'
            when 'shield-money'
              assign fa_icon = 'shield-heart'
              assign icon_tone = 'green'
            when 'shield'
              assign fa_icon = 'shield-heart'
              assign icon_tone = 'green'
            when 'lock'
              assign fa_icon = 'lock'
              assign icon_tone = 'green-dark'
            when 'chat'
              assign fa_icon = 'headset'
              assign icon_tone = 'coffee'
          endcase
          if label_text contains 'support'
            assign fa_icon = 'headset'
            assign icon_tone = 'coffee'
          elsif label_text contains 'shipping' or label_text contains 'delivery'
            assign fa_icon = 'truck-fast'
            assign icon_tone = 'coffee'
          elsif label_text contains 'secure' or label_text contains 'payment' or label_text contains 'checkout'
            assign fa_icon = 'lock'
            assign icon_tone = 'green-dark'
          elsif label_text contains 'money' or label_text contains 'guarantee'
            assign fa_icon = 'shield-heart'
            assign icon_tone = 'green'
          endif
        -%}
        <span class="ct-trust-item ct-trust-item--{{ icon_tone }}" {{ block.shopify_attributes }}>
          {%- render 'ct-fa-icon', icon: fa_icon -%}
          {{ block.settings.label }}
        </span>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "CT Trust strip",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout",
      "options": [
        { "value": "chips",      "label": "Chip row (default — used by PDP)" },
        { "value": "icon-strip", "label": "Icon strip (homepage — accent-subtle band)" }
      ],
      "default": "chips" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Trust item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "paw",          "label": "Paw (fleece)" },
          { "value": "bed",          "label": "Bed (pillow edges)" },
          { "value": "couch",        "label": "Couch (hair-free)" },
          { "value": "soap",         "label": "Soap (washable)" },
          { "value": "truck",        "label": "Truck (shipping)" },
          { "value": "shield-money", "label": "Shield (money-back)" },
          { "value": "lock",         "label": "Lock (security)" },
          { "value": "chat",         "label": "Chat (support)" },
          { "value": "check",        "label": "Check" },
          { "value": "paw-fleece",   "label": "Paw / heart (fleece)" },
          { "value": "bed-edge",     "label": "Bed with edge" },
          { "value": "couch-hair",   "label": "Couch / lines (hair-free)" },
          { "value": "wash-clock",   "label": "Wash / clock" }
        ], "default": "truck" },
        { "type": "text", "id": "label",    "label": "Label",                 "default": "Fast Shipping" },
        { "type": "text", "id": "title",    "label": "Title (icon-strip only)"    },
        { "type": "text", "id": "subtitle", "label": "Subtitle (icon-strip only)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "CT Trust strip",
      "blocks": [
        { "type": "chip", "settings": { "icon": "truck",        "label": "Fast Shipping" } },
        { "type": "chip", "settings": { "icon": "shield-money", "label": "30-Day Money-Back Guarantee" } },
        { "type": "chip", "settings": { "icon": "lock",         "label": "Secured Payments" } },
        { "type": "chip", "settings": { "icon": "chat",         "label": "Support That Cares" } }
      ]
    }
  ]
}
{% endschema %}
