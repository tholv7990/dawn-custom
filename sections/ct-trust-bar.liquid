{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{{ 'section-ct-trust-bar.css' | asset_url | stylesheet_tag }}

<div class="ct-trust-strip color-{{ section.settings.color_scheme }}" data-reveal>
  <div class="page-width ct-trust-strip__inner">
    {%- for block in section.blocks -%}
      <span class="ct-trust-item" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'truck' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          {%- when 'shield-money' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          {%- when 'lock' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          {%- when 'chat' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          {%- when 'check' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          {%- else -%}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        {%- endcase -%}
        {{ block.settings.label }}
      </span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "CT Trust strip",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Trust item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck", "label": "Truck (shipping)" },
          { "value": "shield-money", "label": "Shield (money-back)" },
          { "value": "lock", "label": "Lock (security)" },
          { "value": "chat", "label": "Chat (support)" },
          { "value": "check", "label": "Check" }
        ], "default": "truck" },
        { "type": "text", "id": "label", "label": "Label", "default": "Fast Shipping" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "CT Trust strip",
      "blocks": [
        { "type": "chip", "settings": { "icon": "truck", "label": "Fast Shipping" } },
        { "type": "chip", "settings": { "icon": "shield-money", "label": "7-Day Money-Back Guarantee" } },
        { "type": "chip", "settings": { "icon": "lock", "label": "Secured Payments" } },
        { "type": "chip", "settings": { "icon": "chat", "label": "Support That Cares" } }
      ]
    }
  ]
}
{% endschema %}
