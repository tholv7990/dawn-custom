{% render 'ct-section-padding', section: section %}

<section class="gs-scope ct-trust-bar section-{{ section.id }}-padding">
  <div class="gs-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="gs-section-heading ct-trust-bar__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="gs-section-sub ct-trust-bar__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <ul class="ct-trust-bar__list ct-trust-bar__list--{{ section.settings.layout }}" role="list">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'benefit' -%}
            <li class="ct-trust-bar__item ct-trust-bar__item--benefit" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                {% render 'ct-icon', name: block.settings.icon, class: 'ct-trust-bar__icon', label: block.settings.title %}
              {%- endif -%}
              <span class="ct-trust-bar__body">
                {%- if block.settings.title != blank -%}
                  <span class="ct-trust-bar__title">{{ block.settings.title | escape }}</span>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="ct-trust-bar__text">{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </span>
            </li>

          {%- when 'payment' -%}
            <li class="ct-trust-bar__item ct-trust-bar__item--payment" {{ block.shopify_attributes }}>
              <span class="ct-trust-bar__body">
                {%- if block.settings.note != blank -%}
                  <span class="ct-trust-bar__text">{{ block.settings.note | escape }}</span>
                {%- endif -%}
                {%- if shop.enabled_payment_types.size > 0 -%}
                  <span class="ct-trust-bar__pays" role="list" aria-label="{{ 'sections.footer.payment' | t }}">
                    {%- for type in shop.enabled_payment_types -%}
                      {{ type | payment_type_svg_tag: class: 'ct-trust-bar__pay' }}
                    {%- endfor -%}
                  </span>
                {%- endif -%}
              </span>
            </li>

          {%- when 'text' -%}
            <li class="ct-trust-bar__item ct-trust-bar__item--note" {{ block.shopify_attributes }}>
              <div class="ct-trust-bar__richtext">{{ block.settings.content }}</div>
            </li>

          {%- when 'divider' -%}
            <li class="ct-trust-bar__item ct-trust-bar__item--divider" aria-hidden="true" {{ block.shopify_attributes }}></li>
        {%- endcase -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{%- style -%}
  .ct-trust-bar__heading {
    margin-bottom: var(--ct-space-2);
  }

  .ct-trust-bar__subheading {
    margin-top: 0;
    margin-bottom: var(--ct-space-6);
    color: var(--ct-text-2);
    font-size: var(--ct-body-size);
  }

  .ct-trust-bar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--ct-space-4);
  }

  .ct-trust-bar__list--row {
    flex-direction: row;
    justify-content: flex-start;
  }

  .ct-trust-bar__list--grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    align-items: stretch;
    gap: var(--ct-space-3);
  }

  .ct-trust-bar__item {
    display: flex;
    align-items: center;
    gap: var(--ct-space-3);
    margin: 0;
    padding: 0;
  }

  .ct-trust-bar__item--benefit,
  .ct-trust-bar__item--payment,
  .ct-trust-bar__item--note {
    flex: 1 1 220px;
    min-width: 0;
    padding: var(--ct-space-4) var(--ct-space-5);
    background-color: var(--ct-card-bg);
    border: 1px solid var(--ct-card-border);
    border-radius: var(--ct-r-lg);
    box-shadow: var(--ct-shadow-sm);
  }

  .ct-trust-bar__list--row .ct-trust-bar__item--divider {
    flex: 0 0 auto;
    align-self: stretch;
    width: 1px;
    min-height: var(--ct-space-8);
    padding: 0;
    background-color: var(--ct-border);
  }

  .ct-trust-bar__list--grid .ct-trust-bar__item--divider {
    grid-column: 1 / -1;
    height: 1px;
    width: 100%;
    background-color: var(--ct-border);
  }

  .ct-trust-bar__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    color: var(--ct-action);
    background-color: var(--ct-action-tint);
    border-radius: var(--ct-r-pill);
  }

  .ct-trust-bar__icon svg {
    width: 20px;
    height: 20px;
  }

  .ct-trust-bar__body {
    display: flex;
    flex-direction: column;
    gap: var(--ct-space-1);
    min-width: 0;
  }

  .ct-trust-bar__title {
    color: var(--ct-text);
    font-size: var(--ct-text-sm);
    font-weight: var(--ct-fw-semi);
    line-height: var(--ct-leading-tight);
  }

  .ct-trust-bar__text {
    color: var(--ct-text-2);
    font-size: var(--ct-text-xs);
    line-height: var(--ct-leading-base);
  }

  .ct-trust-bar__richtext {
    color: var(--ct-text-2);
    font-size: var(--ct-text-sm);
    line-height: var(--ct-leading-base);
  }

  .ct-trust-bar__richtext :first-child {
    margin-top: 0;
  }

  .ct-trust-bar__richtext :last-child {
    margin-bottom: 0;
  }

  .ct-trust-bar__pays {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ct-space-2);
    margin-top: var(--ct-space-1);
  }

  .ct-trust-bar__pay {
    width: 38px;
    height: 24px;
    border: 1px solid var(--ct-border);
    border-radius: var(--ct-r-sm);
  }

  @media screen and (max-width: 749px) {
    .ct-trust-bar__list--row {
      flex-direction: column;
    }

    .ct-trust-bar__list--row .ct-trust-bar__item--divider {
      width: 100%;
      min-height: 0;
      height: 1px;
      align-self: auto;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Leave blank to hide.",
      "default": "Shop with confidence"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "Optional. Leave blank to hide."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "row",
          "label": "Row"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "row"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name",
          "info": "Try: check, truck, lock, star, return, box, leaf, recycle, info.",
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "On orders over your threshold"
        }
      ]
    },
    {
      "type": "payment",
      "name": "Payment icons",
      "settings": [
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "info": "Renders your store's enabled payment icons.",
          "default": "Secure checkout"
        }
      ]
    },
    {
      "type": "text",
      "name": "Reassurance text",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add a short reassurance line for your shoppers.</p>"
        }
      ]
    },
    {
      "type": "divider",
      "name": "Divider",
      "settings": []
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "truck",
            "title": "Free shipping",
            "text": "On orders over your threshold"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "return",
            "title": "Easy returns",
            "text": "Add your return window here"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "lock",
            "title": "Secure checkout",
            "text": "Your details stay protected"
          }
        },
        {
          "type": "payment",
          "settings": {
            "note": "Secure checkout"
          }
        }
      ]
    }
  ]
}
{% endschema %}
