<div class="gs-scope">
  <div class="gs-announce gs-announce--top">
    <div class="gs-announce__track">
      {%- for repeat in (1..6) -%}
        <div class="gs-announce__set"{% if repeat > 1 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- if block.type == 'top_message' -%}
              <span{% if repeat == 1 %} {{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.icon != blank -%}<b aria-hidden="true">{{ block.settings.icon }}</b>{%- endif -%}
                {{ block.settings.text }}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
  <div class="gs-announce gs-announce--green">
    <div class="gs-announce__track">
      {%- for repeat in (1..6) -%}
        <div class="gs-announce__set"{% if repeat > 1 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- if block.type == 'bottom_message' -%}
              <span{% if repeat == 1 %} {{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.icon != blank -%}<b aria-hidden="true">{{ block.settings.icon }}</b>{%- endif -%}
                {{ block.settings.text }}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement bars",
  "settings": [
    { "type": "paragraph", "content": "Renders a continuous scrolling ticker. Keep message text short so each item remains readable on mobile." }
  ],
  "blocks": [
    {
      "type": "top_message",
      "name": "Top message",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "Info" },
        { "type": "text", "id": "text", "label": "Text", "default": "Add announcement text" }
      ]
    },
    {
      "type": "bottom_message",
      "name": "Bottom message",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "Info" },
        { "type": "text", "id": "text", "label": "Text", "default": "Add secondary announcement text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bars",
      "blocks": [
        { "type": "top_message", "settings": { "icon": "Info", "text": "Add announcement text" } },
        { "type": "bottom_message", "settings": { "icon": "Info", "text": "Add secondary announcement text" } }
      ]
    }
  ]
}{% endschema %}

