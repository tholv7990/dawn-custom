{%- liquid
  assign main_product = section.settings.main_product
-%}

<section class="cth-size" id="guide">
  <div class="page-width">
    <div class="cth-head"><span class="cth-eyebrow">Find their size</span><h2>Two sizes. Pick by how they sleep.</h2></div>
    <div class="cth-size-panels">
      <article class="cth-size-panel">
        <div class="cth-imgslot cth-size-panel__media ct-media ct-media--natural">
          {%- if section.settings.size_medium_image != blank -%}
            {{ section.settings.size_medium_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'cth-imgslot__img', alt: section.settings.size_medium_image.alt | default: 'Medium CozyClaw sofa' | escape }}
          {%- elsif main_product.featured_image != blank -%}
            {{ main_product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'cth-imgslot__img', alt: main_product.title | escape }}
          {%- else -%}
            <span class="cth-ph">{% render 'ct-fa-icon', icon: 'paw' %}</span>
          {%- endif -%}
        </div>
        <div class="cth-size-panel__body">
          <span>Medium</span>
          <h3>For cats &amp; small dogs</h3>
          <p>Best for cats and small dogs who like to nest, curl, and lean into soft raised walls.</p>
          <ul>
            <li>{% render 'ct-checkmark' %}Sofa approx. 60 x 80 cm (24 x 31 in)</li>
            <li>{% render 'ct-checkmark' %}Roomy curl-up shape</li>
            <li>{% render 'ct-checkmark' %}Whole bed machine washable</li>
          </ul>
        </div>
      </article>
      <article class="cth-size-panel">
        <div class="cth-imgslot cth-size-panel__media ct-media ct-media--natural">
          {%- if section.settings.size_large_image != blank -%}
            {{ section.settings.size_large_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'cth-imgslot__img', alt: section.settings.size_large_image.alt | default: 'Large CozyClaw sofa' | escape }}
          {%- elsif main_product.featured_image != blank -%}
            {{ main_product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'cth-imgslot__img', alt: main_product.title | escape }}
          {%- else -%}
            <span class="cth-ph">{% render 'ct-fa-icon', icon: 'paw' %}</span>
          {%- endif -%}
        </div>
        <div class="cth-size-panel__body">
          <span>Large</span>
          <h3>For medium pets</h3>
          <p>Best for medium pets or any pet who likes to stretch, sprawl, and claim extra room.</p>
          <ul>
            <li>{% render 'ct-checkmark' %}Sofa approx. 80 x 90 cm (31 x 35 in)</li>
            <li>{% render 'ct-checkmark' %}More room for stretching out</li>
            <li>{% render 'ct-checkmark' %}Whole bed machine washable</li>
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CT home size",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "product", "id": "main_product", "label": "Fallback product" },
    { "type": "image_picker", "id": "size_medium_image", "label": "Medium size image" },
    { "type": "image_picker", "id": "size_large_image", "label": "Large size image" }
  ],
  "presets": [{ "name": "CT home size" }]
}
{% endschema %}
